{
  "name": "quranic-teacher",
  "version": "0.0.0",
  "private": true,
  "description": "Root of the IqraSpace monorepo: four independent apps under apps/ (learning, quran, mobile/android, site) — see CLAUDE.md. This file only holds thin --prefix delegator scripts; there is no shared tooling.",
  "scripts": {
    "dev": "npm run dev --prefix apps/learning",
    "build": "npm run build --prefix apps/learning",
    "lint": "npm run lint --prefix apps/learning",
    "quran:dev": "npm run dev --prefix apps/quran",
    "quran:build": "npm run build --prefix apps/quran",
    "quran:lint": "npm run lint --prefix apps/quran",
    "quran:typecheck": "npm run typecheck --prefix apps/quran",
    "learning:dev:api": "npm run dev:api --prefix apps/learning",
    "learning:test": "npm run test:worker --prefix apps/learning"
  }
}
