# One-time owner setup required — see apps/mobile/android/DEPLOYMENT.md §9.
# Copy this file to .env.local (gitignored) and fill in the real path.
#
# Absolute path to the Google Play service-account JSON key. Keep this
# file, and the JSON key it points to, out of git entirely — same rule
# as android/key.properties and the upload keystore (DEPLOYMENT.md §3).
PLAY_SERVICE_ACCOUNT_JSON_PATH=
