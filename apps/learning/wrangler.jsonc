{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iqraspace-learning",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only the dynamic-route URLs invoke the Worker; every other request is
    // served straight from static assets (free, no Worker invocation).
    "run_worker_first": [
      "/learning/share/*",
      "/learning/teach/*",
      "/learning/admin/duas/*",
      "!/learning/admin/duas/new",
      "!/learning/admin/duas/list",
      "!/learning/admin/duas/activity",
      "!/learning/admin/duas/categories",
      "!/learning/admin/duas/categories/new"
    ]
  },
  "routes": [{ "pattern": "iqraspace.org/learning*", "zone_name": "iqraspace.org" }]
}
