{
  "name": "learning",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:duas": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/lib/duas/*.test.ts",
    "seed:admins": "node --env-file=.env.local scripts/seed-admin-accounts.mjs",
    "seed:surah-lessons": "node --env-file=.env.local scripts/seed-surah-lessons.mjs",
    "build:cf": "node scripts/build-cf.mjs",
    "test:worker": "node --test worker/*.test.mjs worker/api/*.test.mjs",
    "dev:api": "node scripts/ensure-dist.mjs && wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply iqraspace-learning --local",
    "migrate:check": "node --env-file=.env.local scripts/migrate-from-supabase.mjs check",
    "migrate:export": "node --env-file=.env.local scripts/migrate-from-supabase.mjs export",
    "migrate:sql": "node --env-file=.env.local scripts/migrate-from-supabase.mjs sql"
  },
  "dependencies": {
    "next": "16.3.3",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.151.0"
  }
}
