# =============================================================================
# IqraSpace Quran — apps/quran/.env.local.example
#
# Copy this file to `.env.local` (same folder) and fill in real values.
# `.env.local` is gitignored — never commit it. This example file IS
# committed and must only ever contain placeholders, no real secrets.
#
# See ../QURAN-CONTENT.md for what these credentials are, how to obtain
# them, and why they must never reach the browser.
# =============================================================================

# =============================================================================
# Quran Foundation Content API (server-side only — never NEXT_PUBLIC_*)
# =============================================================================
# Obtained by registering a project at https://dev-console.quran.foundation/
# (QURAN-CONTENT.md §5 — this is a manual, account-creation step only the
# project owner can do). Consumed only by scripts/sync-content.mjs and
# src/lib/quran-api/* — never imported into a client component.

# Pre-live credentials — every new project starts here (QURAN-CONTENT.md §4a:
# a small sandbox dataset, not a production mirror).
QURAN_FOUNDATION_CLIENT_ID=
QURAN_FOUNDATION_CLIENT_SECRET=

# Production credentials — only exist after Quran Foundation approves
# go-live for your project (QURAN-CONTENT.md §5). Leave unset until then.
QURAN_FOUNDATION_PROD_CLIENT_ID=
QURAN_FOUNDATION_PROD_CLIENT_SECRET=

# Which credential pair above is actually used: "prelive" or "production".
QURAN_FOUNDATION_ENV=prelive

