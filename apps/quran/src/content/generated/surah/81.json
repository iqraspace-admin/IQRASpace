{
  "syncedAt": "2026-08-31T09:57:47.120Z",
  "chapter": {
    "id": 81,
    "revelation_place": "makkah",
    "revelation_order": 7,
    "bismillah_pre": true,
    "name_simple": "At-Takwir",
    "name_complex": "At-Takwīr",
    "name_arabic": "التكوير",
    "verses_count": 29,
    "pages": [
      586,
      586
    ],
    "translated_name": {
      "language_name": "english",
      "name": "The Overthrowing"
    }
  },
  "verses": [
    {
      "id": 5801,
      "verse_number": 1,
      "verse_key": "81:1",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " إِذَا ٱلشَّمْسُ كُوِّرَتْ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407504,
          "resource_id": 85,
          "text": "When the sun is shrouded in darkness,"
        },
        {
          "id": 1550238,
          "resource_id": 831,
          "text": "Jab Suraj lapeit diya jayega"
        },
        {
          "id": -1005801,
          "resource_id": "ur.maududi",
          "text": "جب سورج لپیٹ دیا جائے گا"
        },
        {
          "id": -2005801,
          "resource_id": 227,
          "text": "సూర్యుడు (అంధకారంలో) చుట్టి పోయబడి కాంతిహీనుడైనప్పుడు!"
        }
      ]
    },
    {
      "id": 5802,
      "verse_number": 2,
      "verse_key": "81:2",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407505,
          "resource_id": 85,
          "text": "when the stars are dimmed,"
        },
        {
          "id": 1550239,
          "resource_id": 831,
          "text": "Aur jab taarey bikhar jayenge"
        },
        {
          "id": -1005802,
          "resource_id": "ur.maududi",
          "text": "اور جب تارے بکھر جائیں گے"
        },
        {
          "id": -2005802,
          "resource_id": 227,
          "text": "మరియు నక్షత్రాలు (కాంతిని కోల్పోయి) రాలిపోవునప్పుడు!"
        }
      ]
    },
    {
      "id": 5803,
      "verse_number": 3,
      "verse_key": "81:3",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407506,
          "resource_id": 85,
          "text": "when the mountains are set in motion,"
        },
        {
          "id": 1550240,
          "resource_id": 831,
          "text": "Aur jab pahad chalaye jayenge"
        },
        {
          "id": -1005803,
          "resource_id": "ur.maududi",
          "text": "اور جب پہاڑ چلائے جائیں گے"
        },
        {
          "id": -2005803,
          "resource_id": 227,
          "text": "మరియు పర్వతాలు కదిలించబడినప్పుడు!"
        }
      ]
    },
    {
      "id": 5804,
      "verse_number": 4,
      "verse_key": "81:4",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407507,
          "resource_id": 85,
          "text": "when pregnant camels are abandoned,"
        },
        {
          "id": 1550241,
          "resource_id": 831,
          "text": "Aur jab dus mahine ki hamila ountniyan (she-camels) apne haal par chod di jayengi"
        },
        {
          "id": -1005804,
          "resource_id": "ur.maududi",
          "text": "اور جب دس مہینے کی حاملہ اونٹنیاں اپنے حال پر چھوڑ دی جائیں گی"
        },
        {
          "id": -2005804,
          "resource_id": 227,
          "text": "మరియు నిండు సూడి ఒంటెలు, నిరపేక్షంగా వదిలివేయబడినప్పుడు!"
        }
      ]
    },
    {
      "id": 5805,
      "verse_number": 5,
      "verse_key": "81:5",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407508,
          "resource_id": 85,
          "text": "when wild beasts are herded together,"
        },
        {
          "id": 1550242,
          "resource_id": 831,
          "text": "Aur jab jungli jaanwar sameth kar ikhattey kar diye jayenge"
        },
        {
          "id": -1005805,
          "resource_id": "ur.maududi",
          "text": "اور جب جنگلی جانور سمیٹ کر اکٹھے کر دیے جائیں گے"
        },
        {
          "id": -2005805,
          "resource_id": 227,
          "text": "మరియు క్రూరమృగాలన్నీ ఒకచేట సమకూర్చబడినప్పుడు!"
        }
      ]
    },
    {
      "id": 5806,
      "verse_number": 6,
      "verse_key": "81:6",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407509,
          "resource_id": 85,
          "text": "when the seas boil over,"
        },
        {
          "id": 1550243,
          "resource_id": 831,
          "text": "Aur jab samandar bhadka diye jayenge"
        },
        {
          "id": -1005806,
          "resource_id": "ur.maududi",
          "text": "اور جب سمندر بھڑکا دیے جائیں گے"
        },
        {
          "id": -2005806,
          "resource_id": 227,
          "text": "మరియు సముద్రాలు ఉప్పొంగిపోయి నప్పుడు!"
        }
      ]
    },
    {
      "id": 5807,
      "verse_number": 7,
      "verse_key": "81:7",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407510,
          "resource_id": 85,
          "text": "when souls are sorted into classes,"
        },
        {
          "id": 1550244,
          "resource_id": 831,
          "text": "Aur jab jaane (Jismon se) jodh di jayengi"
        },
        {
          "id": -1005807,
          "resource_id": "ur.maududi",
          "text": "اور جب جانیں (جسموں سے) جوڑ دی جائیں گی"
        },
        {
          "id": -2005807,
          "resource_id": 227,
          "text": "మరియు ఆత్మలు (శరీరాలతో) తిరిగి కలుపబడి నప్పుడు!"
        }
      ]
    },
    {
      "id": 5808,
      "verse_number": 8,
      "verse_key": "81:8",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407511,
          "resource_id": 85,
          "text": "when the baby girl buried alive is asked"
        },
        {
          "id": 1550245,
          "resource_id": 831,
          "text": "Aur jab zinda gaadi hui(buried) ladki se pucha jayega"
        },
        {
          "id": -1005808,
          "resource_id": "ur.maududi",
          "text": "اور جب زندہ گاڑی ہوئی لڑکی سے پوچھا جائے گا"
        },
        {
          "id": -2005808,
          "resource_id": 227,
          "text": "మరియు సజీవంగా పాతి పెట్టబడిన బాలిక ప్రశ్నించబడినప్పుడు:"
        }
      ]
    },
    {
      "id": 5809,
      "verse_number": 9,
      "verse_key": "81:9",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "بِأَىِّ ذَنۢبٍ قُتِلَتْ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407512,
          "resource_id": 85,
          "text": "for what sin she was killed,"
        },
        {
          "id": 1550246,
          "resource_id": 831,
          "text": "ke woh kis kasoor mei mari gayi"
        },
        {
          "id": -1005809,
          "resource_id": "ur.maududi",
          "text": "کہ وہ کس قصور میں ماری گئی؟"
        },
        {
          "id": -2005809,
          "resource_id": 227,
          "text": "ఏ అపరాధానికి తాను హత్య చేయబడిందని?"
        }
      ]
    },
    {
      "id": 5810,
      "verse_number": 10,
      "verse_key": "81:10",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407513,
          "resource_id": 85,
          "text": "when the records of deeds are spread open,"
        },
        {
          "id": 1550247,
          "resource_id": 831,
          "text": "Aur jab aamal-naame(scrolls of deeds) kholey jayenge"
        },
        {
          "id": -1005810,
          "resource_id": "ur.maududi",
          "text": "اور جب اعمال نامے کھولے جائیں گے"
        },
        {
          "id": -2005810,
          "resource_id": 227,
          "text": "మరియు కర్మపత్రాలు తెరువబడినప్పుడు!"
        }
      ]
    },
    {
      "id": 5811,
      "verse_number": 11,
      "verse_key": "81:11",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407514,
          "resource_id": 85,
          "text": "when the sky is stripped away,"
        },
        {
          "id": 1550248,
          "resource_id": 831,
          "text": "Aur jab aasman ka purda hata diya jayega"
        },
        {
          "id": -1005811,
          "resource_id": "ur.maududi",
          "text": "اور جب آسمان کا پردہ ہٹا دیا جائے گا"
        },
        {
          "id": -2005811,
          "resource_id": 227,
          "text": "మరియు ఆకాశం ఒలిచి వేయబడినప్పుడు!"
        }
      ]
    },
    {
      "id": 5812,
      "verse_number": 12,
      "verse_key": "81:12",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407515,
          "resource_id": 85,
          "text": "when Hell is made to blaze"
        },
        {
          "id": 1550249,
          "resource_id": 831,
          "text": "Aur jab Jahannam dehkayi jayegi"
        },
        {
          "id": -1005812,
          "resource_id": "ur.maududi",
          "text": "اور جب جہنم دہکائی جائے گی"
        },
        {
          "id": -2005812,
          "resource_id": 227,
          "text": "మరియు నరకాగ్ని మండించబడినప్పుడు!"
        }
      ]
    },
    {
      "id": 5813,
      "verse_number": 13,
      "verse_key": "81:13",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407516,
          "resource_id": 85,
          "text": "and Paradise brought near:"
        },
        {
          "id": 1550250,
          "resource_id": 831,
          "text": "Aur jab Jannat qareeb le aayi jayegi"
        },
        {
          "id": -1005813,
          "resource_id": "ur.maududi",
          "text": "اور جب جنت قریب لے آئی جائے گی"
        },
        {
          "id": -2005813,
          "resource_id": 227,
          "text": "మరియు స్వర్గం దగ్గరకు తీసుకురాబడినప్పుడు!"
        }
      ]
    },
    {
      "id": 5814,
      "verse_number": 14,
      "verse_key": "81:14",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407517,
          "resource_id": 85,
          "text": "then every soul will know what it has brought about."
        },
        {
          "id": 1550251,
          "resource_id": 831,
          "text": "Us waqt har shaks ko maloom ho jayega ke woh kya lekar aaya hai"
        },
        {
          "id": -1005814,
          "resource_id": "ur.maududi",
          "text": "اُس وقت ہر شخص کو معلوم ہو جائے گا کہ وہ کیا لے کر آیا ہے"
        },
        {
          "id": -2005814,
          "resource_id": 227,
          "text": "ప్రతి ఆత్మ తాను చేసి తెచ్చిన కర్మలను తెలుసుకుంటుంది."
        }
      ]
    },
    {
      "id": 5815,
      "verse_number": 15,
      "verse_key": "81:15",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407518,
          "resource_id": 85,
          "text": "I swear by the planets"
        },
        {
          "id": 1550252,
          "resource_id": 831,
          "text": "Pas nahin main kasam khata hoon"
        },
        {
          "id": -1005815,
          "resource_id": "ur.maududi",
          "text": "پس نہیں، میں قسم کھاتا ہوں"
        },
        {
          "id": -2005815,
          "resource_id": 227,
          "text": "అలా కాదు! నేను తొలగిపోయే నక్షత్రాల సాక్షిగా చెబుతున్నాను;"
        }
      ]
    },
    {
      "id": 5816,
      "verse_number": 16,
      "verse_key": "81:16",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلْجَوَارِ ٱلْكُنَّسِ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407519,
          "resource_id": 85,
          "text": "that recede, move, and hide,"
        },
        {
          "id": 1550253,
          "resource_id": 831,
          "text": "Palatne aur chup janey wale taaron ki"
        },
        {
          "id": -1005816,
          "resource_id": "ur.maududi",
          "text": "پلٹنے اور چھپ جانے والے تاروں کی"
        },
        {
          "id": -2005816,
          "resource_id": 227,
          "text": "(ఏవైతే) వేగంగా తిరుగుతూ కనుమరుగవుతున్నాయో!"
        }
      ]
    },
    {
      "id": 5817,
      "verse_number": 17,
      "verse_key": "81:17",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّيْلِ إِذَا عَسْعَسَ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407520,
          "resource_id": 85,
          "text": "by the night that descends,"
        },
        {
          "id": 1550254,
          "resource_id": 831,
          "text": "Aur Raat ki jabke woh ruksat hui"
        },
        {
          "id": -1005817,
          "resource_id": "ur.maududi",
          "text": "اور رات کی جبکہ وہ رخصت ہوئی"
        },
        {
          "id": -2005817,
          "resource_id": 227,
          "text": "మరియు గడచి పోయే రాత్రి సాక్షిగా!"
        }
      ]
    },
    {
      "id": 5818,
      "verse_number": 18,
      "verse_key": "81:18",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407521,
          "resource_id": 85,
          "text": "by the dawn that softly breathes:"
        },
        {
          "id": 1550255,
          "resource_id": 831,
          "text": "Aur subah ki jabke usne saans liya"
        },
        {
          "id": -1005818,
          "resource_id": "ur.maududi",
          "text": "اور صبح کی جبکہ اس نے سانس لیا"
        },
        {
          "id": -2005818,
          "resource_id": 227,
          "text": "మరియు ప్రకాశించే ఉదయం సాక్షిగా!"
        }
      ]
    },
    {
      "id": 5819,
      "verse_number": 19,
      "verse_key": "81:19",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407522,
          "resource_id": 85,
          "text": "this is the speech of a noble messenger,"
        },
        {
          "id": 1550256,
          "resource_id": 831,
          "text": "Yeh fil waqea ek buzurg paigam-bar ka qaul(word) hai"
        },
        {
          "id": -1005819,
          "resource_id": "ur.maududi",
          "text": "یہ فی الواقع ایک بزرگ پیغام بر کا قول ہے"
        },
        {
          "id": -2005819,
          "resource_id": 227,
          "text": "నిశ్చయంగా, ఇది (ఈ ఖుర్ఆన్) గౌరవనీయుడైన సందేశహరుడు తెచ్చిన వాక్కు!"
        }
      ]
    },
    {
      "id": 5820,
      "verse_number": 20,
      "verse_key": "81:20",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407523,
          "resource_id": 85,
          "text": "who possesses great strength and is held in honour by the Lord of the Throne––"
        },
        {
          "id": 1550257,
          "resource_id": 831,
          "text": "Jo badi tawanai (might) rakhta hai, Arsh waley ke yahan buland martaba hai"
        },
        {
          "id": -1005820,
          "resource_id": "ur.maududi",
          "text": "جو بڑی توانائی رکھتا ہے، عرش والے کے ہاں بلند مرتبہ ہے"
        },
        {
          "id": -2005820,
          "resource_id": 227,
          "text": "అతను (జిబ్రీల్) మహా బలశాలి, సింహాసన (అర్ష్) అధిపతి సన్నిధిలో ఉన్నత స్థానం గలవాడు!"
        }
      ]
    },
    {
      "id": 5821,
      "verse_number": 21,
      "verse_key": "81:21",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مُّطَاعٍ ثَمَّ أَمِينٍ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407524,
          "resource_id": 85,
          "text": "he is obeyed there and worthy of trust."
        },
        {
          "id": 1550258,
          "resource_id": 831,
          "text": "Wahan uska hukum mana jata hai, Woh ba-aitamad (trustworthy) hai"
        },
        {
          "id": -1005821,
          "resource_id": "ur.maududi",
          "text": "وہاں اُس کا حکم مانا جاتا ہے، وہ با اعتماد ہے"
        },
        {
          "id": -2005821,
          "resource_id": 227,
          "text": "అతని ఆజ్ఞలు పాటింపబడతాయి మరియు (అతను) విశ్వసనీయుడు!"
        }
      ]
    },
    {
      "id": 5822,
      "verse_number": 22,
      "verse_key": "81:22",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا صَاحِبُكُم بِمَجْنُونٍ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407525,
          "resource_id": 85,
          "text": "Your companion is not mad:"
        },
        {
          "id": 1550259,
          "resource_id": 831,
          "text": "Aur (aey ehle Makkah) tumhara rafeeq(companion) majnoon(mad) nahin hai"
        },
        {
          "id": -1005822,
          "resource_id": "ur.maududi",
          "text": "اور (اے اہل مکہ) تمہارا رفیق مجنون نہیں ہے"
        },
        {
          "id": -2005822,
          "resource_id": 227,
          "text": "మరియు (ఓ ప్రజలారా!) మీ సహచరుడు పిచ్చివాడు కాడు!"
        }
      ]
    },
    {
      "id": 5823,
      "verse_number": 23,
      "verse_key": "81:23",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407526,
          "resource_id": 85,
          "text": "he did see him on the clear horizon."
        },
        {
          "id": 1550260,
          "resource_id": 831,
          "text": "Usne us paigambar ko roshan ufaq (clear horizon) par dekha hai"
        },
        {
          "id": -1005823,
          "resource_id": "ur.maududi",
          "text": "اُس نے اُس پیغام بر کو روشن افق پر دیکھا ہے"
        },
        {
          "id": -2005823,
          "resource_id": 227,
          "text": "మరియు వాస్తవంగా, అతను ఆ సందేశహరుణ్ణి (జిబ్రీల్ ను) ప్రకాశవంతమైన దిఙ్మండలంలో చూశాడు."
        }
      ]
    },
    {
      "id": 5824,
      "verse_number": 24,
      "verse_key": "81:24",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407527,
          "resource_id": 85,
          "text": "He does not withhold what is revealed to him from beyond."
        },
        {
          "id": 1550261,
          "resource_id": 831,
          "text": "Aur woh gaib (ke is ilam ko logon tak pahunchane) ke maamle mei bakheel nahin hai"
        },
        {
          "id": -1005824,
          "resource_id": "ur.maududi",
          "text": "اور وہ غیب (کے اِس علم کو لوگوں تک پہنچانے) کے معاملے میں بخیل نہیں ہے"
        },
        {
          "id": -2005824,
          "resource_id": 227,
          "text": "మరియు అతను (ముహమ్మద్) అగోచర జ్ఞానాన్ని ప్రజల నుండి దాచేవాడు కాడు."
        }
      ]
    },
    {
      "id": 5825,
      "verse_number": 25,
      "verse_key": "81:25",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407528,
          "resource_id": 85,
          "text": "This is not the word of an outcast devil."
        },
        {
          "id": 1550262,
          "resource_id": 831,
          "text": "Aur yeh kisi shaitan-e-mardood ka qaul nahin hai"
        },
        {
          "id": -1005825,
          "resource_id": "ur.maududi",
          "text": "اور یہ کسی شیطان مردود کا قول نہیں ہے"
        },
        {
          "id": -2005825,
          "resource_id": 227,
          "text": "మరియు ఇది (ఈ ఖుర్ఆన్) శపించ (బహిష్కరించ) బడిన షైతాన్ వాక్కు కాదు."
        }
      ]
    },
    {
      "id": 5826,
      "verse_number": 26,
      "verse_key": "81:26",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَيْنَ تَذْهَبُونَ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407529,
          "resource_id": 85,
          "text": "So where are you [people] going?"
        },
        {
          "id": 1550263,
          "resource_id": 831,
          "text": "Phir tum log kidhar chaley ja rahey ho"
        },
        {
          "id": -1005826,
          "resource_id": "ur.maududi",
          "text": "پھر تم لوگ کدھر چلے جا رہے ہو؟"
        },
        {
          "id": -2005826,
          "resource_id": 227,
          "text": "మరి మీరు ఎటు పోతున్నారు?"
        }
      ]
    },
    {
      "id": 5827,
      "verse_number": 27,
      "verse_key": "81:27",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407530,
          "resource_id": 85,
          "text": "This is a message for all people;"
        },
        {
          "id": 1550264,
          "resource_id": 831,
          "text": "Yeh to saarey jahan walon ke liye ek naseehat hai"
        },
        {
          "id": -1005827,
          "resource_id": "ur.maududi",
          "text": "یہ تو سارے جہان والوں کے لیے ایک نصیحت ہے"
        },
        {
          "id": -2005827,
          "resource_id": 227,
          "text": "ఇది (ఈ ఖుర్ఆన్) సర్వలోకాలకు ఒక హితోపదేశం."
        }
      ]
    },
    {
      "id": 5828,
      "verse_number": 28,
      "verse_key": "81:28",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407531,
          "resource_id": 85,
          "text": "for those who wish to take the straight path."
        },
        {
          "id": 1550265,
          "resource_id": 831,
          "text": "Tum mein se har us shaks ke liye jo raah-e-raast par chalna chahta ho"
        },
        {
          "id": -1005828,
          "resource_id": "ur.maududi",
          "text": "تم میں سے ہر اُس شخص کے لیے جو راہ راست پر چلنا چاہتا ہو"
        },
        {
          "id": -2005828,
          "resource_id": 227,
          "text": "మీలో, ఋజుమార్గంలో నడవ దలచుకున్న ప్రతివాని కొరకు."
        }
      ]
    },
    {
      "id": 5829,
      "verse_number": 29,
      "verse_key": "81:29",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 525,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ",
      "page_number": 586,
      "juz_number": 30,
      "translations": [
        {
          "id": 407532,
          "resource_id": 85,
          "text": "But you will only wish to do so by the will of God, the Lord of all people."
        },
        {
          "id": 1550266,
          "resource_id": 831,
          "text": "Aur tumharey chahney se kuch nahin hota jab tak Allah Rabb-ul-Aalameen na chahey"
        },
        {
          "id": -1005829,
          "resource_id": "ur.maududi",
          "text": "اور تمہارے چاہنے سے کچھ نہیں ہوتا جب تک اللہ رب العالمین نہ چاہے"
        },
        {
          "id": -2005829,
          "resource_id": 227,
          "text": "మరియు సర్వలోకాల ప్రభువైన అల్లాహ్ తలచనంత వరకు, మీరు తలచినంత మాత్రాన ఏమీ కాదు."
        }
      ]
    }
  ]
}