{
  "syncedAt": "2026-08-31T09:57:47.554Z",
  "chapter": {
    "id": 82,
    "revelation_place": "makkah",
    "revelation_order": 82,
    "bismillah_pre": true,
    "name_simple": "Al-Infitar",
    "name_complex": "Al-'Infiţār",
    "name_arabic": "الإنفطار",
    "verses_count": 19,
    "pages": [
      587,
      587
    ],
    "translated_name": {
      "language_name": "english",
      "name": "The Cleaving"
    }
  },
  "verses": [
    {
      "id": 5830,
      "verse_number": 1,
      "verse_key": "82:1",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 526,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ",
      "page_number": 587,
      "juz_number": 30,
      "translations": [
        {
          "id": 407533,
          "resource_id": 85,
          "text": "When the sky is torn apart,"
        },
        {
          "id": 1550267,
          "resource_id": 831,
          "text": "Jab Aasman phat jayega"
        },
        {
          "id": -1005830,
          "resource_id": "ur.maududi",
          "text": "جب آسمان پھٹ جائے گا"
        },
        {
          "id": -2005830,
          "resource_id": 227,
          "text": "ఆకాశం చీల్చబడినప్పుడు!"
        }
      ]
    },
    {
      "id": 5831,
      "verse_number": 2,
      "verse_key": "82:2",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 526,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ",
      "page_number": 587,
      "juz_number": 30,
      "translations": [
        {
          "id": 407534,
          "resource_id": 85,
          "text": "when the stars are scattered,"
        },
        {
          "id": 1550268,
          "resource_id": 831,
          "text": "Aur jab taarey bikhar jayengey"
        },
        {
          "id": -1005831,
          "resource_id": "ur.maududi",
          "text": "اور جب تارے بکھر جائیں گے"
        },
        {
          "id": -2005831,
          "resource_id": 227,
          "text": "మరియు నక్షత్రాలు చెదిరి పోయినప్పుడు!"
        }
      ]
    },
    {
      "id": 5832,
      "verse_number": 3,
      "verse_key": "82:3",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 526,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلْبِحَارُ فُجِّرَتْ",
      "page_number": 587,
      "juz_number": 30,
      "translations": [
        {
          "id": 407535,
          "resource_id": 85,
          "text": "when the seas burst forth,"
        },
        {
          "id": 1550269,
          "resource_id": 831,
          "text": "Aur jab samandar phaad diye jayengey"
        },
        {
          "id": -1005832,
          "resource_id": "ur.maududi",
          "text": "اور جب سمندر پھاڑ دیے جائیں گے"
        },
        {
          "id": -2005832,
          "resource_id": 227,
          "text": "మరియు సముద్రాలు పొంగి పొరలి పోయినప్పుడు!"
        }
      ]
    },
    {
      "id": 5833,
      "verse_number": 4,
      "verse_key": "82:4",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 526,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ",
      "page_number": 587,
      "juz_number": 30,
      "translations": [
        {
          "id": 407536,
          "resource_id": 85,
          "text": "when graves turn inside out:"
        },
        {
          "id": 1550270,
          "resource_id": 831,
          "text": "Aur jab qabrein khol di jayengi"
        },
        {
          "id": -1005833,
          "resource_id": "ur.maududi",
          "text": "اور جب قبریں کھول دی جائیں گی"
        },
        {
          "id": -2005833,
          "resource_id": 227,
          "text": "మరియు సమాధులు పెళ్ళగింప (తెరువ) బడినప్పుడు!"
        }
      ]
    },
    {
      "id": 5834,
      "verse_number": 5,
      "verse_key": "82:5",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 526,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ",
      "page_number": 587,
      "juz_number": 30,
      "translations": [
        {
          "id": 407537,
          "resource_id": 85,
          "text": "each soul will know what it has done and what it has left undone."
        },
        {
          "id": 1550271,
          "resource_id": 831,
          "text": "Us waqt har shaks ko uska agla pichla sab kiya dhara maloom ho jayega"
        },
        {
          "id": -1005834,
          "resource_id": "ur.maududi",
          "text": "اُس وقت ہر شخص کو اُس کا اگلا پچھلا سب کیا دھرا معلوم ہو جائے گا"
        },
        {
          "id": -2005834,
          "resource_id": 227,
          "text": "ప్రతి వ్యక్తికి తాను చేసి పంపుకున్నది మరియు వెనుక వదలి పెట్టింది అంతా తెలిసి పోతుంది."
        }
      ]
    },
    {
      "id": 5835,
      "verse_number": 6,
      "verse_key": "82:6",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 526,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ",
      "page_number": 587,
      "juz_number": 30,
      "translations": [
        {
          "id": 407538,
          "resource_id": 85,
          "text": "Mankind, what has lured you away from God,"
        },
        {
          "id": 1550272,
          "resource_id": 831,
          "text": "Aey insaan kis cheez ne tujhey apne uss Rubb-e-kareem ki taraf se dhoke mein daal diya"
        },
        {
          "id": -1005835,
          "resource_id": "ur.maududi",
          "text": "اے انسان، کس چیز نے تجھے اپنے اُس رب کریم کی طرف سے دھوکے میں ڈال دیا"
        },
        {
          "id": -2005835,
          "resource_id": 227,
          "text": "ఓ మానవుడా! పరమదాత అయిన నీ ప్రభువును గురించి, ఏ విషయం నిన్ను ఏమరుపాటుకు గురి చేసింది?"
        }
      ]
    },
    {
      "id": 5836,
      "verse_number": 7,
      "verse_key": "82:7",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 526,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ",
      "page_number": 587,
      "juz_number": 30,
      "translations": [
        {
          "id": 407539,
          "resource_id": 85,
          "text": "your generous Lord, who created you, shaped you, proportioned you,"
        },
        {
          "id": 1550273,
          "resource_id": 831,
          "text": "Jisne tujhey paida kiya, tujhey nek-suk se durust kiya(shaped you), tujhe mutanasib(well-proportioned) banaya"
        },
        {
          "id": -1005836,
          "resource_id": "ur.maududi",
          "text": "جس نے تجھے پیدا کیا، تجھے نک سک سے درست کیا، تجھے متناسب بنایا"
        },
        {
          "id": -2005836,
          "resource_id": 227,
          "text": "ఆయనే నిన్ను సృష్టించాడు, తరువాత ఎలాంటి లోపం లేకుండా నిన్ను తీర్చిదిద్దాడు మరియు నిన్ను తగిన ప్రమాణంలో రూపొందించాడు."
        }
      ]
    },
    {
      "id": 5837,
      "verse_number": 8,
      "verse_key": "82:8",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 526,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فِىٓ أَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ",
      "page_number": 587,
      "juz_number": 30,
      "translations": [
        {
          "id": 407540,
          "resource_id": 85,
          "text": "in whatever form He chose?"
        },
        {
          "id": 1550274,
          "resource_id": 831,
          "text": "Aur jis surat mein chaha tujhko jodh kar tayyar kiya"
        },
        {
          "id": -1005837,
          "resource_id": "ur.maududi",
          "text": "اور جس صورت میں چاہا تجھ کو جوڑ کر تیار کیا؟"
        },
        {
          "id": -2005837,
          "resource_id": 227,
          "text": "తాను తలచిన ఆకారంలో నిన్ను మలిచాడు."
        }
      ]
    },
    {
      "id": 5838,
      "verse_number": 9,
      "verse_key": "82:9",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 526,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ",
      "page_number": 587,
      "juz_number": 30,
      "translations": [
        {
          "id": 407541,
          "resource_id": 85,
          "text": "Yet you still take the Judgement to be a lie!"
        },
        {
          "id": 1550275,
          "resource_id": 831,
          "text": "Hargiz nahin balke (asal baat yeh hai ke) tumlog jaza-o-saza ko jhutlate ho"
        },
        {
          "id": -1005838,
          "resource_id": "ur.maududi",
          "text": "ہرگز نہیں، بلکہ (اصل بات یہ ہے کہ) تم لوگ جزا و سزا کو جھٹلاتے ہو"
        },
        {
          "id": -2005838,
          "resource_id": 227,
          "text": "అలా కాదు! వాస్తవానికి మీరు (పరలోక) తీర్పును అబద్ధమని తిరస్కరిస్తున్నారు!"
        }
      ]
    },
    {
      "id": 5839,
      "verse_number": 10,
      "verse_key": "82:10",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 526,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِنَّ عَلَيْكُمْ لَحَـٰفِظِينَ",
      "page_number": 587,
      "juz_number": 30,
      "translations": [
        {
          "id": 407542,
          "resource_id": 85,
          "text": "Over you stand"
        },
        {
          "id": 1550276,
          "resource_id": 831,
          "text": "Halaanke tumpar nigraan muqarrar hain"
        },
        {
          "id": -1005839,
          "resource_id": "ur.maududi",
          "text": "حالانکہ تم پر نگراں مقرر ہیں"
        },
        {
          "id": -2005839,
          "resource_id": 227,
          "text": "మరియు, నిశ్చయంగా! మిమ్మల్ని కనిపెట్టుకొని ఉండేవారు (దేవదూతలు) ఉన్నారు."
        }
      ]
    },
    {
      "id": 5840,
      "verse_number": 11,
      "verse_key": "82:11",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 526,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كِرَامًا كَـٰتِبِينَ",
      "page_number": 587,
      "juz_number": 30,
      "translations": [
        {
          "id": 407543,
          "resource_id": 85,
          "text": "watchers, noble recorders"
        },
        {
          "id": 1550277,
          "resource_id": 831,
          "text": "Aisey muazzaz kaatib"
        },
        {
          "id": -1005840,
          "resource_id": "ur.maududi",
          "text": "ایسے معزز کاتب"
        },
        {
          "id": -2005840,
          "resource_id": 227,
          "text": "వారు, గౌరవనీయులైన లేఖకులు;"
        }
      ]
    },
    {
      "id": 5841,
      "verse_number": 12,
      "verse_key": "82:12",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 526,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَعْلَمُونَ مَا تَفْعَلُونَ",
      "page_number": 587,
      "juz_number": 30,
      "translations": [
        {
          "id": 407544,
          "resource_id": 85,
          "text": "who know what you do:"
        },
        {
          "id": 1550278,
          "resource_id": 831,
          "text": "Jo tumharey har fail(amal) ko jantey hain"
        },
        {
          "id": -1005841,
          "resource_id": "ur.maududi",
          "text": "جو تمہارے ہر فعل کو جانتے ہیں"
        },
        {
          "id": -2005841,
          "resource_id": 227,
          "text": "మీరు చేసేదంతా తెలుసుకునేవారు!"
        }
      ]
    },
    {
      "id": 5842,
      "verse_number": 13,
      "verse_key": "82:13",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 526,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ",
      "page_number": 587,
      "juz_number": 30,
      "translations": [
        {
          "id": 407545,
          "resource_id": 85,
          "text": "the good will live in bliss,"
        },
        {
          "id": 1550279,
          "resource_id": 831,
          "text": "Yaqeenan neik log mazey mei hongey"
        },
        {
          "id": -1005842,
          "resource_id": "ur.maududi",
          "text": "یقیناً نیک لوگ مزے میں ہوں گے"
        },
        {
          "id": -2005842,
          "resource_id": 227,
          "text": "నిశ్చయంగా పుణ్యాత్ములు సుఖసంతోషాలలో తేలియాడుతూ ఉంటారు."
        }
      ]
    },
    {
      "id": 5843,
      "verse_number": 14,
      "verse_key": "82:14",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 526,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍ",
      "page_number": 587,
      "juz_number": 30,
      "translations": [
        {
          "id": 407546,
          "resource_id": 85,
          "text": "and the wicked will burn in the Fire."
        },
        {
          "id": 1550280,
          "resource_id": 831,
          "text": "Aur beshak badkar log jahannam me jayenge"
        },
        {
          "id": -1005843,
          "resource_id": "ur.maududi",
          "text": "اور بے شک بدکار لوگ جہنم میں جائیں گے"
        },
        {
          "id": -2005843,
          "resource_id": 227,
          "text": "మరియు నిశ్చయంగా, దుష్టులు భగభగ మండే నరకాగ్నిలో ఉంటారు."
        }
      ]
    },
    {
      "id": 5844,
      "verse_number": 15,
      "verse_key": "82:15",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 526,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ",
      "page_number": 587,
      "juz_number": 30,
      "translations": [
        {
          "id": 407547,
          "resource_id": 85,
          "text": "They will enter it on the Day of Judgement"
        },
        {
          "id": 1550281,
          "resource_id": 831,
          "text": "Jaza ke din woh is mein daakhil hongey"
        },
        {
          "id": -1005844,
          "resource_id": "ur.maududi",
          "text": "جزا کے دن وہ اس میں داخل ہوں گے"
        },
        {
          "id": -2005844,
          "resource_id": 227,
          "text": "తీర్పు దినమున వారు అందులో ప్రవేశిస్తారు."
        }
      ]
    },
    {
      "id": 5845,
      "verse_number": 16,
      "verse_key": "82:16",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 526,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا هُمْ عَنْهَا بِغَآئِبِينَ",
      "page_number": 587,
      "juz_number": 30,
      "translations": [
        {
          "id": 407548,
          "resource_id": 85,
          "text": "and they will find no escape."
        },
        {
          "id": 1550282,
          "resource_id": 831,
          "text": "Aur us se hargiz gayab na ho sakengey"
        },
        {
          "id": -1005845,
          "resource_id": "ur.maududi",
          "text": "اور اُس سے ہرگز غائب نہ ہو سکیں گے"
        },
        {
          "id": -2005845,
          "resource_id": 227,
          "text": "మరియు వారు దాని నుండి ఎంత మాత్రం తప్పించుకోలేరు."
        }
      ]
    },
    {
      "id": 5846,
      "verse_number": 17,
      "verse_key": "82:17",
      "hizb_number": 59,
      "rub_el_hizb_number": 235,
      "ruku_number": 526,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ",
      "page_number": 587,
      "juz_number": 30,
      "translations": [
        {
          "id": 407549,
          "resource_id": 85,
          "text": "What will explain to you what the Day of Judgement is?"
        },
