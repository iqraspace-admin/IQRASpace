  "verses": [
    {
      "id": 6217,
      "verse_number": 1,
      "verse_key": "111:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 555,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " تَبَّتْ يَدَآ أَبِى لَهَبٍ وَتَبَّ",
      "page_number": 603,
      "juz_number": 30,
      "translations": [
        {
          "id": 407920,
          "resource_id": 85,
          "text": "May the hands of Abu Lahab be ruined! May he be ruined too!"
        },
        {
          "id": 1550654,
          "resource_id": 831,
          "text": "Toot gaye Abu Lahab ke haath aur na-murad ho gaya woh"
        },
        {
          "id": -1006217,
          "resource_id": "ur.maududi",
          "text": "ٹوٹ گئے ابولہب کے ہاتھ اور نامراد ہو گیا وہ"
        },
        {
          "id": -2006217,
          "resource_id": 227,
          "text": "అబూ లహబ్ రెండు చేతులూ నశించుగాక మరియు అతడు కూడా నశించి పోవు గాక!"
        }
      ]
    },
    {
      "id": 6218,
      "verse_number": 2,
      "verse_key": "111:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 555,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ",
      "page_number": 603,
      "juz_number": 30,
      "translations": [
        {
          "id": 407921,
          "resource_id": 85,
          "text": "Neither his wealth nor his gains will help him:"
        },
        {
          "id": 1550655,
          "resource_id": 831,
          "text": "Uska maal aur jo kuch us ne kamaya woh uske kisi kaam na aaya"
        },
        {
          "id": -1006218,
          "resource_id": "ur.maududi",
          "text": "اُس کا مال اور جو کچھ اس نے کمایا وہ اُس کے کسی کام نہ آیا"
        },
        {
          "id": -2006218,
          "resource_id": 227,
          "text": "అతడి ధనం మరియు అతడి సంపాదన (సంతానం) అతడికి ఏ మాత్రం పనికి రావు!"
        }
      ]
    },
    {
      "id": 6219,
      "verse_number": 3,
      "verse_key": "111:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 555,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "سَيَصْلَىٰ نَارًا ذَاتَ لَهَبٍ",
      "page_number": 603,
      "juz_number": 30,
      "translations": [
        {
          "id": 407922,
          "resource_id": 85,
          "text": "he will burn in the Flaming Fire––"
        },
        {
          "id": 1550656,
          "resource_id": 831,
          "text": "Zaroor woh shola zan Aag mei dala jayega"
        },
        {
          "id": -1006219,
          "resource_id": "ur.maududi",
          "text": "ضرور وہ شعلہ زن آگ میں ڈالا جائے گا"
        },
        {
          "id": -2006219,
          "resource_id": 227,
          "text": "అతడు ప్రజ్వలించే నరకాగ్నిలో కాల్చబడతాడు!"
        }
      ]
    },
    {
      "id": 6220,
      "verse_number": 4,
      "verse_key": "111:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 555,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ",
      "page_number": 603,
      "juz_number": 30,
      "translations": [
        {
          "id": 407923,
          "resource_id": 85,
          "text": "and so will his wife, the firewood-carrier,"
        },
        {
          "id": 1550657,
          "resource_id": 831,
          "text": "Aur (us ke saath) us ki joru(wife) bhi lagai bujhai karne wali"
        },
        {
          "id": -1006220,
          "resource_id": "ur.maududi",
          "text": "اور (اُس کے ساتھ) اُس کی جورو بھی، لگائی بجھائی کرنے والی"
        },
        {
          "id": -2006220,
          "resource_id": 227,
          "text": "మరియు అతడి భార్య కూడా! కట్టెలు మోసే (చాడీలు చెప్పి కలహాలు రేకెత్తించే) స్త్రీ!"
        }
      ]
    },
    {
      "id": 6221,
      "verse_number": 5,
      "verse_key": "111:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 555,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فِى جِيدِهَا حَبْلٌ مِّن مَّسَدٍۭ",
      "page_number": 603,
      "juz_number": 30,
      "translations": [
        {
          "id": 407924,
          "resource_id": 85,
          "text": "with a palm-fibre rope around her neck."
        },
        {
          "id": 1550658,
          "resource_id": 831,
          "text": "Us ki gardan(neck) mein moonj ki rassi hogi"
        },
        {
          "id": -1006221,
          "resource_id": "ur.maududi",
          "text": "اُس کی گردن میں مونجھ کی رسی ہوگی"
        },
        {
          "id": -2006221,
          "resource_id": 227,
          "text": "ఆమె మెడలో బాగా పేనిని ఖర్జూరపునార త్రాడు (మసద్) ఉంటుంది."
        }
      ]
    }
  ]
}