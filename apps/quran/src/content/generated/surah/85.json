    ],
    "translated_name": {
      "language_name": "english",
      "name": "The Mansions of the Stars"
    }
  },
  "verses": [
    {
      "id": 5910,
      "verse_number": 1,
      "verse_key": "85:1",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " وَٱلسَّمَآءِ ذَاتِ ٱلْبُرُوجِ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407613,
          "resource_id": 85,
          "text": "By the sky with its towering constellations,"
        },
        {
          "id": 1550347,
          "resource_id": 831,
          "text": "Kasam hai mazboot qalon waley (impregnable castles )aasman ki"
        },
        {
          "id": -1005910,
          "resource_id": "ur.maududi",
          "text": "قسم ہے مضبوط قلعوں والے آسمان کی"
        },
        {
          "id": -2005910,
          "resource_id": 227,
          "text": "విస్తారమైన తారాగణం గల ఆకాశం సాక్షిగా!"
        }
      ]
    },
    {
      "id": 5911,
      "verse_number": 2,
      "verse_key": "85:2",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلْيَوْمِ ٱلْمَوْعُودِ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407614,
          "resource_id": 85,
          "text": "by the promised Day,"
        },
        {
          "id": 1550348,
          "resource_id": 831,
          "text": "Aur us din ki jiska wada kiya gaya hai"
        },
        {
          "id": -1005911,
          "resource_id": "ur.maududi",
          "text": "اور اُس دن کی جس کا وعدہ کیا گیا ہے"
        },
        {
          "id": -2005911,
          "resource_id": 227,
          "text": "వాగ్దానం చేయబడిన (పునరుత్థాన) దినం సాక్షిగా!"
        }
      ]
    },
    {
      "id": 5912,
      "verse_number": 3,
      "verse_key": "85:3",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَشَاهِدٍ وَمَشْهُودٍ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407615,
          "resource_id": 85,
          "text": "by the Witness and that which is witnessed,"
        },
        {
          "id": 1550349,
          "resource_id": 831,
          "text": "Aur dekhnay walay ki aur dekhi janey wali cheez ki"
        },
        {
          "id": -1005912,
          "resource_id": "ur.maududi",
          "text": "اور دیکھنے والے کی اور دیکھی جانے والی چیز کی"
        },
        {
          "id": -2005912,
          "resource_id": 227,
          "text": "చూచేదాని (దినం) మరియు చూడబడే దాని (దినం) సాక్షిగా!"
        }
      ]
    },
    {
      "id": 5913,
      "verse_number": 4,
      "verse_key": "85:4",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "قُتِلَ أَصْحَـٰبُ ٱلْأُخْدُودِ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407616,
          "resource_id": 85,
          "text": "damned were the makers of the trench,"
        },
        {
          "id": 1550350,
          "resource_id": 831,
          "text": "kay maarey gaye gaddey(pit) waley"
        },
        {
          "id": -1005913,
          "resource_id": "ur.maududi",
          "text": "کہ مارے گئے گڑھے والے"
        },
        {
          "id": -2005913,
          "resource_id": 227,
          "text": "అగ్ని కందకం (ఉఖూద్) వారు నాశనం చేయబడ్డారు."
        }
      ]
    },
    {
      "id": 5914,
      "verse_number": 5,
      "verse_key": "85:5",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلنَّارِ ذَاتِ ٱلْوَقُودِ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407617,
          "resource_id": 85,
          "text": "the makers of the fuel-stoked fire!"
        },
        {
          "id": 1550351,
          "resource_id": 831,
          "text": "uss gaddey(pit) waley] jis mei khoob bhadakte huey indhan ki aag thi"
        },
        {
          "id": -1005914,
          "resource_id": "ur.maududi",
          "text": "(اُس گڑھے والے) جس میں خوب بھڑکتے ہوئے ایندھن کی آگ تھی"
        },
        {
          "id": -2005914,
          "resource_id": 227,
          "text": "ఇంధనంతో తీవ్రంగా మండే అగ్నిని రాజేసేవారు."
        }
      ]
    },
    {
      "id": 5915,
      "verse_number": 6,
      "verse_key": "85:6",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِذْ هُمْ عَلَيْهَا قُعُودٌ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407618,
          "resource_id": 85,
          "text": "They sat down"
        },
        {
          "id": 1550352,
          "resource_id": 831,
          "text": "jabke woh us gaddey ke kinare par baithay huey thay"
        },
        {
          "id": -1005915,
          "resource_id": "ur.maududi",
          "text": "جبکہ وہ اُس گڑھے کے کنارے بیٹھے ہوئے تھے"
        },
        {
          "id": -2005915,
          "resource_id": 227,
          "text": "వారు దాని (ఆ కందకం) అంచుపై కూర్చొని ఉన్నప్పుడు;"
        }
      ]
    },
    {
      "id": 5916,
      "verse_number": 7,
      "verse_key": "85:7",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407619,
          "resource_id": 85,
          "text": "to watch what they were doing to the believers."
        },
        {
          "id": 1550353,
          "resource_id": 831,
          "text": "Aur jo kuch woh imaan laney walon ke saath kar rahey thay usey dekh rahey thay"
        },
        {
          "id": -1005916,
          "resource_id": "ur.maududi",
          "text": "اور جو کچھ وہ ایمان لانے والوں کے ساتھ کر رہے تھے اُسے دیکھ رہے تھے"
        },
        {
          "id": -2005916,
          "resource_id": 227,
          "text": "మరియు తాము విశ్వాసుల పట్ల చేసే ఘోర కార్యాలను (సజీవ దహనాలను) తిలకించేవారు."
        }
      ]
    },
    {
      "id": 5917,
      "verse_number": 8,
      "verse_key": "85:8",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407620,
          "resource_id": 85,
          "text": "Their only grievance against them was their faith in God, the Mighty, the Praiseworthy,"
        },
        {
          "id": 1550354,
          "resource_id": 831,
          "text": "Aur un ehley imaan se unki dushmani iske siwa kisi wajah se na thi ke woh us khuda par imaan le aaye thay jo zabardast aur apni zaat mei aap mahmood(praiseworthy) hai"
        },
        {
          "id": -1005917,
          "resource_id": "ur.maududi",
          "text": "اور اُن اہل ایمان سے اُن کی دشمنی اِس کے سوا کسی وجہ سے نہ تھی کہ وہ اُس خدا پر ایمان لے آئے تھے جو زبردست اور اپنی ذات میں آپ محمود ہے"
        },
        {
          "id": -2005917,
          "resource_id": 227,
          "text": "మరియు వారు విశ్వాసుల పట్ల కసి పెంచుకోవడానికి కారణం - వారు (విశ్వాసులు) సర్వశక్తిమంతుడు, సర్వ స్తోత్రాలకు అర్హుడైన - అల్లాహ్ ను విశ్వసించడం మాత్రమే!"
        }
      ]
    },
    {
      "id": 5918,
      "verse_number": 9,
      "verse_key": "85:9",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ شَهِيدٌ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407621,
          "resource_id": 85,
          "text": "to whom all control over the heavens and earth belongs: God is witness over all things."
        },
        {
          "id": 1550355,
          "resource_id": 831,
          "text": "Jo aasmano aur zameen ki sultanat ka maalik hai, aur woh khuda sab kuch dekh raha hai"
        },
        {
          "id": -1005918,
          "resource_id": "ur.maududi",
          "text": "جو آسمانوں اور زمین کی سلطنت کا مالک ہے، اور وہ خدا سب کچھ دیکھ رہا ہے"
        },
        {
          "id": -2005918,
          "resource_id": 227,
          "text": "ఆయనే! ఎవరికైతే భూమ్యాకాశాల ఆధిపత్యం ఉందో! మరియు అల్లాహ్ యే ప్రతిదానికి సాక్షి."
        }
      ]
    },
    {
      "id": 5919,
      "verse_number": 10,
      "verse_key": "85:10",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407622,
          "resource_id": 85,
          "text": "For those who persecute believing men and women, and do not repent afterwards, there will be the torment of Hell and burning."
        },
        {
          "id": 1550356,
          "resource_id": 831,
          "text": "Jin logon ne momin mardon aur auraton par zulm o sitam toda aur phir ussey taib na huey, yaqeenan unke liye jahannum ka azaab hai aur unke liye jalaye janey ki saza hai"
        },
        {
          "id": -1005919,
          "resource_id": "ur.maududi",
          "text": "جن لوگوں نے مومن مردوں اور عورتوں پر ظلم و ستم توڑا اور پھر اس سے تائب نہ ہوئے، یقیناً اُن کے لیے جہنم کا عذاب ہے اور ان کے لیے جلائے جانے کی سزا ہے"
        },
        {
          "id": -2005919,
          "resource_id": 227,
          "text": "ఎవరైతే విశ్వాసులైన పురుషులను మరియు విశ్వాసులైన స్త్రీలను హింసిస్తారో, ఆ తరువాత పశ్చాత్తాపంతో క్షమాపణ కోరరో! నిశ్చయంగా, అలాంటి వారికి నరకశిక్ష ఉంటుంది. మరియు వారికి మండే నరకాగ్ని శిక్ష విధించబడుతుంది."
        }
      ]
    },
    {
      "id": 5920,
      "verse_number": 11,
      "verse_key": "85:11",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمْ جَنَّـٰتٌ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَـٰرُ ۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْكَبِيرُ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407623,
          "resource_id": 85,
          "text": "But for those who believe and do good deeds there will be Gardens graced with flowing streams: that is the great triumph."
        },
        {
          "id": 1550357,
          "resource_id": 831,
          "text": "Jo log imaan laaye aur jinho ne neik amal kiye yaqeenan unke liye jannat ke baagh hain jinke nichey nehrein behti hongi, yeh hai badi kamyabi"
        },
        {
          "id": -1005920,
          "resource_id": "ur.maududi",
          "text": "جو لوگ ایمان لائے اور جنہوں نے نیک عمل کیے، یقیناً اُن کے لیے جنت کے باغ ہیں جن کے نیچے نہریں بہتی ہوں گی، یہ ہے بڑی کامیابی"
        },
        {
          "id": -2005920,
          "resource_id": 227,
          "text": "నిశ్చయంగా, విశ్వసించి సత్కార్యాలు చేసేవారి కొరకు క్రింద సెలయేళ్ళు ప్రవహించే స్వర్గవనాలుంటాయి. అదే గొప్ప విజయం."
        }
      ]
    },
    {
      "id": 5921,
      "verse_number": 12,
      "verse_key": "85:12",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407624,
          "resource_id": 85,
          "text": "[Prophet], your Lord’s punishment is truly stern––"
        },
        {
          "id": 1550358,
          "resource_id": 831,
          "text": "Dar haqeeqat tumharey Rubb ki pakad badi sakht hai"
        },
        {
          "id": -1005921,
          "resource_id": "ur.maududi",
          "text": "درحقیقت تمہارے رب کی پکڑ بڑی سخت ہے"
        },
        {
          "id": -2005921,
          "resource_id": 227,
          "text": "నిశ్చయంగా, నీ ప్రభువు యొక్క పట్టు (శిక్ష) చాలా కఠినమైనది."
        }
      ]
    },
    {
      "id": 5922,
      "verse_number": 13,
      "verse_key": "85:13",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّهُۥ هُوَ يُبْدِئُ وَيُعِيدُ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407625,
          "resource_id": 85,
          "text": "it is He who brings people to life, and will restore them to life again––"
        },
        {
          "id": 1550359,
          "resource_id": 831,
          "text": "Wahi pehli baar paida karta hai aur wahi dobara paida karega"
        },
        {
          "id": -1005922,
          "resource_id": "ur.maududi",
          "text": "وہی پہلی بار پیدا کرتا ہے اور وہی دوبارہ پیدا کرے گا"
        },
        {
          "id": -2005922,
          "resource_id": 227,
          "text": "నిశ్చయంగా, ఆయనే (సృష్టిని) ఆరంభించేవాడు మరియు ఆయనే (దానిని) మరల ఉనికిలోకి తెచ్చేవాడు."
        }
      ]
    },
    {
      "id": 5923,
      "verse_number": 14,
      "verse_key": "85:14",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَهُوَ ٱلْغَفُورُ ٱلْوَدُودُ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407626,
          "resource_id": 85,
          "text": "and He is the Most Forgiving, the Most Loving."
        },
        {
          "id": 1550360,
          "resource_id": 831,
          "text": "Aur woh bakshne wala hai, mohabbat karne wala hai"
        },
        {
          "id": -1005923,
          "resource_id": "ur.maududi",
          "text": "اور وہ بخشنے والا ہے، محبت کرنے والا ہے"
        },
        {
          "id": -2005923,
          "resource_id": 227,
          "text": "మరియు ఆయన క్షమాశీలుడు, అమిత వాత్సల్యుడు."
        }
      ]
    },
    {
      "id": 5924,
      "verse_number": 15,
      "verse_key": "85:15",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ذُو ٱلْعَرْشِ ٱلْمَجِيدُ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407627,
          "resource_id": 85,
          "text": "The Glorious Lord of the Throne,"
        },
        {
          "id": 1550361,
          "resource_id": 831,
          "text": "Arsh ka maalik hai, buzurg-o-bartar hai"
        },
        {
          "id": -1005924,
          "resource_id": "ur.maududi",
          "text": "عرش کا مالک ہے، بزرگ و برتر ہے"
        },
        {
          "id": -2005924,
          "resource_id": 227,
          "text": "సింహాసనాన్ని (అర్ష్ ను) అధిష్టించిన వాడు, మహత్త్వపూర్ణుడు."
        }
      ]
    },
    {
      "id": 5925,
      "verse_number": 16,
      "verse_key": "85:16",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَعَّالٌ لِّمَا يُرِيدُ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407628,
          "resource_id": 85,
          "text": "He does whatever He will."
        },
        {
          "id": 1550362,
          "resource_id": 831,
          "text": "Aur jo kuch chahey kar daalney wala hai"
        },
        {
          "id": -1005925,
          "resource_id": "ur.maududi",
          "text": "اور جو کچھ چاہے کر ڈالنے والا ہے"
        },
        {
          "id": -2005925,
          "resource_id": 227,
          "text": "తాను తలచింది చేయగలవాడు."
        }
      ]
    },
    {
      "id": 5926,
      "verse_number": 17,
      "verse_key": "85:17",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْجُنُودِ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407629,
          "resource_id": 85,
          "text": "Have you [not] heard the stories of the forces"
        },
        {
          "id": 1550363,
          "resource_id": 831,
          "text": "Kya tumhey lashkaron ki khabar pahunchi hai"
        },
        {
          "id": -1005926,
          "resource_id": "ur.maududi",
          "text": "کیا تمہیں لشکروں کی خبر پہنچی ہے؟"
        },
        {
          "id": -2005926,
          "resource_id": 227,
          "text": "ఏమీ? సైన్యాల వారి సమాచారం నీకు అందిందా?"
        }
      ]
    },
    {
      "id": 5927,
      "verse_number": 18,
      "verse_key": "85:18",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فِرْعَوْنَ وَثَمُودَ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407630,
          "resource_id": 85,
          "text": "of Pharaoh and Thamud?"
        },
        {
          "id": 1550364,
          "resource_id": 831,
          "text": "Firoun aur samood (ke lashkaron) ki"
        },
        {
          "id": -1005927,
          "resource_id": "ur.maududi",
          "text": "فرعون اور ثمود (کے لشکروں) کی؟"
        },
        {
          "id": -2005927,
          "resource_id": 227,
          "text": "ఫిర్ఔన్ మరియు సమూద్ వారి (సైన్యాల)."
        }
      ]
    },
    {
      "id": 5928,
      "verse_number": 19,
      "verse_key": "85:19",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى تَكْذِيبٍ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407631,
          "resource_id": 85,
          "text": "Yet still the disbelievers persist in denial."
        },
        {
          "id": 1550365,
          "resource_id": 831,
          "text": "Magar jinho ne kufr kiya hai woh jhutlaney mein lagey huey hain"
        },
        {
          "id": -1005928,
          "resource_id": "ur.maududi",
          "text": "مگر جنہوں نے کفر کیا ہے وہ جھٹلانے میں لگے ہوئے ہیں"
        },
        {
          "id": -2005928,
          "resource_id": 227,
          "text": "అలా కాదు, సత్యతిరస్కారులు (సత్యాన్ని) తిరస్కరించుటలో నిమగ్నులై ఉన్నారు."
        }
      ]
    },
    {
      "id": 5929,
      "verse_number": 20,
      "verse_key": "85:20",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطٌۢ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407632,
          "resource_id": 85,
          "text": "God surrounds them all."
        },
        {
          "id": 1550366,
          "resource_id": 831,
          "text": "Halaanke Allah ne unko gherey mein le rakha hai"
        },
        {
          "id": -1005929,
          "resource_id": "ur.maududi",
          "text": "حالانکہ اللہ نے ان کو گھیرے میں لے رکھا ہے"
        },
        {
          "id": -2005929,
          "resource_id": 227,
          "text": "మరియు అల్లాహ్ వారిని వెనుక (ప్రతి దిక్కు) నుండి చుట్టుముట్టి ఉన్నాడు."
        }
      ]
    },
    {
      "id": 5930,
      "verse_number": 21,
      "verse_key": "85:21",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "بَلْ هُوَ قُرْءَانٌ مَّجِيدٌ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407633,
          "resource_id": 85,
          "text": "This is truly a glorious Quran"
        },
        {
          "id": 1550367,
          "resource_id": 831,
          "text": "(unke jhutlaney se iss quran ka kuch nahin bigadta) balkey yeh quran buland paya hai"
        },
        {
          "id": -1005930,
          "resource_id": "ur.maududi",
          "text": "(اُن کے جھٹلانے سے اِس قرآن کا کچھ نہیں بگڑتا) بلکہ یہ قرآن بلند پایہ ہے"
        },
        {
          "id": -2005930,
          "resource_id": 227,
          "text": "వాస్తవానికి, ఇది ఒక దివ్యమైన ఖుర్ఆన్."
        }
      ]
    },
    {
      "id": 5931,
      "verse_number": 22,
      "verse_key": "85:22",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 529,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فِى لَوْحٍ مَّحْفُوظٍۭ",
      "page_number": 590,
      "juz_number": 30,
      "translations": [
        {
          "id": 407634,
          "resource_id": 85,
          "text": "[written] on a preserved Tablet."
        },
        {
          "id": 1550368,
          "resource_id": 831,
          "text": "Us loah mei (naqsh hai) jo mehfooz hai"
        },
        {
          "id": -1005931,
          "resource_id": "ur.maududi",
          "text": "اُس لوح میں (نقش ہے) جو محفوظ ہے"
        },
        {
          "id": -2005931,
          "resource_id": 227,
          "text": "సురక్షితమైన ఫలకం (లౌహె మహ్ ఫూజ్) లో (వ్రాయబడి) ఉన్నది."
        }
      ]
    }
  ]
}