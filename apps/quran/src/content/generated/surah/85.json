{
  "syncedAt": "2026-08-31T09:57:48.844Z",
  "chapter": {
    "id": 85,
    "revelation_place": "makkah",
    "revelation_order": 27,
    "bismillah_pre": true,
    "name_simple": "Al-Buruj",
    "name_complex": "Al-Burūj",
    "name_arabic": "البروج",
    "verses_count": 22,
    "pages": [
      590,
