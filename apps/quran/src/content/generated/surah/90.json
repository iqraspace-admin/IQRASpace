{
  "syncedAt": "2026-08-31T09:57:50.999Z",
  "chapter": {
    "id": 90,
    "revelation_place": "makkah",
    "revelation_order": 35,
    "bismillah_pre": true,
    "name_simple": "Al-Balad",
    "name_complex": "Al-Balad",
    "name_arabic": "البلد",
    "verses_count": 20,
    "pages": [
      594,
      594
    ],
    "translated_name": {
      "language_name": "english",
      "name": "The City"
    }
  },
  "verses": [
    {
      "id": 6024,
      "verse_number": 1,
      "verse_key": "90:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " لَآ أُقْسِمُ بِهَـٰذَا ٱلْبَلَدِ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407727,
          "resource_id": 85,
          "text": "I swear by this city––"
        },
        {
          "id": 1550461,
          "resource_id": 831,
          "text": "Nahin mai kasam khata hoon is shehar(city) ki"
        },
        {
          "id": -1006024,
          "resource_id": "ur.maududi",
          "text": "نہیں، میں قسم کھاتا ہوں اِس شہر کی"
        },
        {
          "id": -2006024,
          "resource_id": 227,
          "text": "కాదు, నేను ఈ నగరం (మక్కా) సాక్షిగా (అంటున్నాను)!"
        }
      ]
    },
    {
      "id": 6025,
      "verse_number": 2,
      "verse_key": "90:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَنتَ حِلٌّۢ بِهَـٰذَا ٱلْبَلَدِ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407728,
          "resource_id": 85,
          "text": "and you [Prophet] are an inhabitant of this city––"
        },
        {
          "id": 1550462,
          "resource_id": 831,
          "text": "Aur haal yeh hai ke (Aey nabi) is shehar mein tumko halal kar liya gaya hai"
        },
        {
          "id": -1006025,
          "resource_id": "ur.maududi",
          "text": "اور حال یہ ہے کہ (اے نبیؐ) اِس شہر میں تم کو حلال کر لیا گیا ہے"
        },
        {
          "id": -2006025,
          "resource_id": 227,
          "text": "మరియు నీకు ఈ నగరంలో (మక్కాలో) స్వేచ్ఛ ఉంది."
        }
      ]
    },
    {
      "id": 6026,
      "verse_number": 3,
      "verse_key": "90:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَوَالِدٍ وَمَا وَلَدَ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407729,
          "resource_id": 85,
          "text": "[I swear] by parent and offspring,"
        },
        {
          "id": 1550463,
          "resource_id": 831,
          "text": "Aur kasam khata hoon baap(Adam) ki aur us aulad ki jo ussey paida hui"
        },
        {
          "id": -1006026,
          "resource_id": "ur.maududi",
          "text": "اور قسم کھاتا ہوں باپ کی اور اس اولاد کی جو اس سے پیدا ہوئی"
        },
        {
          "id": -2006026,
          "resource_id": 227,
          "text": "మరియు తండ్రి (మూలపురుషుడు) మరియు అతని సంతానం సాక్షిగా!"
        }
      ]
    },
    {
      "id": 6027,
      "verse_number": 4,
      "verse_key": "90:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِى كَبَدٍ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407730,
          "resource_id": 85,
          "text": "that We have created man for toil and trial."
        },
        {
          "id": 1550464,
          "resource_id": 831,
          "text": "Dar haqeeqat humne Insan ko mushakkat mein paida kiya hai"
        },
        {
          "id": -1006027,
          "resource_id": "ur.maududi",
          "text": "درحقیقت ہم نے انسان کو مشقت میں پیدا کیا ہے"
        },
        {
          "id": -2006027,
          "resource_id": 227,
          "text": "వాస్తవానికి, మేము మానవుణ్ణి శ్రమజీవిగా పుట్టించాము."
        }
      ]
    },
    {
      "id": 6028,
      "verse_number": 5,
      "verse_key": "90:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407731,
          "resource_id": 85,
          "text": "Does he think that no one will have power over him?"
        },
        {
          "id": 1550465,
          "resource_id": 831,
          "text": "Kya usne yeh samajh rakhha hai kay uspar koi qaabu na paa sakega"
        },
        {
          "id": -1006028,
          "resource_id": "ur.maududi",
          "text": "کیا اُس نے یہ سمجھ رکھا ہے کہ اُس پر کوئی قابو نہ پا سکے گا؟"
        },
        {
          "id": -2006028,
          "resource_id": 227,
          "text": "ఏమిటి? తనను ఎవ్వడూ వశపరచుకో లేడని అతడు భావిస్తున్నాడా?"
        }
      ]
    },
    {
      "id": 6029,
      "verse_number": 6,
      "verse_key": "90:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَقُولُ أَهْلَكْتُ مَالًا لُّبَدًا",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407732,
          "resource_id": 85,
          "text": "‘I have squandered great wealth,’ he says."
        },
        {
          "id": 1550466,
          "resource_id": 831,
          "text": "Kehta hai ke maine dhairon maal udaa diya"
        },
        {
          "id": -1006029,
          "resource_id": "ur.maududi",
          "text": "کہتا ہے کہ میں نے ڈھیروں مال اڑا دیا"
        },
        {
          "id": -2006029,
          "resource_id": 227,
          "text": "అతడు: \"నేను విపరీత ధనాన్ని ఖర్చు పెట్టాను!\" అని అంటాడు."
        }
      ]
    },
    {
      "id": 6030,
      "verse_number": 7,
      "verse_key": "90:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407733,
          "resource_id": 85,
          "text": "Does he think no one observes him?"
        },
        {
          "id": 1550467,
          "resource_id": 831,
          "text": "Kya woh samajhta hai kay kisi ne usko nahin dekha"
        },
        {
          "id": -1006030,
          "resource_id": "ur.maududi",
          "text": "کیا وہ سمجھتا ہے کہ کسی نے اُس کو نہیں دیکھا؟"
        },
        {
          "id": -2006030,
          "resource_id": 227,
          "text": "ఏమిటి? తనను ఎవ్వడూ చూడటం లేదని అతడు భావిస్తున్నాడా?"
        }
      ]
    },
    {
      "id": 6031,
      "verse_number": 8,
      "verse_key": "90:8",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407734,
          "resource_id": 85,
          "text": "Did We not give him eyes,"
        },
        {
          "id": 1550468,
          "resource_id": 831,
          "text": "Kya humne usey do aankhein"
        },
        {
          "id": -1006031,
          "resource_id": "ur.maududi",
          "text": "کیا ہم نے اُسے دو آنکھیں"
        },
        {
          "id": -2006031,
          "resource_id": 227,
          "text": "ఏమిటి? మేము అతనికి రెండు కళ్ళు ఇవ్వలేదా?"
        }
      ]
    },
    {
      "id": 6032,
      "verse_number": 9,
      "verse_key": "90:9",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلِسَانًا وَشَفَتَيْنِ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407735,
          "resource_id": 85,
          "text": "a tongue, lips,"
        },
        {
          "id": 1550469,
          "resource_id": 831,
          "text": "Aur ek zubaan aur do honth nahin diye"
        },
        {
          "id": -1006032,
          "resource_id": "ur.maududi",
          "text": "اور ایک زبان اور دو ہونٹ نہیں دیے؟"
        },
        {
          "id": -2006032,
          "resource_id": 227,
          "text": "మరియు నాలుకను మరియు రెండు పెదవులను."
        }
      ]
    },
    {
      "id": 6033,
      "verse_number": 10,
      "verse_key": "90:10",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَهَدَيْنَـٰهُ ٱلنَّجْدَيْنِ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407736,
          "resource_id": 85,
          "text": "and point out to him the two clear ways [of good and evil]?"
        },
        {
          "id": 1550470,
          "resource_id": 831,
          "text": "Aur dono numayan raste usey (nahin) dikha diye"
        },
        {
          "id": -1006033,
          "resource_id": "ur.maududi",
          "text": "اور دونوں نمایاں راستے اُسے (نہیں) دکھا دیے؟"
        },
        {
          "id": -2006033,
          "resource_id": 227,
          "text": "మరియు అతనికి (మంచీ - చెడూ) అనే స్పష్టమైన రెండు మార్గాలను చూపాము."
        }
      ]
    },
    {
      "id": 6034,
      "verse_number": 11,
      "verse_key": "90:11",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407737,
          "resource_id": 85,
          "text": "Yet he has not attempted the steep path."
        },
        {
          "id": 1550471,
          "resource_id": 831,
          "text": "Magar usne dushwar guzar ghati(steep) se guzarne ki himmat na ki"
        },
        {
          "id": -1006034,
          "resource_id": "ur.maududi",
          "text": "مگر اس نے دشوار گزار گھاٹی سے گزرنے کی ہمت نہ کی"
        },
        {
          "id": -2006034,
          "resource_id": 227,
          "text": "కాని అతడు కష్టతరమైన ఊర్ధ్వ గమనానికి సాహసించలేదు!"
        }
      ]
    },
    {
      "id": 6035,
      "verse_number": 12,
      "verse_key": "90:12",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407738,
          "resource_id": 85,
          "text": "What will explain to you what the steep path is?"
        },
        {
          "id": 1550472,
          "resource_id": 831,
          "text": "Aur tum kya jaano kay kya hai woh dushwar guzar ghaati"
        },
        {
          "id": -1006035,
          "resource_id": "ur.maududi",
          "text": "اور تم کیا جانو کہ کیا ہے وہ دشوار گزار گھاٹی؟"
        },
        {
          "id": -2006035,
          "resource_id": 227,
          "text": "మరియు ఆ ఊర్ధ్వగమనం అంటే ఏమిటో నీకు తెలుసా?"
        }
      ]
    },
    {
      "id": 6036,
      "verse_number": 13,
      "verse_key": "90:13",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَكُّ رَقَبَةٍ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407739,
          "resource_id": 85,
          "text": "It is to free a slave,"
        },
        {
          "id": 1550473,
          "resource_id": 831,
          "text": "Kisi gardan ko gulami se chudana"
        },
        {
          "id": -1006036,
          "resource_id": "ur.maududi",
          "text": "کسی گردن کو غلامی سے چھڑانا"
        },
        {
          "id": -2006036,
          "resource_id": 227,
          "text": "అది ఒకని మెడను (బానిసత్వం నుండి) విడిపించడం."
        }
      ]
    },
    {
      "id": 6037,
      "verse_number": 14,
      "verse_key": "90:14",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَوْ إِطْعَـٰمٌ فِى يَوْمٍ ذِى مَسْغَبَةٍ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407740,
          "resource_id": 85,
          "text": "to feed at a time of hunger"
        },
        {
          "id": 1550474,
          "resource_id": 831,
          "text": "Ya faake ke din"
        },
        {
          "id": -1006037,
          "resource_id": "ur.maududi",
          "text": "یا فاقے کے دن"
        },
        {
          "id": -2006037,
          "resource_id": 227,
          "text": "లేదా! (స్వయంగా) ఆకలి గొని ఉన్న రోజు కూడా (ఇతరులకు) అన్నం పెట్టడం."
        }
      ]
    },
    {
      "id": 6038,
      "verse_number": 15,
      "verse_key": "90:15",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَتِيمًا ذَا مَقْرَبَةٍ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407741,
          "resource_id": 85,
          "text": "an orphaned relative"
        },
        {
          "id": 1550475,
          "resource_id": 831,
          "text": "kisi qareebi yateem"
        },
        {
          "id": -1006038,
          "resource_id": "ur.maududi",
          "text": "کسی قریبی یتیم"
        },
        {
          "id": -2006038,
          "resource_id": 227,
          "text": "సమీప అనాథునికి గానీ;"
        }
      ]
    },
    {
      "id": 6039,
      "verse_number": 16,
      "verse_key": "90:16",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407742,
          "resource_id": 85,
          "text": "or a poor person in distress,"
        },
        {
          "id": 1550476,
          "resource_id": 831,
          "text": "Ya khaak nasheen miskeen ko khana khilana"
        },
        {
          "id": -1006039,
          "resource_id": "ur.maududi",
          "text": "یا خاک نشین مسکین کو کھانا کھلانا"
        },
        {
          "id": -2006039,
          "resource_id": 227,
          "text": "లేక, దిక్కులేని నిరుపేదకు గానీ!"
        }
      ]
    },
    {
      "id": 6040,
      "verse_number": 17,
      "verse_key": "90:17",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407743,
          "resource_id": 85,
          "text": "and to be one of those who believe and urge one another to steadfastness and compassion."
        },
        {
          "id": 1550477,
          "resource_id": 831,
          "text": "Phir (iske saath yeh kay) aadmi un logon mein shamil ho jo imaan laye aur jinhon ne ek dusrey ko sabr aur (khalq-e-khuda par) raham ki talqeen ki"
        },
        {
          "id": -1006040,
          "resource_id": "ur.maududi",
          "text": "پھر (اس کے ساتھ یہ کہ) آدمی اُن لوگوں میں شامل ہو جو ایمان لائے اور جنہوں نے ایک دوسرے کو صبر اور (خلق خدا پر) رحم کی تلقین کی"
        },
        {
          "id": -2006040,
          "resource_id": 227,
          "text": "మరియు విశ్వసించి, సహనాన్ని బోధించేవారిలో! మరియు కరుణను ఒకరి కొకరు బోధించుకునే వారిలో చేరిపోవడం."
        }
      ]
    },
    {
      "id": 6041,
      "verse_number": 18,
      "verse_key": "90:18",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلْمَيْمَنَةِ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407744,
          "resource_id": 85,
          "text": "Those who do this will be on the right-hand side,"
        },
        {
          "id": 1550478,
          "resource_id": 831,
          "text": "Yeh log hain dayein baazu(right hand) waley"
        },
        {
          "id": -1006041,
          "resource_id": "ur.maududi",
          "text": "یہ لوگ ہیں دائیں بازو والے"
        },
        {
          "id": -2006041,
          "resource_id": 227,
          "text": "ఇలాంటి వారే కుడిపక్షం వారు."
        }
      ]
    },
    {
      "id": 6042,
      "verse_number": 19,
      "verse_key": "90:19",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَـٰتِنَا هُمْ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407745,
          "resource_id": 85,
          "text": "but those who disbelieve in Our revelations will be on the left-hand side,"
        },
        {
          "id": 1550479,
          "resource_id": 831,
          "text": "Aur jinhon ne hamari aayat ko mann-ney se inkar kiya woh bayen bazu(left hand) waley hain"
        },
        {
          "id": -1006042,
          "resource_id": "ur.maududi",
          "text": "اور جنہوں نے ہماری آیات کو ماننے سے انکار کیا وہ بائیں بازو والے ہیں"
        },
        {
          "id": -2006042,
          "resource_id": 227,
          "text": "ఇక మా సందేశాలను తిరస్కరించిన వారు, ఎడమ పక్షానికి చెందినవారు."
        }
      ]
    },
    {
      "id": 6043,
      "verse_number": 20,
      "verse_key": "90:20",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 534,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَلَيْهِمْ نَارٌ مُّؤْصَدَةٌۢ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407746,
          "resource_id": 85,
          "text": "and the Fire will close in on them."
        },
        {
          "id": 1550480,
          "resource_id": 831,
          "text": "Un par aag chaayi hui hogi"
        },
        {
          "id": -1006043,
          "resource_id": "ur.maududi",
          "text": "ان پر آگ چھائی ہوئی ہوگی"
        },
        {
          "id": -2006043,
          "resource_id": 227,
          "text": "వారిని నరకాగ్ని చుట్టుకుంటుంది."
        }
      ]
    }
  ]
}