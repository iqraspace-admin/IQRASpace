{
  "syncedAt": "2026-08-31T09:57:42.009Z",
  "chapter": {
    "id": 70,
    "revelation_place": "makkah",
    "revelation_order": 79,
    "bismillah_pre": true,
    "name_simple": "Al-Ma'arij",
    "name_complex": "Al-Ma`ārij",
    "name_arabic": "المعارج",
    "verses_count": 44,
    "pages": [
      568,
      570
    ],
    "translated_name": {
      "language_name": "english",
      "name": "The Ascending Stairways"
    }
  },
  "verses": [
    {
      "id": 5376,
      "verse_number": 1,
      "verse_key": "70:1",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " سَأَلَ سَآئِلٌۢ بِعَذَابٍ وَاقِعٍ",
      "page_number": 568,
      "juz_number": 29,
      "translations": [
        {
          "id": 407079,
          "resource_id": 85,
          "text": "A man [mockingly] demanded the punishment."
        },
        {
          "id": 1549813,
          "resource_id": 831,
          "text": "Mangne waley ne azaab maanga hai (woh azaab) jo zaroor waqey honay wala hai"
        },
        {
          "id": -1005376,
          "resource_id": "ur.maududi",
          "text": "مانگنے والے نے عذاب مانگا ہے، (وہ عذاب) جو ضرور واقع ہونے والا ہے"
        },
        {
          "id": -2005376,
          "resource_id": 227,
          "text": "ప్రశ్నించేవాడు, ఆ అనివార్యమైన శిక్షను గురించి ప్రశ్నించాడు;"
        }
      ]
    },
    {
      "id": 5377,
      "verse_number": 2,
      "verse_key": "70:2",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لِّلْكَـٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌ",
      "page_number": 568,
      "juz_number": 29,
      "translations": [
        {
          "id": 407080,
          "resource_id": 85,
          "text": "It will fall on the disbelievers––none can deflect it––"
        },
        {
          "id": 1549814,
          "resource_id": 831,
          "text": "Kafiron ke liye hai, koi usey dafa karne wala nahin"
        },
        {
          "id": -1005377,
          "resource_id": "ur.maududi",
          "text": "کافروں کے لیے ہے، کوئی اُسے دفع کرنے والا نہیں"
        },
        {
          "id": -2005377,
          "resource_id": 227,
          "text": "సత్యతిరస్కారులకు విధించబడే దాని గురించి; దానిని ఎవ్వడూ తొలగించలేడు."
        }
      ]
    },
    {
      "id": 5378,
      "verse_number": 3,
      "verse_key": "70:3",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ",
      "page_number": 568,
      "juz_number": 29,
      "translations": [
        {
          "id": 407081,
          "resource_id": 85,
          "text": "from God, the Lord of the Ways of Ascent,"
        },
        {
          "id": 1549815,
          "resource_id": 831,
          "text": "Us khuda ki taraf se hai jo urooj ke zeeno (ascending steps)ka malik hai"
        },
        {
          "id": -1005378,
          "resource_id": "ur.maududi",
          "text": "اُس خدا کی طرف سے ہے جو عروج کے زینوں کا مالک ہے"
        },
        {
          "id": -2005378,
          "resource_id": 227,
          "text": "అది ఆరోహణ మార్గాలకు యజమానుడైన అల్లాహ్ తరఫు నుండి వస్తుంది."
        }
      ]
    },
    {
      "id": 5379,
      "verse_number": 4,
      "verse_key": "70:4",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "تَعْرُجُ ٱلْمَلَـٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍ",
      "page_number": 568,
      "juz_number": 29,
      "translations": [
        {
          "id": 407082,
          "resource_id": 85,
          "text": "by which the angels and the Spirit ascend to Him, on a Day whose length is fifty thousand years."
        },
        {
          "id": 1549816,
          "resource_id": 831,
          "text": "Malaika (angels) aur rooh(Jibrael) uske huzoor chadh kar jatey hain ek aise din mein jiski miqdar pacchas (fifty) hazar saal hai"
        },
        {
          "id": -1005379,
          "resource_id": "ur.maududi",
          "text": "ملائکہ اور روح اُس کے حضور چڑھ کر جاتے ہیں ایک ایسے دن میں جس کی مقدار پچاس ہزار سال ہے"
        },
        {
          "id": -2005379,
          "resource_id": 227,
          "text": "యాభై వేల సంవత్సరాలకు సమానమైన (ప్రమాణం గల) ఒక రోజులో, దేవదూతలు మరియు ఆత్మ (జిబ్రీల్) ఆయన వద్దకు అధిరోహిస్తారు."
        }
      ]
    },
    {
      "id": 5380,
      "verse_number": 5,
      "verse_key": "70:5",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَٱصْبِرْ صَبْرًا جَمِيلًا",
      "page_number": 568,
      "juz_number": 29,
      "translations": [
        {
          "id": 407083,
          "resource_id": 85,
          "text": "So be patient, [Prophet], as befits you."
        },
        {
          "id": 1549817,
          "resource_id": 831,
          "text": "Pas aey Nabi, sabr karo, shaista sabr"
        },
        {
          "id": -1005380,
          "resource_id": "ur.maududi",
          "text": "پس اے نبیؐ، صبر کرو، شائستہ صبر"
        },
        {
          "id": -2005380,
          "resource_id": 227,
          "text": "కావున (ఓ ముహమ్మద్!) నీవు సహనం వహించు, ఉత్తమమైన సహనంతో!"
        }
      ]
    },
    {
      "id": 5381,
      "verse_number": 6,
      "verse_key": "70:6",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًا",
      "page_number": 568,
      "juz_number": 29,
      "translations": [
        {
          "id": 407084,
          "resource_id": 85,
          "text": "The disbelievers think it is distant,"
        },
        {
          "id": 1549818,
          "resource_id": 831,
          "text": "Yeh log usey dur samajhte hain"
        },
        {
          "id": -1005381,
          "resource_id": "ur.maududi",
          "text": "یہ لوگ اُسے دور سمجھتے ہیں"
        },
        {
          "id": -2005381,
          "resource_id": 227,
          "text": "వాస్తవానికి, వారు (ప్రజలు) అది (ఆ దినం) దూరంగా ఉందని అనుకుంటున్నారు."
        }
      ]
    },
    {
      "id": 5382,
      "verse_number": 7,
      "verse_key": "70:7",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَنَرَىٰهُ قَرِيبًا",
      "page_number": 568,
      "juz_number": 29,
      "translations": [
        {
          "id": 407085,
          "resource_id": 85,
          "text": "but We know it to be close."
        },
        {
          "id": 1549819,
          "resource_id": 831,
          "text": "Aur hum usey qareeb dekh rahey hain"
        },
        {
          "id": -1005382,
          "resource_id": "ur.maududi",
          "text": "اور ہم اسے قریب دیکھ رہے ہیں"
        },
        {
          "id": -2005382,
          "resource_id": 227,
          "text": "కాని మాకది అతి దగ్గరలో కనిపిస్తోంది."
        }
      ]
    },
    {
      "id": 5383,
      "verse_number": 8,
      "verse_key": "70:8",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ",
      "page_number": 568,
      "juz_number": 29,
      "translations": [
        {
          "id": 407086,
          "resource_id": 85,
          "text": "On a Day when the heavens will be like molten brass"
        },
        {
          "id": 1549820,
          "resource_id": 831,
          "text": "(woh azaab us roz hoga) jis roz aasman pigli huye chandi ki tarah ho jayega"
        },
        {
          "id": -1005383,
          "resource_id": "ur.maududi",
          "text": "(وہ عذاب اُس روز ہوگا) جس روز آسمان پگھلی ہوئی چاندی کی طرح ہو جائے گا"
        },
        {
          "id": -2005383,
          "resource_id": 227,
          "text": "ఆ రోజు ఆకాశం మరిగే సీసం వలే (నూనే వలే) అయి పోతుంది."
        }
      ]
    },
    {
      "id": 5384,
      "verse_number": 9,
      "verse_key": "70:9",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ",
      "page_number": 568,
      "juz_number": 29,
      "translations": [
        {
          "id": 407087,
          "resource_id": 85,
          "text": "and the mountains like tufts of wool,"
        },
        {
          "id": 1549821,
          "resource_id": 831,
          "text": "Aur pahad rang-bi-rang ke dhunke huey oon (wool) jaise ho jayenge"
        },
        {
          "id": -1005384,
          "resource_id": "ur.maududi",
          "text": "اور پہاڑ رنگ برنگ کے دھنکے ہوئے اون جیسے ہو جائیں گے"
        },
        {
          "id": -2005384,
          "resource_id": 227,
          "text": "మరియు కొండలు ఏకిన ఉన్ని వలె అయి పోతాయి."
        }
      ]
    },
    {
      "id": 5385,
      "verse_number": 10,
      "verse_key": "70:10",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًا",
      "page_number": 568,
      "juz_number": 29,
      "translations": [
        {
          "id": 407088,
          "resource_id": 85,
          "text": "when no friend will ask about his friend,"
        },
        {
          "id": 1549822,
          "resource_id": 831,
          "text": "Aur koi jigri dost apne jigri dost ko na puchega"
        },
        {
          "id": -1005385,
          "resource_id": "ur.maududi",
          "text": "اور کوئی جگری دوست اپنے جگری دوست کو نہ پوچھے گا"
        },
        {
          "id": -2005385,
          "resource_id": 227,
          "text": "మరియు ప్రాణ స్నేహితుడు కూడా తన స్నేహితుని (క్షేమాన్ని) అడగడు."
        }
      ]
    },
    {
      "id": 5386,
      "verse_number": 11,
      "verse_key": "70:11",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يُبَصَّرُونَهُمْ ۚ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407089,
          "resource_id": 85,
          "text": "even when they are within sight of one another. The guilty person will wish he could save himself from the suffering of that Day by sacrificing his sons,"
        },
        {
          "id": 1549823,
          "resource_id": 831,
          "text": "Halaanke woh ek dusre ko dikhaye jayenge, mujrim chahega ke us din ke azaab se bachne ke liye apni aulad ko"
        },
        {
          "id": -1005386,
          "resource_id": "ur.maududi",
          "text": "حالانکہ وہ ایک دوسرے کو دکھائے جائیں گے مجرم چاہے گا کہ اس دن کے عذاب سے بچنے کے لیے اپنی اولاد کو"
        },
        {
          "id": -2005386,
          "resource_id": 227,
          "text": "వారు ఒకరినొకరు చూసుకుంటూ ఉంటారు. ఆ రోజు అపరాధి తన సంతానాన్ని పరిహారంగా ఇచ్చి అయినా శిక్ష నుండి తప్పించుకోగోరుతాడు;"
        }
      ]
    },
    {
      "id": 5387,
      "verse_number": 12,
      "verse_key": "70:12",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَصَـٰحِبَتِهِۦ وَأَخِيهِ",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407090,
          "resource_id": 85,
          "text": "his spouse, his brother,"
        },
        {
          "id": 1549824,
          "resource_id": 831,
          "text": "Apni biwi ko, apne bhai ko"
        },
        {
          "id": -1005387,
          "resource_id": "ur.maududi",
          "text": "اپنی بیوی کو، اپنے بھائی کو"
        },
        {
          "id": -2005387,
          "resource_id": 227,
          "text": "మరియు తన సహవాసిని మరియు తన సోదరుణ్ణి;"
        }
      ]
    },
    {
      "id": 5388,
      "verse_number": 13,
      "verse_key": "70:13",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407091,
          "resource_id": 85,
          "text": "the kinsfolk who gave him shelter,"
        },
        {
          "id": 1549825,
          "resource_id": 831,
          "text": "Apne qareeb-tareen khandaan ko jo usey panaah dene wala tha"
        },
        {
          "id": -1005388,
          "resource_id": "ur.maududi",
          "text": "اپنے قریب ترین خاندان کو جو اسے پناہ دینے والا تھا"
        },
        {
          "id": -2005388,
          "resource_id": 227,
          "text": "మరియు తనకు ఆశ్రయమిచ్చిన దగ్గరి బంధువులను;"
        }
      ]
    },
    {
      "id": 5389,
      "verse_number": 14,
      "verse_key": "70:14",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَن فِى ٱلْأَرْضِ جَمِيعًا ثُمَّ يُنجِيهِ",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407092,
          "resource_id": 85,
          "text": "and everyone on earth, if it could save him."
        },
        {
          "id": 1549826,
          "resource_id": 831,
          "text": "Aur rooh-e-zameen ke sab logon ko fidiya (badle) mein dey-de aur yeh tadbeer usey nijaat dila de"
        },
        {
          "id": -1005389,
          "resource_id": "ur.maududi",
          "text": "اور روئے زمین کے سب لوگوں کو فدیہ میں دیدے اور یہ تدبیر اُسے نجات دلا دے"
        },
        {
          "id": -2005389,
          "resource_id": 227,
          "text": "మరియు భూమిలో ఉన్న వారినందరినీ కూడా ఇచ్చి అయినా, తాను విముక్తి పొందాలని కోరుతాడు."
        }
      ]
    },
    {
      "id": 5390,
      "verse_number": 15,
      "verse_key": "70:15",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّآ ۖ إِنَّهَا لَظَىٰ",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407093,
          "resource_id": 85,
          "text": "But no! There is a raging flame"
        },
        {
          "id": 1549827,
          "resource_id": 831,
          "text": "Hargiz nahin woh to bhadakti hui aag ki lapat hogi"
        },
        {
          "id": -1005390,
          "resource_id": "ur.maududi",
          "text": "ہرگز نہیں وہ تو بھڑکتی ہوئی آگ کی لپٹ ہوگی"
        },
        {
          "id": -2005390,
          "resource_id": 227,
          "text": "కాని అలా కానేరదు! నిశ్చయంగా, ఆ మండే అగ్నిజ్వాల (అతని కొరకు వేచి ఉంటుంది)!"
        }
      ]
    },
    {
      "id": 5391,
      "verse_number": 16,
      "verse_key": "70:16",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "نَزَّاعَةً لِّلشَّوَىٰ",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407094,
          "resource_id": 85,
          "text": "that strips away the skin,"
        },
        {
          "id": 1549828,
          "resource_id": 831,
          "text": "Jo gosht posht ko chaat jayegi"
        },
        {
          "id": -1005391,
          "resource_id": "ur.maududi",
          "text": "جو گوشت پوست کو چاٹ جائے گی"
        },
        {
          "id": -2005391,
          "resource_id": 227,
          "text": "అది అతని చర్మాన్ని పూర్తిగా వలచి కాల్చి వేస్తుంది."
        }
      ]
    },
    {
      "id": 5392,
      "verse_number": 17,
      "verse_key": "70:17",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407095,
          "resource_id": 85,
          "text": "and it will claim everyone who rejects the truth, turns away,"
        },
        {
          "id": 1549829,
          "resource_id": 831,
          "text": "Pukar pukar kar apni taraf bulayegi har us shaks ko jisne haqq se mooh moda aur peet pheri"
        },
        {
          "id": -1005392,
          "resource_id": "ur.maududi",
          "text": "پکار پکار کر اپنی طرف بلائے گی ہر اُس شخص کو جس نے حق سے منہ موڑا اور پیٹھ پھیری"
        },
        {
          "id": -2005392,
          "resource_id": 227,
          "text": "అది (సత్యం నుండి) వెనుదిరిగి మరియు వెన్ను చూపి, పోయేవారిని (అందరినీ) పిలుస్తుంది."
        }
      ]
    },
    {
      "id": 5393,
      "verse_number": 18,
      "verse_key": "70:18",
      "hizb_number": 57,
      "rub_el_hizb_number": 227,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَجَمَعَ فَأَوْعَىٰٓ",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407096,
          "resource_id": 85,
          "text": "amasses wealth and hoards it."
        },
        {
          "id": 1549830,
          "resource_id": 831,
          "text": "Aur maal jamaa kiya aur seint seint kar (amassed wealth) rakkha"
        },
        {
          "id": -1005393,
          "resource_id": "ur.maududi",
          "text": "اور مال جمع کیا اور سینت سینت کر رکھا"
        },
        {
          "id": -2005393,
          "resource_id": 227,
          "text": "మరియు (ధనాన్ని) కూడబెట్టి, దానిని దాచేవారిని."
        }
      ]
    },
    {
      "id": 5394,
      "verse_number": 19,
      "verse_key": "70:19",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "۞ إِنَّ ٱلْإِنسَـٰنَ خُلِقَ هَلُوعًا",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407097,
          "resource_id": 85,
          "text": "Man was truly created anxious:"
        },
        {
          "id": 1549831,
          "resource_id": 831,
          "text": "Insan thud-dila (impatient) paida kiya gaya hai"
        },
        {
          "id": -1005394,
          "resource_id": "ur.maududi",
          "text": "انسان تھڑدلا پیدا کیا گیا ہے"
        },
        {
          "id": -2005394,
          "resource_id": 227,
          "text": "నిశ్చయంగా, మానవుడు ఆత్రగాడుగా (తొందరపడేవాడిగా) సృష్టించబడ్డాడు;"
        }
      ]
    },
    {
      "id": 5395,
      "verse_number": 20,
      "verse_key": "70:20",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًا",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407098,
          "resource_id": 85,
          "text": "he is fretful when misfortune touches him,"
        },
        {
          "id": 1549832,
          "resource_id": 831,
          "text": "Jab uspar museebat aati hai to ghabra uthta hai"
        },
        {
          "id": -1005395,
          "resource_id": "ur.maududi",
          "text": "جب اس پر مصیبت آتی ہے تو گھبرا اٹھتا ہے"
        },
        {
          "id": -2005395,
          "resource_id": 227,
          "text": "తనకు కీడు కలిగినప్పుడు వాడు ఆందోళన చెందుతాడు;"
        }
      ]
    },
    {
      "id": 5396,
      "verse_number": 21,
      "verse_key": "70:21",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407099,
          "resource_id": 85,
          "text": "but tight-fisted when good fortune comes his way."
        },
        {
          "id": 1549833,
          "resource_id": 831,
          "text": "Aur jab usey khush-haali naseeb hoti hai to bukhl (kanjoosi) karne lagta hai"
        },
        {
          "id": -1005396,
          "resource_id": "ur.maududi",
          "text": "اور جب اسے خوشحالی نصیب ہوتی ہے تو بخل کرنے لگتا ہے"
        },
        {
          "id": -2005396,
          "resource_id": 227,
          "text": "మరియు తనకు మేలు కలిగినపుడు స్వార్థపరునిగా ప్రవర్తిస్తాడు."
        }
      ]
    },
    {
      "id": 5397,
      "verse_number": 22,
      "verse_key": "70:22",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِلَّا ٱلْمُصَلِّينَ",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407100,
          "resource_id": 85,
          "text": "Not so those who pray"
        },
        {
          "id": 1549834,
          "resource_id": 831,
          "text": "Magar woh log (is aib se bache huey hai) jo namaz padne waley hain"
        },
        {
          "id": -1005397,
          "resource_id": "ur.maududi",
          "text": "مگر وہ لوگ (اِس عیب سے بچے ہوئے ہیں) جو نماز پڑھنے والے ہیں"
        },
        {
          "id": -2005397,
          "resource_id": 227,
          "text": "నమాజ్ ను ఖచ్ఛితంగా పాఠించేవారు తప్ప!"
        }
      ]
    },
    {
      "id": 5398,
      "verse_number": 23,
      "verse_key": "70:23",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407101,
          "resource_id": 85,
          "text": "and are constant in their prayers;"
        },
        {
          "id": 1549835,
          "resource_id": 831,
          "text": "Jo apni namaz ki hamesha pabandi karte hai"
        },
        {
          "id": -1005398,
          "resource_id": "ur.maududi",
          "text": "جو اپنی نماز کی ہمیشہ پابندی کرتے ہیں"
        },
        {
          "id": -2005398,
          "resource_id": 227,
          "text": "ఎవరైతే తమ నమాజ్ ను సదా నియమంతో పాటిస్తారో;"
        }
      ]
    },
    {
      "id": 5399,
      "verse_number": 24,
      "verse_key": "70:24",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّ مَّعْلُومٌ",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407102,
          "resource_id": 85,
          "text": "who give a due share of their wealth"
        },
        {
          "id": 1549836,
          "resource_id": 831,
          "text": "Jinke maalon mein"
        },
        {
          "id": -1005399,
          "resource_id": "ur.maududi",
          "text": "جن کے مالوں میں،"
        },
        {
          "id": -2005399,
          "resource_id": 227,
          "text": "మరియు అలాంటి వారు, ఎవరైతే తమ సంపదలలో (ఇతరులకు) ఉన్న హక్కును సమ్మతిస్తారో!"
        }
      ]
    },
    {
      "id": 5400,
      "verse_number": 25,
      "verse_key": "70:25",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لِّلسَّآئِلِ وَٱلْمَحْرُومِ",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407103,
          "resource_id": 85,
          "text": "to beggars and the deprived;"
        },
        {
          "id": 1549837,
          "resource_id": 831,
          "text": "Saahil (maangne waley) aur mehroom ka ek haqq mukarrar hai"
        },
        {
          "id": -1005400,
          "resource_id": "ur.maududi",
          "text": "سائل اور محروم کا ایک حق مقرر ہے"
        },
        {
          "id": -2005400,
          "resource_id": 227,
          "text": "యాచకులకు మరియు లేమికి గురి అయిన వారికి;"
        }
      ]
    },
    {
      "id": 5401,
      "verse_number": 26,
      "verse_key": "70:26",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407104,
          "resource_id": 85,
          "text": "who believe in the Day of Judgement"
        },
        {
          "id": 1549838,
          "resource_id": 831,
          "text": "Jo roz-e-jaza ko barhaq maante hain"
        },
        {
          "id": -1005401,
          "resource_id": "ur.maududi",
          "text": "جو روز جزا کو برحق مانتے ہیں"
        },
        {
          "id": -2005401,
          "resource_id": 227,
          "text": "మరియు అలాంటి వారికి, ఎవరైతే తీర్పుదినాన్ని సత్యమని నమ్ముతారో;"
        }
      ]
    },
    {
      "id": 5402,
      "verse_number": 27,
      "verse_key": "70:27",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407105,
          "resource_id": 85,
          "text": "and fear the punishment of their Lord––"
        },
        {
          "id": 1549839,
          "resource_id": 831,
          "text": "Jo apne Rubb ke azaab se darte hain"
        },
        {
          "id": -1005402,
          "resource_id": "ur.maududi",
          "text": "جو اپنے رب کے عذاب سے ڈرتے ہیں"
        },
        {
          "id": -2005402,
          "resource_id": 227,
          "text": "మరియు ఎవరైతే తమ ప్రభువు శిక్షకు భయపడుతారో!"
        }
      ]
    },
    {
      "id": 5403,
      "verse_number": 28,
      "verse_key": "70:28",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍ",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407106,
          "resource_id": 85,
          "text": "none may feel wholly secure from it––"
        },
        {
          "id": 1549840,
          "resource_id": 831,
          "text": "Kyunke unke Rubb ka azaab aisi cheez nahin hai jissey koi bekhauf ho"
        },
        {
          "id": -1005403,
          "resource_id": "ur.maududi",
          "text": "کیونکہ اُن کے رب کا عذاب ایسی چیز نہیں ہے جس سے کوئی بے خوف ہو"
        },
        {
          "id": -2005403,
          "resource_id": 227,
          "text": "నిశ్చయంగా, వారి ప్రభువు యొక్క ఆ శిక్ష; దాని పట్ల ఎవ్వరూ నిర్భయంగా ఉండలేరు!"
        }
      ]
    },
    {
      "id": 5404,
      "verse_number": 29,
      "verse_key": "70:29",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَـٰفِظُونَ",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407107,
          "resource_id": 85,
          "text": "who guard their chastity"
        },
        {
          "id": 1549841,
          "resource_id": 831,
          "text": "Jo apni sharmgahon ki hifazat karte hain"
        },
        {
          "id": -1005404,
          "resource_id": "ur.maududi",
          "text": "جو اپنی شرمگاہوں کی حفاظت کرتے ہیں"
        },
        {
          "id": -2005404,
          "resource_id": 227,
          "text": "మరియు ఎవరైతే, తమ మర్మాంగాలను కాపాడుకుంటారో -"
        }
      ]
    },
    {
      "id": 5405,
      "verse_number": 30,
      "verse_key": "70:30",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَـٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407108,
          "resource_id": 85,
          "text": "from all but their spouses or their slave-girls––there is no blame attached to [relations with] these,"
        },
        {
          "id": 1549842,
          "resource_id": 831,
          "text": "Ba-juz apne biwiyon ya apni mamluka aurton ke jinse mehfooz na rakhne mein unpar koi malamat nahin"
        },
        {
          "id": -1005405,
          "resource_id": "ur.maududi",
          "text": "بجز اپنی بیویوں یا اپنی مملوکہ عورتوں کے جن سے محفوظ نہ رکھنے میں ان پر کوئی ملامت نہیں"
        },
        {
          "id": -2005405,
          "resource_id": 227,
          "text": "తమ భార్యలు (అజ్వాజ్), లేదా ధర్మసమ్మతంగా తమ ఆధీనంలో ఉన్న (బానిస) స్త్రీలతో తప్ప - అలాంటప్పుడు వారు నిందార్హులు కారు."
        }
      ]
    },
    {
      "id": 5406,
      "verse_number": 31,
      "verse_key": "70:31",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَـٰٓئِكَ هُمُ ٱلْعَادُونَ",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407109,
          "resource_id": 85,
          "text": "but those whose desires exceed this limit are truly transgressors––"
        },
        {
          "id": 1549843,
          "resource_id": 831,
          "text": "Albatta jo iske alawa kuch aur chahein wahi hadd se tajawuz karne wala hai"
        },
        {
          "id": -1005406,
          "resource_id": "ur.maududi",
          "text": "البتہ جو اس کے علاوہ کچھ اور چاہیں وہی حد سے تجاوز کرنے والے ہیں"
        },
        {
          "id": -2005406,
          "resource_id": 227,
          "text": "కాని ఎవరైతే వీటిని మించి పోగోరుతారో, అలాంటివారే మితిమీరి పోయేవారు."
        }
      ]
    },
    {
      "id": 5407,
      "verse_number": 32,
      "verse_key": "70:32",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّذِينَ هُمْ لِأَمَـٰنَـٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407110,
          "resource_id": 85,
          "text": "who are faithful to their trusts and their pledges;"
        },
        {
          "id": 1549844,
          "resource_id": 831,
          "text": "Jo apne amanaton ki hifazat aur apne ahad (covenant) ka paas karte hai"
        },
        {
          "id": -1005407,
          "resource_id": "ur.maududi",
          "text": "جو اپنی امانتوں کی حفاظت اور اپنے عہد کا پاس کرتے ہیں"
        },
        {
          "id": -2005407,
          "resource_id": 227,
          "text": "మరియు ఎవరైతే తమ అమానతులను మరియు తమ వాగ్దానాలను కాపాడుకుంటారో;"
        }
      ]
    },
    {
      "id": 5408,
      "verse_number": 33,
      "verse_key": "70:33",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّذِينَ هُم بِشَهَـٰدَٰتِهِمْ قَآئِمُونَ",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407111,
          "resource_id": 85,
          "text": "who give honest testimony"
        },
        {
          "id": 1549845,
          "resource_id": 831,
          "text": "Jo apni gawahiyon mein raast baazi (upright) par qayam rehte hain"
        },
        {
          "id": -1005408,
          "resource_id": "ur.maududi",
          "text": "جو اپنی گواہیوں میں راست بازی پر قائم رہتے ہیں"
        },
        {
          "id": -2005408,
          "resource_id": 227,
          "text": "మరియు ఎవరైతే తమ సాక్ష్యాల మీద స్థిరంగా ఉంటారో;"
        }
      ]
    },
    {
      "id": 5409,
      "verse_number": 34,
      "verse_key": "70:34",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407112,
          "resource_id": 85,
          "text": "and are steadfast in their prayers."
        },
        {
          "id": 1549846,
          "resource_id": 831,
          "text": "Aur jo apni namaz ki hifazat karte hain"
        },
        {
          "id": -1005409,
          "resource_id": "ur.maududi",
          "text": "اور جو اپنی نماز کی حفاظت کرتے ہیں"
        },
        {
          "id": -2005409,
          "resource_id": 227,
          "text": "మరియు ఎవరైతే తమ నమాజులను కాపాడుకుంటారో;"
        }
      ]
    },
    {
      "id": 5410,
      "verse_number": 35,
      "verse_key": "70:35",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 504,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أُو۟لَـٰٓئِكَ فِى جَنَّـٰتٍ مُّكْرَمُونَ",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407113,
          "resource_id": 85,
          "text": "They will be honoured in Gardens of bliss."
        },
        {
          "id": 1549847,
          "resource_id": 831,
          "text": "Yeh log izzat ke saath jannat ke baaghon mei rahenge"
        },
        {
          "id": -1005410,
          "resource_id": "ur.maududi",
          "text": "یہ لوگ عزت کے ساتھ جنت کے باغوں میں رہیں گے"
        },
        {
          "id": -2005410,
          "resource_id": 227,
          "text": "ఇలాంటి వారంతా సగౌరవంగా స్వర్గవనాలలో ఉంటారు."
        }
      ]
    },
    {
      "id": 5411,
      "verse_number": 36,
      "verse_key": "70:36",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 505,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَمَالِ ٱلَّذِينَ كَفَرُوا۟ قِبَلَكَ مُهْطِعِينَ",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407114,
          "resource_id": 85,
          "text": "What is wrong with the disbelievers? Why do they rush to peer at you [Prophet],"
        },
        {
          "id": 1549848,
          "resource_id": 831,
          "text": "Pas aey Nabi , kya baat hai ke yeh munkirin dayein(left) aur bayein(right) se"
        },
        {
          "id": -1005411,
          "resource_id": "ur.maududi",
          "text": "پس اے نبیؐ، کیا بات ہے کہ یہ منکرین دائیں اور بائیں سے،"
        },
        {
          "id": -2005411,
          "resource_id": 227,
          "text": "ఈ సత్యతిరస్కారులకు ఏమయ్యింది? వీరెందుకు హడావిడిగా, నీ ముందు ఇటూ అటూ తిరుగుతున్నారు?"
        }
      ]
    },
    {
      "id": 5412,
      "verse_number": 37,
      "verse_key": "70:37",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 505,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407115,
          "resource_id": 85,
          "text": "from right and left, in crowds?"
        },
        {
          "id": 1549849,
          "resource_id": 831,
          "text": "Giroh (crowds) dar giroh(crowds) tumhari taraf daude chale aa rahe hain"
        },
        {
          "id": -1005412,
          "resource_id": "ur.maududi",
          "text": "گروہ در گروہ تمہاری طرف دوڑے چلے آ رہے ہیں؟"
        },
        {
          "id": -2005412,
          "resource_id": 227,
          "text": "కుడి ప్రక్క నుండి మరియు ఎడమ ప్రక్క నుండి గుంపులుగా;"
        }
      ]
    },
    {
      "id": 5413,
      "verse_number": 38,
      "verse_key": "70:38",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 505,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَيَطْمَعُ كُلُّ ٱمْرِئٍ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍ",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407116,
          "resource_id": 85,
          "text": "Does every one of them expect to enter a Garden of bliss?"
        },
        {
          "id": 1549850,
          "resource_id": 831,
          "text": "Kya inmein se har ek yeh lalaj rakhta hai ke woh niyamat bhari jannat mein daakhil kardiya jayega"
        },
        {
          "id": -1005413,
          "resource_id": "ur.maududi",
          "text": "کیا اِن میں سے ہر ایک یہ لالچ رکھتا ہے کہ وہ نعمت بھری جنت میں داخل کر دیا جائے گا؟"
        },
        {
          "id": -2005413,
          "resource_id": 227,
          "text": "ఏమీ? వారిలో ప్రతి ఒక్కడూ, తాను పరమ సుఖాలు గల స్వర్గవనంలో ప్రవేశింప జేయబడతానని ఆశిస్తున్నాడా?"
        }
      ]
    },
    {
      "id": 5414,
      "verse_number": 39,
      "verse_key": "70:39",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 505,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّآ ۖ إِنَّا خَلَقْنَـٰهُم مِّمَّا يَعْلَمُونَ",
      "page_number": 569,
      "juz_number": 29,
      "translations": [
        {
          "id": 407117,
          "resource_id": 85,
          "text": "No! We created them from the substance they know,"
        },
        {
          "id": 1549851,
          "resource_id": 831,
          "text": "Hargiz nahin humne jis cheez se inko paida kiya hai usey yeh khud jaante hain"
        },
        {
          "id": -1005414,
          "resource_id": "ur.maududi",
          "text": "ہرگز نہیں ہم نے جس چیز سے اِن کو پیدا کیا ہے اُسے یہ خود جانتے ہیں"
        },
        {
          "id": -2005414,
          "resource_id": 227,
          "text": "అలా కానేరదు! నిశ్చయంగా, మేము వారిని దేనితో పుట్టించామో వారికి బాగా తెలుసు!"
        }
      ]
    },
    {
      "id": 5415,
      "verse_number": 40,
      "verse_key": "70:40",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 505,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَلَآ أُقْسِمُ بِرَبِّ ٱلْمَشَـٰرِقِ وَٱلْمَغَـٰرِبِ إِنَّا لَقَـٰدِرُونَ",
      "page_number": 570,
      "juz_number": 29,
      "translations": [
        {
          "id": 407118,
          "resource_id": 85,
          "text": "and, by the Lord of every sunrise and sunset, We have the power"
        },
        {
          "id": 1549852,
          "resource_id": 831,
          "text": "Pas nahin, main qasam khata hoon mashrikon aur maghribon ke maalik ki hum ispar qadir hain"
        },
        {
          "id": -1005415,
          "resource_id": "ur.maududi",
          "text": "پس نہیں، میں قسم کھاتا ہوں مشرقوں اور مغربوں کے مالک کی، ہم اِس پر قادر ہیں"
        },
        {
          "id": -2005415,
          "resource_id": 227,
          "text": "కావున! నేను తూర్పుల మరియు పడమరల ప్రభువు శపథం చేసి చెబుతున్నాను. నిశ్చయంగా, మేము అలా చేయగల సమర్థులము;"
        }
      ]
    },
    {
      "id": 5416,
      "verse_number": 41,
      "verse_key": "70:41",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 505,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَلَىٰٓ أَن نُّبَدِّلَ خَيْرًا مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَ",
      "page_number": 570,
      "juz_number": 29,
      "translations": [
        {
          "id": 407119,
          "resource_id": 85,
          "text": "to substitute for them others better than they are- nothing can prevent Us from doing this."
        },
        {
          "id": 1549853,
          "resource_id": 831,
          "text": "Ke inki jagah insey behtar log le aayein aur koi humse baazi le jaane wala nahin hai"
        },
        {
          "id": -1005416,
          "resource_id": "ur.maududi",
          "text": "کہ اِن کی جگہ اِن سے بہتر لوگ لے آئیں اور کوئی ہم سے بازی لے جانے والا نہیں ہے"
        },
        {
          "id": -2005416,
          "resource_id": 227,
          "text": "వారికి బదులుగా వారి కంటే ఉత్తమమైన వారిని వారి స్థానంలో తీసుకురావటానికి; మరియు మమ్మల్ని మించి పోయేవారు ఎవ్వరూ లేరు."
        }
      ]
    },
    {
      "id": 5417,
      "verse_number": 42,
      "verse_key": "70:42",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 505,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَذَرْهُمْ يَخُوضُوا۟ وَيَلْعَبُوا۟ حَتَّىٰ يُلَـٰقُوا۟ يَوْمَهُمُ ٱلَّذِى يُوعَدُونَ",
      "page_number": 570,
      "juz_number": 29,
      "translations": [
        {
          "id": 407120,
          "resource_id": 85,
          "text": "So leave them to wallow in idle talk, until they come face to face with their promised Day,"
        },
        {
          "id": 1549854,
          "resource_id": 831,
          "text": "Lihaza inhein apni behuda baaton aur apne khel mein pada rehne do yahan tak ke yeh apne us din ko pahunch jayenge jiska insey waada kiya ja raha hai"
        },
        {
          "id": -1005417,
          "resource_id": "ur.maududi",
          "text": "لہٰذا اِنہیں اپنی بیہودہ باتوں اور اپنے کھیل میں پڑا رہنے دو یہاں تک کہ یہ اپنے اُس دن تک پہنچ جائیں جس کا ان سے وعدہ کیا جا رہا ہے"
        },
        {
          "id": -2005417,
          "resource_id": 227,
          "text": "కావున వారిని - వారితో వాగ్దానం చేయబడిన ఆ దినానికి చేరే వరకు - వ్యర్థపు మాటలలో మరియు విలాస వినోదాల్లో విడిచిపెట్టు."
        }
      ]
    },
    {
      "id": 5418,
      "verse_number": 43,
      "verse_key": "70:43",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 505,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَوْمَ يَخْرُجُونَ مِنَ ٱلْأَجْدَاثِ سِرَاعًا كَأَنَّهُمْ إِلَىٰ نُصُبٍ يُوفِضُونَ",
      "page_number": 570,
      "juz_number": 29,
      "translations": [
        {
          "id": 407121,
          "resource_id": 85,
          "text": "the Day they will rush out of their graves as if rallying to a flag,"
        },
        {
          "id": 1549855,
          "resource_id": 831,
          "text": "Jab yeh apni qabron se nikal kar is tarah daude ja rahey hongey jaise apne buthon (idols) ke aasthano (altars) ki taraf daud rahey hon"
        },
        {
          "id": -1005418,
          "resource_id": "ur.maududi",
          "text": "جب یہ اپنی قبروں سے نکل کر اِس طرح دوڑے جا رہے ہوں گے جیسے اپنے بتوں کے استھانوں کی طرف دوڑ رہے ہوں"
        },
        {
          "id": -2005418,
          "resource_id": 227,
          "text": "ఆ రోజు వారు తమ సమాధుల నుండి లేచి, తమ గమ్యస్థానాలకు చేరుకోవటానికి తొందర పడుతూ వేగంగా బయటికి వస్తారు."
        }
      ]
    },
    {
      "id": 5419,
      "verse_number": 44,
      "verse_key": "70:44",
      "hizb_number": 57,
      "rub_el_hizb_number": 228,
      "ruku_number": 505,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "خَـٰشِعَةً أَبْصَـٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌ ۚ ذَٰلِكَ ٱلْيَوْمُ ٱلَّذِى كَانُوا۟ يُوعَدُونَ",
      "page_number": 570,
      "juz_number": 29,
      "translations": [
        {
          "id": 407122,
          "resource_id": 85,
          "text": "eyes downcast and covered in shame: that is the Day of which they were warned."
        },
        {
          "id": 1549856,
          "resource_id": 831,
          "text": "Inki nigahein jhuki hui hongi, zillat inpar chaa rahi hogi, woh din hai jiska insey wada kiya ja raha hai"
        },
        {
          "id": -1005419,
          "resource_id": "ur.maududi",
          "text": "اِن کی نگاہیں جھکی ہوئی ہوں گی، ذلت اِن پر چھا رہی ہوگی وہ دن ہے جس کا اِن سے وعدہ کیا جا رہا ہے"
        },
        {
          "id": -2005419,
          "resource_id": 227,
          "text": "వారి చూపులు క్రిందికి వాలి ఉంటాయి, అవమానం వారిని క్రమ్ముకొని ఉంటుంది. అదే వారికి వాగ్దానం చేయబడిన దినం!"
        }
      ]
    }
  ]
}