{
  "syncedAt": "2026-08-31T09:57:49.266Z",
  "chapter": {
    "id": 86,
    "revelation_place": "makkah",
    "revelation_order": 36,
    "bismillah_pre": true,
    "name_simple": "At-Tariq",
    "name_complex": "Aţ-Ţāriq",
    "name_arabic": "الطارق",
    "verses_count": 17,
    "pages": [
      591,
      591
    ],
    "translated_name": {
      "language_name": "english",
      "name": "The Nightcommer"
    }
  },
  "verses": [
    {
      "id": 5932,
      "verse_number": 1,
      "verse_key": "86:1",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 530,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " وَٱلسَّمَآءِ وَٱلطَّارِقِ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407635,
          "resource_id": 85,
          "text": "By the sky and the night-comer––"
        },
        {
          "id": 1550369,
          "resource_id": 831,
          "text": "Kasam hai aasmaan ki aur raat ko namudaar honay wale ki"
        },
        {
          "id": -1005932,
          "resource_id": "ur.maududi",
          "text": "قسم ہے آسمان کی اور رات کو نمودار ہونے والے کی"
        },
        {
          "id": -2005932,
          "resource_id": 227,
          "text": "ఆకాశం మరియు రాత్రివేళ వచ్చే నక్షత్రం (అత్ తారిఖ్) సాక్షిగా!"
        }
      ]
    },
    {
      "id": 5933,
      "verse_number": 2,
      "verse_key": "86:2",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 530,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407636,
          "resource_id": 85,
          "text": "What will explain to you what the night-comer is?"
        },
        {
          "id": 1550370,
          "resource_id": 831,
          "text": "Aur tum kya jaano kay woh raat ko namudaar honay wala kya hai"
        },
        {
          "id": -1005933,
          "resource_id": "ur.maududi",
          "text": "اور تم کیا جانو کہ وہ رات کو نمودار ہونے والا کیا ہے؟"
        },
        {
          "id": -2005933,
          "resource_id": 227,
          "text": "రాత్రి వేళ వచ్చేది (అత్ తారిఖ్) అంటే ఏమిటో నీకు ఎలా తెలుస్తుంది?"
        }
      ]
    },
    {
      "id": 5934,
      "verse_number": 3,
      "verse_key": "86:3",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 530,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلنَّجْمُ ٱلثَّاقِبُ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407637,
          "resource_id": 85,
          "text": "The piercing star––"
        },
        {
          "id": 1550371,
          "resource_id": 831,
          "text": "Chamakta hua tara"
        },
        {
          "id": -1005934,
          "resource_id": "ur.maududi",
          "text": "چمکتا ہوا تارا"
        },
        {
          "id": -2005934,
          "resource_id": 227,
          "text": "అదొక అత్యంత ప్రకాశవంతమైన నక్షత్రం."
        }
      ]
    },
    {
      "id": 5935,
      "verse_number": 4,
      "verse_key": "86:4",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 530,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407638,
          "resource_id": 85,
          "text": "there is a watcher over every soul."
        },
        {
          "id": 1550372,
          "resource_id": 831,
          "text": "koi jaan aisi nahin hai jiske upar koi nigehbaan na ho"
        },
        {
          "id": -1005935,
          "resource_id": "ur.maududi",
          "text": "کوئی جان ایسی نہیں ہے جس کے اوپر کوئی نگہبان نہ ہو"
        },
        {
          "id": -2005935,
          "resource_id": 227,
          "text": "కనిపెట్టుకొని ఉండేవాడు (దేవదూత) లేకుండా ఏ వ్యక్తి కూడా లేడు."
        }
      ]
    },
    {
      "id": 5936,
      "verse_number": 5,
      "verse_key": "86:5",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 530,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407639,
          "resource_id": 85,
          "text": "Man should reflect on what he was created from."
        },
        {
          "id": 1550373,
          "resource_id": 831,
          "text": "Phir zara Insan yahi dekh le ke woh kis cheez se paida kiya gaya hai"
        },
        {
          "id": -1005936,
          "resource_id": "ur.maududi",
          "text": "پھر ذرا انسان یہی دیکھ لے کہ وہ کس چیز سے پیدا کیا گیا ہے"
        },
        {
          "id": -2005936,
          "resource_id": 227,
          "text": "కావున మానవుడు తాను దేనితో సృష్టించబడ్డాడో గమనించాలి!"
        }
      ]
    },
    {
      "id": 5937,
      "verse_number": 6,
      "verse_key": "86:6",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 530,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "خُلِقَ مِن مَّآءٍ دَافِقٍ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407640,
          "resource_id": 85,
          "text": "He is created from spurting fluid,"
        },
        {
          "id": 1550374,
          "resource_id": 831,
          "text": "Ek uchalne wale pani se paida kiya gaya hai"
        },
        {
          "id": -1005937,
          "resource_id": "ur.maududi",
          "text": "ایک اچھلنے والے پانی سے پیدا کیا گیا ہے"
        },
        {
          "id": -2005937,
          "resource_id": 227,
          "text": "అతడు విసర్జించబడే (చిమ్ముకుంటూ వెలువడే) ద్రవపదార్థంతో సృష్టించబడ్డాడు."
        }
      ]
    },
    {
      "id": 5938,
      "verse_number": 7,
      "verse_key": "86:7",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 530,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407641,
          "resource_id": 85,
          "text": "then he emerges from between the backbone and breastbone:"
        },
        {
          "id": 1550375,
          "resource_id": 831,
          "text": "Jo peet aur seeney ki haddiyon kay darmiyan se nikalta hai"
        },
        {
          "id": -1005938,
          "resource_id": "ur.maududi",
          "text": "جو پیٹھ اور سینے کی ہڈیوں کے درمیان سے نکلتا ہے"
        },
        {
          "id": -2005938,
          "resource_id": 227,
          "text": "అది వెన్ను మరియు రొమ్ము ఎముకల మధ్యభాగం నుండి బయటికి వస్తుంది."
        }
      ]
    },
    {
      "id": 5939,
      "verse_number": 8,
      "verse_key": "86:8",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 530,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407642,
          "resource_id": 85,
          "text": "God is certainly able to bring him back to life."
        },
        {
          "id": 1550376,
          "resource_id": 831,
          "text": "Yaqeenan woh (khaliq) usey dobara paida karne par qadir hai"
        },
        {
          "id": -1005939,
          "resource_id": "ur.maududi",
          "text": "یقیناً وہ (خالق) اُسے دوبارہ پیدا کرنے پر قادر ہے"
        },
        {
          "id": -2005939,
          "resource_id": 227,
          "text": "నిశ్చయంగా, ఆయన (సృష్టికర్త), అతనిని మరల బ్రతికించి తేగల సామర్థ్యం గలవాడు!"
        }
      ]
    },
    {
      "id": 5940,
      "verse_number": 9,
      "verse_key": "86:9",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 530,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407643,
          "resource_id": 85,
          "text": "On the Day when secrets are laid bare"
        },
        {
          "id": 1550377,
          "resource_id": 831,
          "text": "Jis roz poshida asraar ki jaanch padtal hogi"
        },
        {
          "id": -1005940,
          "resource_id": "ur.maududi",
          "text": "جس روز پوشیدہ اسرار کی جانچ پڑتال ہوگی"
        },
        {
          "id": -2005940,
          "resource_id": 227,
          "text": "ఏ రోజయితే రహస్య విషయాల విచారణ జరుగుతుందో!"
        }
      ]
    },
    {
      "id": 5941,
      "verse_number": 10,
      "verse_key": "86:10",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 530,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407644,
          "resource_id": 85,
          "text": "he will have no power and no one to help him."
        },
        {
          "id": 1550378,
          "resource_id": 831,
          "text": "Us waqt Insan ke paas na khud apna koi zoar hoga aur na koi uski madad karne wala hoga"
        },
        {
          "id": -1005941,
          "resource_id": "ur.maududi",
          "text": "اُس وقت انسان کے پاس نہ خود اپنا کوئی زور ہوگا اور نہ کوئی اس کی مدد کرنے والا ہوگا"
        },
        {
          "id": -2005941,
          "resource_id": 227,
          "text": "అప్పుడు అతనికి (మానవునికి) ఎలాంటి శక్తి ఉండదు మరియు ఏ సహాయకుడునూ ఉండడు."
        }
      ]
    },
    {
      "id": 5942,
      "verse_number": 11,
      "verse_key": "86:11",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 530,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407645,
          "resource_id": 85,
          "text": "By the sky and its recurring rain,"
        },
        {
          "id": 1550379,
          "resource_id": 831,
          "text": "Kasam hai baarish barsane waley aasman ki"
        },
        {
          "id": -1005942,
          "resource_id": "ur.maududi",
          "text": "قسم ہے بارش برسانے والے آسمان کی"
        },
        {
          "id": -2005942,
          "resource_id": 227,
          "text": "వర్షం కురిపించే ఆకాశం సాక్షిగా!"
        }
      ]
    },
    {
      "id": 5943,
      "verse_number": 12,
      "verse_key": "86:12",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 530,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407646,
          "resource_id": 85,
          "text": "by the earth that cracks open!"
        },
        {
          "id": 1550380,
          "resource_id": 831,
          "text": "Aur (nabataat ugte waqt) phatt jane wali zameen ki"
        },
        {
          "id": -1005943,
          "resource_id": "ur.maududi",
          "text": "اور (نباتات اگتے وقت) پھٹ جانے والی زمین کی"
        },
        {
          "id": -2005943,
          "resource_id": 227,
          "text": "(చెట్లు మొలకెత్తేటప్పుడు) చీలి పోయే భూమి సాక్షిగా!"
        }
      ]
    },
    {
      "id": 5944,
      "verse_number": 13,
      "verse_key": "86:13",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 530,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّهُۥ لَقَوْلٌ فَصْلٌ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407647,
          "resource_id": 85,
          "text": "This is truly a decisive statement;"
        },
        {
          "id": 1550381,
          "resource_id": 831,
          "text": "Yeh ek jachi-tuli baat hai"
        },
        {
          "id": -1005944,
          "resource_id": "ur.maududi",
          "text": "یہ ایک جچی تلی بات ہے"
        },
        {
          "id": -2005944,
          "resource_id": 227,
          "text": "నిశ్చయంగా, ఇది (ఈ ఖుర్ఆన్, సత్యాసత్యాలను) వేరు పరచే వాక్కు (గీటురాయి)."
        }
      ]
    },
    {
      "id": 5945,
      "verse_number": 14,
      "verse_key": "86:14",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 530,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا هُوَ بِٱلْهَزْلِ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407648,
          "resource_id": 85,
          "text": "it is not something to be taken lightly."
        },
        {
          "id": 1550382,
          "resource_id": 831,
          "text": "Hasi mazak nahin hai"
        },
        {
          "id": -1005945,
          "resource_id": "ur.maududi",
          "text": "ہنسی مذاق نہیں ہے"
        },
        {
          "id": -2005945,
          "resource_id": 227,
          "text": "మరియు ఇది వృథా కాలక్షేపానికి వచ్చినది కాదు."
        }
      ]
    },
    {
      "id": 5946,
      "verse_number": 15,
      "verse_key": "86:15",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 530,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّهُمْ يَكِيدُونَ كَيْدًا",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407649,
          "resource_id": 85,
          "text": "They plot and scheme,"
        },
        {
          "id": 1550383,
          "resource_id": 831,
          "text": "yeh log kuch chalein chal rahe hain"
        },
        {
          "id": -1005946,
          "resource_id": "ur.maududi",
          "text": "یہ لوگ چالیں چل رہے ہیں"
        },
        {
          "id": -2005946,
          "resource_id": 227,
          "text": "(ఓ ముహమ్మద్!) నిశ్చయంగా, వారు (నీకు విరుద్ధంగా) కుట్రపన్నుతున్నారు."
        }
      ]
    },
    {
      "id": 5947,
      "verse_number": 16,
      "verse_key": "86:16",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 530,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَكِيدُ كَيْدًا",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407650,
          "resource_id": 85,
          "text": "but so do I:"
        },
        {
          "id": 1550384,
          "resource_id": 831,
          "text": "Aur mai bhi ek chaal chal raha hoon"
        },
        {
          "id": -1005947,
          "resource_id": "ur.maududi",
          "text": "اور میں بھی ایک چال چل رہا ہوں"
        },
        {
          "id": -2005947,
          "resource_id": 227,
          "text": "మరియు నేను కూడా పన్నాగం పన్నుతున్నాను."
        }
      ]
    },
    {
      "id": 5948,
      "verse_number": 17,
      "verse_key": "86:17",
      "hizb_number": 59,
      "rub_el_hizb_number": 236,
      "ruku_number": 530,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَمَهِّلِ ٱلْكَـٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407651,
          "resource_id": 85,
          "text": "[Prophet], let the disbelievers be, let them be for a while."
        },
        {
          "id": 1550385,
          "resource_id": 831,
          "text": "Pas chodh do aey nabi, in kafiron ko ek zara ki zara in ke haal par chod do"
        },
        {
          "id": -1005948,
          "resource_id": "ur.maududi",
          "text": "پس چھوڑ دو اے نبیؐ، اِن کافروں کو اک ذرا کی ذرا اِن کے حال پر چھوڑ دو"
        },
        {
          "id": -2005948,
          "resource_id": 227,
          "text": "కనుక నీవు సత్యతిరస్కారులకు కొంత వ్యవధి నివ్వు! వారి పట్ల మృదువుగా వ్యవహరించు."
        }
      ]
    }
  ]
}