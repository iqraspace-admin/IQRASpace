{
  "syncedAt": "2026-08-31T09:57:49.680Z",
  "chapter": {
    "id": 87,
    "revelation_place": "makkah",
    "revelation_order": 8,
    "bismillah_pre": true,
    "name_simple": "Al-A'la",
    "name_complex": "Al-'A`lá",
    "name_arabic": "الأعلى",
    "verses_count": 19,
    "pages": [
      591,
      592
    ],
    "translated_name": {
      "language_name": "english",
      "name": "The Most High"
    }
  },
  "verses": [
    {
      "id": 5949,
      "verse_number": 1,
      "verse_key": "87:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407652,
          "resource_id": 85,
          "text": "[Prophet], glorify the name of your Lord the Most High,"
        },
        {
          "id": 1550386,
          "resource_id": 831,
          "text": "(Aey nabi) Apne Rubb-e-bartar kay naam ki tasbeeh karo"
        },
        {
          "id": -1005949,
          "resource_id": "ur.maududi",
          "text": "(اے نبیؐ) اپنے رب برتر کے نام کی تسبیح کرو"
        },
        {
          "id": -2005949,
          "resource_id": 227,
          "text": "అత్యున్నతుడైన నీ ప్రభువు నామాన్ని స్తుతించు!"
        }
      ]
    },
    {
      "id": 5950,
      "verse_number": 2,
      "verse_key": "87:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِى خَلَقَ فَسَوَّىٰ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407653,
          "resource_id": 85,
          "text": "who created [all things] in due proportion;"
        },
        {
          "id": 1550387,
          "resource_id": 831,
          "text": "Jisne paida kiya aur tanasub qayam kiya (then proportioned it)"
        },
        {
          "id": -1005950,
          "resource_id": "ur.maududi",
          "text": "جس نے پیدا کیا اور تناسب قائم کیا"
        },
        {
          "id": -2005950,
          "resource_id": 227,
          "text": "ఆయనే (ప్రతిదానిని) సృష్టించాడు మరియు తగిన ప్రమాణంలో రూపొందించాడు."
        }
      ]
    },
    {
      "id": 5951,
      "verse_number": 3,
      "verse_key": "87:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّذِى قَدَّرَ فَهَدَىٰ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407654,
          "resource_id": 85,
          "text": "who determined their destinies and guided them;"
        },
        {
          "id": 1550388,
          "resource_id": 831,
          "text": "Jisne taqdeer banayi phir raah dikhayi"
        },
        {
          "id": -1005951,
          "resource_id": "ur.maududi",
          "text": "جس نے تقدیر بنائی پھر راہ دکھائی"
        },
        {
          "id": -2005951,
          "resource_id": 227,
          "text": "మరియు ఆయనే దాని ప్రకృతి లక్షణాలను నిర్ణయించాడు, మరియు మార్గం చూపాడు!"
        }
      ]
    },
    {
      "id": 5952,
      "verse_number": 4,
      "verse_key": "87:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407655,
          "resource_id": 85,
          "text": "who brought out the green pasture"
        },
        {
          "id": 1550389,
          "resource_id": 831,
          "text": "Jisne nabataat(pasture) ugayi"
        },
        {
          "id": -1005952,
          "resource_id": "ur.maududi",
          "text": "جس نے نباتات اگائیں"
        },
        {
          "id": -2005952,
          "resource_id": 227,
          "text": "మరియు ఆయనే పచ్చికను మొలిపింప జేశాడు."
        }
      ]
    },
    {
      "id": 5953,
      "verse_number": 5,
      "verse_key": "87:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407656,
          "resource_id": 85,
          "text": "then made it dark debris."
        },
        {
          "id": 1550390,
          "resource_id": 831,
          "text": "Phir unko siyah kuda karkat bana diya"
        },
        {
          "id": -1005953,
          "resource_id": "ur.maududi",
          "text": "پھر اُن کو سیاہ کوڑا کرکٹ بنا دیا"
        },
        {
          "id": -2005953,
          "resource_id": 227,
          "text": "మరల దానిని నల్లని చెత్తాచెదారంగా చేశాడు."
        }
      ]
    },
    {
      "id": 5954,
      "verse_number": 6,
      "verse_key": "87:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407657,
          "resource_id": 85,
          "text": "[Prophet], We shall teach you [the Quran] and you will not forget––"
        },
        {
          "id": 1550391,
          "resource_id": 831,
          "text": "Hum tumhey padhwa dengey phir tum nahin bhuloge"
        },
        {
          "id": -1005954,
          "resource_id": "ur.maududi",
          "text": "ہم تمہیں پڑھوا دیں گے، پھر تم نہیں بھولو گے"
        },
        {
          "id": -2005954,
          "resource_id": 227,
          "text": "మేము నీచేత (ఖుర్ఆన్ ను) చదివింప జేస్తాము, తరువాత నీవు (దానిని) మరచిపోవు -"
        }
      ]
    },
    {
      "id": 5955,
      "verse_number": 7,
      "verse_key": "87:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407658,
          "resource_id": 85,
          "text": "unless God wishes; He knows both what is open and what is hidden––"
        },
        {
          "id": 1550392,
          "resource_id": 831,
          "text": "Siwaye uske jo Allah chahey.Woh zahir ko bhi jaanta hai aur jo kuch posheeda(hidden) hai usko bhi"
        },
        {
          "id": -1005955,
          "resource_id": "ur.maududi",
          "text": "سوائے اُس کے جو اللہ چاہے، وہ ظاہر کو بھی جانتا ہے اور جو کچھ پوشیدہ ہے اُس کو بھی"
        },
        {
          "id": -2005955,
          "resource_id": 227,
          "text": "అల్లాహ్ కోరింది తప్ప! నిశ్చయంగా, బహిరంగంగా ఉన్నదీ మరియు గోప్యంగా ఉన్నదీ అన్నీ ఆయనకు బాగా తెలుసు."
        }
      ]
    },
    {
      "id": 5956,
      "verse_number": 8,
      "verse_key": "87:8",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407659,
          "resource_id": 85,
          "text": "We shall show you the easy way."
        },
        {
          "id": 1550393,
          "resource_id": 831,
          "text": "Aur hum tumhein aasaan tarikey ki sahoolat dete hain"
        },
        {
          "id": -1005956,
          "resource_id": "ur.maududi",
          "text": "اور ہم تمہیں آسان طریقے کی سہولت دیتے ہیں"
        },
        {
          "id": -2005956,
          "resource_id": 227,
          "text": "మరియు మేము నీ మార్గాన్ని సులభం చేయడానికి నీకు సౌలభ్యాన్ని కలుగజేస్తాము."
        }
      ]
    },
    {
      "id": 5957,
      "verse_number": 9,
      "verse_key": "87:9",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407660,
          "resource_id": 85,
          "text": "So remind, if reminding will help."
        },
        {
          "id": 1550394,
          "resource_id": 831,
          "text": "lihaza tum naseehat karo agar naseehat nafey(faiydamand) ho"
        },
        {
          "id": -1005957,
          "resource_id": "ur.maududi",
          "text": "لہٰذا تم نصیحت کرو اگر نصیحت نافع ہو"
        },
        {
          "id": -2005957,
          "resource_id": 227,
          "text": "కావున నీవు హితోపదేశం చేస్తూ ఉండు; వారికి హితోపదేశం లాభదాయకం కావచ్చు!"
        }
      ]
    },
    {
      "id": 5958,
      "verse_number": 10,
      "verse_key": "87:10",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "سَيَذَّكَّرُ مَن يَخْشَىٰ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407661,
          "resource_id": 85,
          "text": "Those who stand in awe of God will heed the reminder,"
        },
        {
          "id": 1550395,
          "resource_id": 831,
          "text": "Jo shaks darta hai wo naseehat qabool karlega"
        },
        {
          "id": -1005958,
          "resource_id": "ur.maududi",
          "text": "جو شخص ڈرتا ہے وہ نصیحت قبول کر لے گا"
        },
        {
          "id": -2005958,
          "resource_id": 227,
          "text": "(అల్లాహ్ కు) భయపడే వాడు హితోపదేశాన్ని స్వీకరిస్తాడు."
        }
      ]
    },
    {
      "id": 5959,
      "verse_number": 11,
      "verse_key": "87:11",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَيَتَجَنَّبُهَا ٱلْأَشْقَى",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407662,
          "resource_id": 85,
          "text": "but it will be ignored by the most wicked,"
        },
        {
          "id": 1550396,
          "resource_id": 831,
          "text": "Aur ussey guraiz karega woh intehayi bad-bakht"
        },
        {
          "id": -1005959,
          "resource_id": "ur.maududi",
          "text": "اور اس سے گریز کریگا وہ انتہائی بد بخت"
        },
        {
          "id": -2005959,
          "resource_id": 227,
          "text": "మరియు దౌర్భాగ్యుడు దానికి దూరమై పోతాడు."
        }
      ]
    },
    {
      "id": 5960,
      "verse_number": 12,
      "verse_key": "87:12",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407663,
          "resource_id": 85,
          "text": "who will enter the Great Fire,"
        },
        {
          "id": 1550397,
          "resource_id": 831,
          "text": "Jo badi aag mei jayega"
        },
        {
          "id": -1005960,
          "resource_id": "ur.maududi",
          "text": "جو بڑی آگ میں جائے گا"
        },
        {
          "id": -2005960,
          "resource_id": 227,
          "text": "అలాంటి వాడే ఘోరమైన నరకాగ్నిలో పడి కాలుతాడు."
        }
      ]
    },
    {
      "id": 5961,
      "verse_number": 13,
      "verse_key": "87:13",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407664,
          "resource_id": 85,
          "text": "where they will neither die nor live."
        },
        {
          "id": 1550398,
          "resource_id": 831,
          "text": "phir na usmein marega aur na jiyega"
        },
        {
          "id": -1005961,
          "resource_id": "ur.maududi",
          "text": "پھر نہ اس میں مرے گا نہ جیے گا"
        },
        {
          "id": -2005961,
          "resource_id": 227,
          "text": "అప్పుడు, అతడు అందులో చావనూ లేడు, బ్రతకనూ లేడు."
        }
      ]
    },
    {
      "id": 5962,
      "verse_number": 14,
      "verse_key": "87:14",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407665,
          "resource_id": 85,
          "text": "Prosperous are those who purify themselves,"
        },
        {
          "id": 1550399,
          "resource_id": 831,
          "text": "Falah paa gaya woh jisne pakizgi ikhtiyar ki"
        },
        {
          "id": -1005962,
          "resource_id": "ur.maududi",
          "text": "فلاح پا گیا وہ جس نے پاکیزگی اختیار کی"
        },
        {
          "id": -2005962,
          "resource_id": 227,
          "text": "సుశీలతను (పవిత్రతను) పాటించే వాడు తప్పక సాఫల్యం పొందుతాడు."
        }
      ]
    },
    {
      "id": 5963,
      "verse_number": 15,
      "verse_key": "87:15",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ",
      "page_number": 591,
      "juz_number": 30,
      "translations": [
        {
          "id": 407666,
          "resource_id": 85,
          "text": "remember the name of their Lord, and pray."
        },
        {
          "id": 1550400,
          "resource_id": 831,
          "text": "Aur apne Rubb ka naam yaad kiya phir namaz padhi"
        },
        {
          "id": -1005963,
          "resource_id": "ur.maududi",
          "text": "اور اپنے رب کا نام یاد کیا پھر نماز پڑھی"
        },
        {
          "id": -2005963,
          "resource_id": 227,
          "text": "మరియు తన ప్రభువు నామాన్ని స్మరిస్తూ, నమాజ్ చేస్తూ ఉండేవాడు."
        }
      ]
    },
    {
      "id": 5964,
      "verse_number": 16,
      "verse_key": "87:16",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407667,
          "resource_id": 85,
          "text": "Yet you [people] prefer the life of this world,"
        },
        {
          "id": 1550401,
          "resource_id": 831,
          "text": "Magar tumlog duniya ki zindagi ko tarjeeh detay ho"
        },
        {
          "id": -1005964,
          "resource_id": "ur.maududi",
          "text": "مگر تم لوگ دنیا کی زندگی کو ترجیح دیتے ہو"
        },
        {
          "id": -2005964,
          "resource_id": 227,
          "text": "అలా కాదు! మీరు ఐహిక జీవితానికి ప్రాధాన్యత నిస్తున్నారు;"
        }
      ]
    },
    {
      "id": 5965,
      "verse_number": 17,
      "verse_key": "87:17",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407668,
          "resource_id": 85,
          "text": "even though the Hereafter is better and more lasting."
        },
        {
          "id": 1550402,
          "resource_id": 831,
          "text": "halaanke aakhirat behtar hai aur baqi rehne wali hai"
        },
        {
          "id": -1005965,
          "resource_id": "ur.maududi",
          "text": "حالانکہ آخرت بہتر ہے اور باقی رہنے والی ہے"
        },
        {
          "id": -2005965,
          "resource_id": 227,
          "text": "కాని పరలోక జీవితమే మేలైనది మరియు చిరకాలముండేది."
        }
      ]
    },
    {
      "id": 5966,
      "verse_number": 18,
      "verse_key": "87:18",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ هَـٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407669,
          "resource_id": 85,
          "text": "All this is in the earlier scriptures,"
        },
        {
          "id": 1550403,
          "resource_id": 831,
          "text": "Yahi baat pehle aaey huey saheefon(scriptures) mei bhi kahi gayi thi"
        },
        {
          "id": -1005966,
          "resource_id": "ur.maududi",
          "text": "یہی بات پہلے آئے ہوئے صحیفوں میں بھی کہی گئی تھی"
        },
        {
          "id": -2005966,
          "resource_id": 227,
          "text": "నిశ్చయంగా, ఈ విషయం పూర్వగ్రంథాలలో (వ్రాయబడి) ఉంది;"
        }
      ]
    },
    {
      "id": 5967,
      "verse_number": 19,
      "verse_key": "87:19",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 531,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407670,
          "resource_id": 85,
          "text": "the scriptures of Abraham and Moses."
        },
        {
          "id": 1550404,
          "resource_id": 831,
          "text": "Ibrahim aur Moosa ke saheefon mein"
        },
        {
          "id": -1005967,
          "resource_id": "ur.maududi",
          "text": "ابراہیمؑ اور موسیٰؑ کے صحیفوں میں"
        },
        {
          "id": -2005967,
          "resource_id": 227,
          "text": "ఇబ్రాహీమ్ మరియు మూసాలపై (అవతరింపజేయబడిన) గ్రంథాలలో."
        }
      ]
    }
  ]
}