    "bismillah_pre": true,
    "name_simple": "Al-Humazah",
    "name_complex": "Al-Humazah",
    "name_arabic": "الهمزة",
    "verses_count": 9,
    "pages": [
      601,
      601
    ],
    "translated_name": {
      "language_name": "english",
      "name": "The Traducer"
    }
  },
  "verses": [
    {
      "id": 6180,
      "verse_number": 1,
      "verse_key": "104:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 548,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ",
      "page_number": 601,
      "juz_number": 30,
      "translations": [
        {
          "id": 407883,
          "resource_id": 85,
          "text": "Woe to every fault-finding backbiter"
        },
        {
          "id": 1550617,
          "resource_id": 831,
          "text": "Tabahi hai har us shaks ke liye jo (moonh dar moonh) logon par taan aur (peeth peechey) buraiyan karne ka khugar hai"
        },
        {
          "id": -1006180,
          "resource_id": "ur.maududi",
          "text": "تباہی ہے ہر اُس شخص کے لیے جو (منہ در منہ) لوگوں پر طعن اور (پیٹھ پیچھے) برائیاں کرنے کا خوگر ہے"
        },
        {
          "id": -2006180,
          "resource_id": 227,
          "text": "అపనిందలు మోపే, చాడీలు చెప్పే ప్రతి ఒక్కడికీ వినాశం తప్పదు."
        }
      ]
    },
    {
      "id": 6181,
      "verse_number": 2,
      "verse_key": "104:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 548,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ",
      "page_number": 601,
      "juz_number": 30,
      "translations": [
        {
          "id": 407884,
          "resource_id": 85,
          "text": "who amasses riches, counting them over,"
        },
        {
          "id": 1550618,
          "resource_id": 831,
          "text": "Jisne maal jama kiya aur usey gin gin kar rakkha"
        },
        {
          "id": -1006181,
          "resource_id": "ur.maududi",
          "text": "جس نے مال جمع کیا اور اُسے گن گن کر رکھا"
        },
        {
          "id": -2006181,
          "resource_id": 227,
          "text": "ఎవడైతే ధనాన్ని కూడబెట్టి, మాటి మాటికి దాన్ని లెక్కబెడుతూ ఉంటాడో!"
        }
      ]
    },
    {
      "id": 6182,
      "verse_number": 3,
      "verse_key": "104:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 548,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ",
      "page_number": 601,
      "juz_number": 30,
      "translations": [
        {
          "id": 407885,
          "resource_id": 85,
          "text": "thinking they will make him live for ever."
        },
        {
          "id": 1550619,
          "resource_id": 831,
          "text": "Woh samajhta hai ke us ka maal hamesha uske paas rahega"
        },
        {
          "id": -1006182,
          "resource_id": "ur.maududi",
          "text": "وہ سمجھتا ہے کہ اُس کا مال ہمیشہ اُس کے پاس رہے گا"
        },
        {
          "id": -2006182,
          "resource_id": 227,
          "text": "తన ధనం, తనను శాశ్వతంగా ఉంచుతుందని అతడు భావిస్తున్నాడు!"
        }
      ]
    },
    {
      "id": 6183,
      "verse_number": 4,
      "verse_key": "104:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 548,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ",
      "page_number": 601,
      "juz_number": 30,
      "translations": [
        {
          "id": 407886,
          "resource_id": 85,
          "text": "No indeed! He will be thrust into the Crusher!"
        },
        {
          "id": 1550620,
          "resource_id": 831,
          "text": "Hargiz nahin, woh shaks to chakna-chur kar dene wali jagah mein phenk diya jayega"
        },
        {
          "id": -1006183,
          "resource_id": "ur.maududi",
          "text": "ہرگز نہیں، وہ شخص تو چکنا چور کر دینے والی جگہ میں پھینک دیا جائے گا"
        },
        {
          "id": -2006183,
          "resource_id": 227,
          "text": "ఎంత మాత్రం కాదు! అతడు (రాబోయే జీవితంలో) తప్పకుండా అణగ ద్రొక్కబడే నరకాగ్నిలో వేయబడతాడు."
        }
      ]
    },
    {
      "id": 6184,
      "verse_number": 5,
      "verse_key": "104:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 548,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ",
      "page_number": 601,
      "juz_number": 30,
      "translations": [
        {
          "id": 407887,
          "resource_id": 85,
          "text": "What will explain to you what the Crusher is?"
        },
        {
          "id": 1550621,
          "resource_id": 831,
          "text": "Aur tum kya jano ke kya hai woh chakna-chur kar dene wali jagah"
        },
        {
          "id": -1006184,
          "resource_id": "ur.maududi",
          "text": "اور تم کیا جانو کہ کیا ہے وہ چکنا چور کر دینے والی جگہ؟"
        },
        {
          "id": -2006184,
          "resource_id": 227,
          "text": "ఆ (అణగద్రొక్కబడే) నరకాగ్ని అంటే ఏమిటో నీకు తెలుసా?"
        }
      ]
    },
    {
      "id": 6185,
      "verse_number": 6,
      "verse_key": "104:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 548,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "نَارُ ٱللَّهِ ٱلْمُوقَدَةُ",
      "page_number": 601,
      "juz_number": 30,
      "translations": [
        {
          "id": 407888,
          "resource_id": 85,
          "text": "It is God’s Fire, made to blaze,"
        },
        {
          "id": 1550622,
          "resource_id": 831,
          "text": "Allah ki aag khoob bhadkayi hui"
        },
        {
          "id": -1006185,
          "resource_id": "ur.maududi",
          "text": "اللہ کی آگ، خوب بھڑکائی ہوئی"
        },
        {
          "id": -2006185,
          "resource_id": 227,
          "text": "అల్లాహ్, తీవ్రంగా ప్రజ్వలింపజేసిన అగ్ని;"
        }
      ]
    },
    {
      "id": 6186,
      "verse_number": 7,
      "verse_key": "104:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 548,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ",
      "page_number": 601,
      "juz_number": 30,
      "translations": [
        {
          "id": 407889,
          "resource_id": 85,
          "text": "which rises over people’s hearts."
        },
        {
          "id": 1550623,
          "resource_id": 831,
          "text": "Jo dilon tak pahunchey gi"
        },
        {
          "id": -1006186,
          "resource_id": "ur.maududi",
          "text": "جو دلوں تک پہنچے گی"
        },
        {
          "id": -2006186,
          "resource_id": 227,
          "text": "అది గుండెల దాకా చేరుకుంటుంది."
        }
      ]
    },
    {
      "id": 6187,
      "verse_number": 8,
      "verse_key": "104:8",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 548,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ",
      "page_number": 601,
      "juz_number": 30,
      "translations": [
        {
          "id": 407890,
          "resource_id": 85,
          "text": "It closes in on them"
        },
        {
          "id": 1550624,
          "resource_id": 831,
          "text": "Woh un par dhaank kar bandh kar di jayegi"
        },
        {
          "id": -1006187,
          "resource_id": "ur.maududi",
          "text": "وہ اُن پر ڈھانک کر بند کر دی جائے گی"
        },
        {
          "id": -2006187,
          "resource_id": 227,
          "text": "నిశ్చయంగా, అది వారి మీద క్రమ్ముకొంటుంది."
        }
      ]
    },
    {
      "id": 6188,
      "verse_number": 9,
      "verse_key": "104:9",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 548,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فِى عَمَدٍ مُّمَدَّدَةٍۭ",
      "page_number": 601,
      "juz_number": 30,
      "translations": [
        {
          "id": 407891,
          "resource_id": 85,
          "text": "in towering columns."
        },
        {
          "id": 1550625,
          "resource_id": 831,
          "text": "(Is halat mei ke woh) unchey unchey sutuno mei (ghirey huey hongey)"
        },
        {
          "id": -1006188,
          "resource_id": "ur.maududi",
          "text": "(اِس حالت میں کہ وہ) اونچے اونچے ستونوں میں (گھرے ہوئے ہوں گے)"
        },
        {
          "id": -2006188,
          "resource_id": 227,
          "text": "పొడుగాటి (అగ్ని) స్థంభాల వలే!"
        }
      ]
    }
  ]
}