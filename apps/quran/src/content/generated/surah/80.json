{
  "syncedAt": "2026-08-31T09:57:46.689Z",
  "chapter": {
    "id": 80,
    "revelation_place": "makkah",
    "revelation_order": 24,
    "bismillah_pre": true,
    "name_simple": "'Abasa",
    "name_complex": "`Abasa",
    "name_arabic": "عبس",
    "verses_count": 42,
    "pages": [
      585,
      585
    ],
    "translated_name": {
      "language_name": "english",
      "name": "He Frowned"
    }
  },
  "verses": [
    {
      "id": 5759,
      "verse_number": 1,
      "verse_key": "80:1",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " عَبَسَ وَتَوَلَّىٰٓ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407462,
          "resource_id": 85,
          "text": "He frowned and turned away"
        },
        {
          "id": 1550196,
          "resource_id": 831,
          "text": "[The prophet] Tursh-rooh (frowned) hua aur berukhi barti"
        },
        {
          "id": -1005759,
          "resource_id": "ur.maududi",
          "text": "ترش رو ہوا، اور بے رخی برتی"
        },
        {
          "id": -2005759,
          "resource_id": 227,
          "text": "అతను (ప్రవక్త) భృకుటి ముడి వేసుకున్నాడు మరియు ముఖం త్రిప్పుకున్నాడు;"
        }
      ]
    },
    {
      "id": 5760,
      "verse_number": 2,
      "verse_key": "80:2",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَن جَآءَهُ ٱلْأَعْمَىٰ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407463,
          "resource_id": 85,
          "text": "when the blind man came to him––"
        },
        {
          "id": 1550197,
          "resource_id": 831,
          "text": "Is baat par ke woh andha us ke paas aa gaya"
        },
        {
          "id": -1005760,
          "resource_id": "ur.maududi",
          "text": "اِس بات پر کہ وہ اندھا اُس کے پاس آ گیا"
        },
        {
          "id": -2005760,
          "resource_id": 227,
          "text": "ఆ గ్రుడ్డివాడు తన వద్దకు వచ్చాడని!"
        }
      ]
    },
    {
      "id": 5761,
      "verse_number": 3,
      "verse_key": "80:3",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407464,
          "resource_id": 85,
          "text": "for all you know, he might have grown in spirit,"
        },
        {
          "id": 1550198,
          "resource_id": 831,
          "text": "Tumhe kya khabar, shayad woh sudhar jaye"
        },
        {
          "id": -1005761,
          "resource_id": "ur.maududi",
          "text": "تمہیں کیا خبر، شاید وہ سدھر جائے"
        },
        {
          "id": -2005761,
          "resource_id": 227,
          "text": "కాని నీకేం తెలుసు? బహుశా అతడు తనను తాను సంస్కరించుకోవచ్చు!"
        }
      ]
    },
    {
      "id": 5762,
      "verse_number": 4,
      "verse_key": "80:4",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407465,
          "resource_id": 85,
          "text": "or taken note of something useful to him."
        },
        {
          "id": 1550199,
          "resource_id": 831,
          "text": "ya naseehat par dhyaan de aur naseeat karna us ke liye nafea(faiydamand) ho"
        },
        {
          "id": -1005762,
          "resource_id": "ur.maududi",
          "text": "یا نصیحت پر دھیان دے، اور نصیحت کرنا اس کے لیے نافع ہو؟"
        },
        {
          "id": -2005762,
          "resource_id": 227,
          "text": "లేదా అతడు హితబోధ పొందవచ్చు మరియు ఆ హితబోధ అతనికి ప్రయోజనకరం కావచ్చు!"
        }
      ]
    },
    {
      "id": 5763,
      "verse_number": 5,
      "verse_key": "80:5",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَمَّا مَنِ ٱسْتَغْنَىٰ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407466,
          "resource_id": 85,
          "text": "For the self-satisfied one"
        },
        {
          "id": 1550200,
          "resource_id": 831,
          "text": "Jo shaks be-parwahi baratta hai"
        },
        {
          "id": -1005763,
          "resource_id": "ur.maududi",
          "text": "جو شخص بے پروائی برتتا ہے"
        },
        {
          "id": -2005763,
          "resource_id": 227,
          "text": "కాని అతడు, ఎవడైతే తనను తాను స్వయం సమృద్ధుడు, అనుకుంటున్నాడో!"
        }
      ]
    },
    {
      "id": 5764,
      "verse_number": 6,
      "verse_key": "80:6",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَنتَ لَهُۥ تَصَدَّىٰ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407467,
          "resource_id": 85,
          "text": "you go out of your way––"
        },
        {
          "id": 1550201,
          "resource_id": 831,
          "text": "Uski taraf to tum tawajjuh karte ho"
        },
        {
          "id": -1005764,
          "resource_id": "ur.maududi",
          "text": "اس کی طرف تو تم توجہ کرتے ہو"
        },
        {
          "id": -2005764,
          "resource_id": 227,
          "text": "అతని పట్ల నీవు ఆసక్తి చూపుతున్నావు."
        }
      ]
    },
    {
      "id": 5765,
      "verse_number": 7,
      "verse_key": "80:7",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407468,
          "resource_id": 85,
          "text": "though you are not to be blamed for his lack of spiritual growth––"
        },
        {
          "id": 1550202,
          "resource_id": 831,
          "text": "Halaanke agar wo na sudhrey to tum par uski kya zimmedari hai"
        },
        {
          "id": -1005765,
          "resource_id": "ur.maududi",
          "text": "حالانکہ اگر وہ نہ سدھرے تو تم پر اس کی کیا ذمہ داری ہے؟"
        },
        {
          "id": -2005765,
          "resource_id": 227,
          "text": "ఒకవేళ అతడు సంస్కరించుకోక పోతే నీపై బాధ్యత ఏముంది?"
        }
      ]
    },
    {
      "id": 5766,
      "verse_number": 8,
      "verse_key": "80:8",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407469,
          "resource_id": 85,
          "text": "but from the one who has come to you full of eagerness"
        },
        {
          "id": 1550203,
          "resource_id": 831,
          "text": "Aur jo khud tumharey paas dauda aata hai"
        },
        {
          "id": -1005766,
          "resource_id": "ur.maududi",
          "text": "اور جو خود تمہارے پاس دوڑا آتا ہے"
        },
        {
          "id": -2005766,
          "resource_id": 227,
          "text": "కాని, ఎవడైతే తనంతట తాను, నీ వద్దకు పరుగెత్తుకుంటూ వచ్చాడో!"
        }
      ]
    },
    {
      "id": 5767,
      "verse_number": 9,
      "verse_key": "80:9",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَهُوَ يَخْشَىٰ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407470,
          "resource_id": 85,
          "text": "and awe"
        },
        {
          "id": 1550204,
          "resource_id": 831,
          "text": "Aur woh darr raha hota hai"
        },
        {
          "id": -1005767,
          "resource_id": "ur.maududi",
          "text": "اور وہ ڈر رہا ہوتا ہے"
        },
        {
          "id": -2005767,
          "resource_id": 227,
          "text": "మరియు (అల్లాహ్ యెడల) భీతిపరుడై ఉన్నాడో!"
        }
      ]
    },
    {
      "id": 5768,
      "verse_number": 10,
      "verse_key": "80:10",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَنتَ عَنْهُ تَلَهَّىٰ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407471,
          "resource_id": 85,
          "text": "you allow yourself to be distracted."
        },
        {
          "id": 1550205,
          "resource_id": 831,
          "text": "Usse tum berukhi barat-tey ho"
        },
        {
          "id": -1005768,
          "resource_id": "ur.maududi",
          "text": "اس سے تم بے رخی برتتے ہو"
        },
        {
          "id": -2005768,
          "resource_id": 227,
          "text": "అతనిని నీవు నిర్లక్ష్యం చేస్తున్నావు."
        }
      ]
    },
    {
      "id": 5769,
      "verse_number": 11,
      "verse_key": "80:11",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّآ إِنَّهَا تَذْكِرَةٌ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407472,
          "resource_id": 85,
          "text": "No indeed! This [Quran] is a lesson"
        },
        {
          "id": 1550206,
          "resource_id": 831,
          "text": "Hargiz nahin yeh to ek naseehat hai"
        },
        {
          "id": -1005769,
          "resource_id": "ur.maududi",
          "text": "ہرگز نہیں، یہ تو ایک نصیحت ہے"
        },
        {
          "id": -2005769,
          "resource_id": 227,
          "text": "అలా కాదు! నిశ్చయంగా, ఇది (ఈ ఖుర్ఆన్) ఒక హితోపదేశం."
        }
      ]
    },
    {
      "id": 5770,
      "verse_number": 12,
      "verse_key": "80:12",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَمَن شَآءَ ذَكَرَهُۥ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407473,
          "resource_id": 85,
          "text": "from which those who wish to be taught should learn,"
        },
        {
          "id": 1550207,
          "resource_id": 831,
          "text": "jiska jee chahey isey qabool karey"
        },
        {
          "id": -1005770,
          "resource_id": "ur.maududi",
          "text": "جس کا جی چاہے اِسے قبول کرے"
        },
        {
          "id": -2005770,
          "resource_id": 227,
          "text": "కావున ఇష్టమున్నవారు దీనిని స్వీకరించవచ్చు!"
        }
      ]
    },
    {
      "id": 5771,
      "verse_number": 13,
      "verse_key": "80:13",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فِى صُحُفٍ مُّكَرَّمَةٍ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407474,
          "resource_id": 85,
          "text": "[written] on honoured,"
        },
        {
          "id": 1550208,
          "resource_id": 831,
          "text": "Yeh aisey saheefon mein darj hai jo mukarram hain"
        },
        {
          "id": -1005771,
          "resource_id": "ur.maududi",
          "text": "یہ ایسے صحیفوں میں درج ہے جو مکرم ہیں"
        },
        {
          "id": -2005771,
          "resource_id": 227,
          "text": "ఇది ప్రతిష్ఠాకరమైన పుటలలో (వ్రాయబడి ఉన్నది);"
        }
      ]
    },
    {
      "id": 5772,
      "verse_number": 14,
      "verse_key": "80:14",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407475,
          "resource_id": 85,
          "text": "exalted, pure pages,"
        },
        {
          "id": 1550209,
          "resource_id": 831,
          "text": "Buland martaba hain, pakeeza hain"
        },
        {
          "id": -1005772,
          "resource_id": "ur.maududi",
          "text": "بلند مرتبہ ہیں، پاکیزہ ہیں"
        },
        {
          "id": -2005772,
          "resource_id": 227,
          "text": "మహోన్నతమైనది, పవిత్రమైనది;"
        }
      ]
    },
    {
      "id": 5773,
      "verse_number": 15,
      "verse_key": "80:15",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "بِأَيْدِى سَفَرَةٍ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407476,
          "resource_id": 85,
          "text": "by the hands of"
        },
        {
          "id": 1550210,
          "resource_id": 831,
          "text": "muazzaz aur neik kaatibon ke"
        },
        {
          "id": -1005773,
          "resource_id": "ur.maududi",
          "text": "معزز اور نیک کاتبوں کے"
        },
        {
          "id": -2005773,
          "resource_id": 227,
          "text": "లేఖకుల (దేవదూతల) చేతులలో;"
        }
      ]
    },
    {
      "id": 5774,
      "verse_number": 16,
      "verse_key": "80:16",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كِرَامٍۭ بَرَرَةٍ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407477,
          "resource_id": 85,
          "text": "noble and virtuous scribes."
        },
        {
          "id": 1550211,
          "resource_id": 831,
          "text": "haathon mein rehete hain"
        },
        {
          "id": -1005774,
          "resource_id": "ur.maududi",
          "text": "ہاتھوں میں رہتے ہیں"
        },
        {
          "id": -2005774,
          "resource_id": 227,
          "text": "వారు గౌరవనీయులైన సత్పురుషులు (ఆజ్ఞానువర్తనులు)."
        }
      ]
    },
    {
      "id": 5775,
      "verse_number": 17,
      "verse_key": "80:17",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407478,
          "resource_id": 85,
          "text": "Woe to man! How ungrateful he is!"
        },
        {
          "id": 1550212,
          "resource_id": 831,
          "text": "Laanat ho Insan par kaisa sakht munkir-e-haq (denies the Truth) hai yeh"
        },
        {
          "id": -1005775,
          "resource_id": "ur.maududi",
          "text": "لعنت ہو انسان پر، کیسا سخت منکر حق ہے یہ"
        },
        {
          "id": -2005775,
          "resource_id": 227,
          "text": "మానవుడు నాశనం గాను! అతడు ఎంత కృతఘ్నుడు!"
        }
      ]
    },
    {
      "id": 5776,
      "verse_number": 18,
      "verse_key": "80:18",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407479,
          "resource_id": 85,
          "text": "From what thing does God create him?"
        },
        {
          "id": 1550213,
          "resource_id": 831,
          "text": "Kis cheez se Allah ne isey paida kiya hai"
        },
        {
          "id": -1005776,
          "resource_id": "ur.maududi",
          "text": "کس چیز سے اللہ نے اِسے پیدا کیا ہے؟"
        },
        {
          "id": -2005776,
          "resource_id": 227,
          "text": "ఆయన (అల్లాహ్) దేనితో అతనిని సృష్టించాడు?"
        }
      ]
    },
    {
      "id": 5777,
      "verse_number": 19,
      "verse_key": "80:19",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407480,
          "resource_id": 85,
          "text": "He creates him from a droplet, He proportions him,"
        },
        {
          "id": 1550214,
          "resource_id": 831,
          "text": "Nutfa ki ek boondh se Allah ne isey paida kiya phir iski taqdeer muqarrar ki"
        },
        {
          "id": -1005777,
          "resource_id": "ur.maududi",
          "text": "نطفہ کی ایک بوند سے اللہ نے اِسے پیدا کیا، پھر اِس کی تقدیر مقرر کی"
        },
        {
          "id": -2005777,
          "resource_id": 227,
          "text": "అతనిని వీర్యబిందువుతో సృష్టించాడు తరువాత అతనిని తగిన విధంగా తీర్చిదిద్దాడు."
        }
      ]
    },
    {
      "id": 5778,
      "verse_number": 20,
      "verse_key": "80:20",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407481,
          "resource_id": 85,
          "text": "He makes the way easy for him,"
        },
        {
          "id": 1550215,
          "resource_id": 831,
          "text": "Phir iske liye zindagi ki raah aasan ki"
        },
        {
          "id": -1005778,
          "resource_id": "ur.maududi",
          "text": "پھر اِس کے لیے زندگی کی راہ آسان کی"
        },
        {
          "id": -2005778,
          "resource_id": 227,
          "text": "ఆ తరువాత, అతని మార్గాన్ని అతనికి సులభతరం చేశాడు;"
        }
      ]
    },
    {
      "id": 5779,
      "verse_number": 21,
      "verse_key": "80:21",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407482,
          "resource_id": 85,
          "text": "then He causes him to die and be buried."
        },
        {
          "id": 1550216,
          "resource_id": 831,
          "text": "Phir isey maut di aur qabr mei pahunchaya"
        },
        {
          "id": -1005779,
          "resource_id": "ur.maududi",
          "text": "پھر اِسے موت دی اور قبر میں پہنچایا"
        },
        {
          "id": -2005779,
          "resource_id": 227,
          "text": "ఆపైన అతనిని మరణింపజేసి గోరీ లోకి చేర్చాడు;"
        }
      ]
    },
    {
      "id": 5780,
      "verse_number": 22,
      "verse_key": "80:22",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407483,
          "resource_id": 85,
          "text": "When He wills, He will raise him up again."
        },
        {
          "id": 1550217,
          "resource_id": 831,
          "text": "Phir jab chahey woh isey dobara utha khada karey"
        },
        {
          "id": -1005780,
          "resource_id": "ur.maududi",
          "text": "پھر جب چاہے وہ اِسے دوبارہ اٹھا کھڑا کرے"
        },
        {
          "id": -2005780,
          "resource_id": 227,
          "text": "మళ్ళీ ఆయన (అల్లాహ్) కోరినప్పుడు అతనిని తిరిగి బ్రతికించి లేపాడు."
        }
      ]
    },
    {
      "id": 5781,
      "verse_number": 23,
      "verse_key": "80:23",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407484,
          "resource_id": 85,
          "text": "Yet man does not fulfil God’s commands."
        },
        {
          "id": 1550218,
          "resource_id": 831,
          "text": "Hargiz nahi, isney woh farz ada nahi kiya jiska Allah ne isey hukum diya tha"
        },
        {
          "id": -1005781,
          "resource_id": "ur.maududi",
          "text": "ہرگز نہیں، اِس نے وہ فرض ادا نہیں کیا جس کا اللہ نے اِسے حکم دیا تھا"
        },
        {
          "id": -2005781,
          "resource_id": 227,
          "text": "అలా కాదు, ఆయన (అల్లాహ్) ఆదేశించిన దానిని (మానవుడు) నెరవేర్చలేదు."
        }
      ]
    },
    {
      "id": 5782,
      "verse_number": 24,
      "verse_key": "80:24",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ طَعَامِهِۦٓ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407485,
          "resource_id": 85,
          "text": "Let man consider the food he eats!"
        },
        {
          "id": 1550219,
          "resource_id": 831,
          "text": "Phir zara insaan apni khuraak(khane/food) ko dekhe"
        },
        {
          "id": -1005782,
          "resource_id": "ur.maududi",
          "text": "پھر ذرا انسان اپنی خوراک کو دیکھے"
        },
        {
          "id": -2005782,
          "resource_id": 227,
          "text": "ఇక, మానవుడు తన ఆహారాన్ని గమనించాలి!"
        }
      ]
    },
    {
      "id": 5783,
      "verse_number": 25,
      "verse_key": "80:25",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407486,
          "resource_id": 85,
          "text": "We pour down abundant water"
        },
        {
          "id": 1550220,
          "resource_id": 831,
          "text": "Humne khoob paani lundhaya(poured)"
        },
        {
          "id": -1005783,
          "resource_id": "ur.maududi",
          "text": "ہم نے خوب پانی لنڈھایا"
        },
        {
          "id": -2005783,
          "resource_id": 227,
          "text": "నిశ్చయంగా మేము నీటిని (వర్షాన్ని) ఎంత పుష్కలంగా కురిపించాము."
        }
      ]
    },
    {
      "id": 5784,
      "verse_number": 26,
      "verse_key": "80:26",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407487,
          "resource_id": 85,
          "text": "and cause the soil to split open."
        },
        {
          "id": 1550221,
          "resource_id": 831,
          "text": "Phir zameen ko ajeeb tarah phada"
        },
        {
          "id": -1005784,
          "resource_id": "ur.maududi",
          "text": "پھر زمین کو عجیب طرح پھاڑا"
        },
        {
          "id": -2005784,
          "resource_id": 227,
          "text": "ఆ తరువాత భూమిని (మొలిచే మొక్కలతో) చీల్చాము, ఒక అద్భుతమైన చీల్పుతో!"
        }
      ]
    },
    {
      "id": 5785,
      "verse_number": 27,
      "verse_key": "80:27",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَنۢبَتْنَا فِيهَا حَبًّا",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407488,
          "resource_id": 85,
          "text": "We make grain grow,"
        },
        {
          "id": 1550222,
          "resource_id": 831,
          "text": "phir us ke andar ugaye galley(grain)"
        },
        {
          "id": -1005785,
          "resource_id": "ur.maududi",
          "text": "پھر اُس کے اندر اگائے غلے"
        },
        {
          "id": -2005785,
          "resource_id": 227,
          "text": "తరువాత దానిలో ధాన్యాన్ని పెంచాము;"
        }
      ]
    },
    {
      "id": 5786,
      "verse_number": 28,
      "verse_key": "80:28",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَعِنَبًا وَقَضْبًا",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407489,
          "resource_id": 85,
          "text": "and vines, fresh vegetation,"
        },
        {
          "id": 1550223,
          "resource_id": 831,
          "text": "Aur angoor aur tarkariyan"
        },
        {
          "id": -1005786,
          "resource_id": "ur.maududi",
          "text": "اور انگور اور ترکاریاں"
        },
        {
          "id": -2005786,
          "resource_id": 227,
          "text": "మరియు ద్రాక్షలను మరియు కూరగాయలను;"
        }
      ]
    },
    {
      "id": 5787,
      "verse_number": 29,
      "verse_key": "80:29",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَزَيْتُونًا وَنَخْلًا",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407490,
          "resource_id": 85,
          "text": "olive trees, date palms,"
        },
        {
          "id": 1550224,
          "resource_id": 831,
          "text": "Aur zaitoon aur khajoorein"
        },
        {
          "id": -1005787,
          "resource_id": "ur.maududi",
          "text": "اور زیتون اور کھجوریں"
        },
        {
          "id": -2005787,
          "resource_id": 227,
          "text": "మరియు ఆలివ్ (జైతూన్) మరియు ఖర్జూరపు చెట్లను;"
        }
      ]
    },
    {
      "id": 5788,
      "verse_number": 30,
      "verse_key": "80:30",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَحَدَآئِقَ غُلْبًا",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407491,
          "resource_id": 85,
          "text": "luscious gardens,"
        },
        {
          "id": 1550225,
          "resource_id": 831,
          "text": "Aur ghaney baagh(orchards)"
        },
        {
          "id": -1005788,
          "resource_id": "ur.maududi",
          "text": "اور گھنے باغ"
        },
        {
          "id": -2005788,
          "resource_id": 227,
          "text": "మరియు దట్టమైన తోటలను;"
        }
      ]
    },
    {
      "id": 5789,
      "verse_number": 31,
      "verse_key": "80:31",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَفَـٰكِهَةً وَأَبًّا",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407492,
          "resource_id": 85,
          "text": "fruits, and fodder:"
        },
        {
          "id": 1550226,
          "resource_id": 831,
          "text": "Aur tarah tarah ke phal aur chaarey"
        },
        {
          "id": -1005789,
          "resource_id": "ur.maududi",
          "text": "اور طرح طرح کے پھل، اور چارے"
        },
        {
          "id": -2005789,
          "resource_id": 227,
          "text": "మరియు (రకరకాల) పండ్లను మరియు పచ్చికలను;"
        }
      ]
    },
    {
      "id": 5790,
      "verse_number": 32,
      "verse_key": "80:32",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مَّتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407493,
          "resource_id": 85,
          "text": "all for you and your livestock to enjoy."
        },
        {
          "id": 1550227,
          "resource_id": 831,
          "text": "Tumharey liye aur tumharey maweshion(cattles) ke liye saman-e-zeist(provision )ke taur par"
        },
        {
          "id": -1005790,
          "resource_id": "ur.maududi",
          "text": "تمہارے لیے اور تمہارے مویشیوں کے لیے سامان زیست کے طور پر"
        },
        {
          "id": -2005790,
          "resource_id": 227,
          "text": "మీకు మరియు మీ పశువులకు జీవన సామగ్రిగా!"
        }
      ]
    },
    {
      "id": 5791,
      "verse_number": 33,
      "verse_key": "80:33",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407494,
          "resource_id": 85,
          "text": "When the Deafening Blast comes––"
        },
        {
          "id": 1550228,
          "resource_id": 831,
          "text": "Aakhir-e-kaar jab woh kaan behrey kar deney wali aawaz buland hogi"
        },
        {
          "id": -1005791,
          "resource_id": "ur.maududi",
          "text": "آخرکار جب وہ کان بہرے کر دینے والی آواز بلند ہوگی"
        },
        {
          "id": -2005791,
          "resource_id": 227,
          "text": "ఎప్పుడైతే, చెవులను చెవిటిగా చేసే ఆ గొప్ప ధ్వని వస్తుందో!"
        }
      ]
    },
    {
      "id": 5792,
      "verse_number": 34,
      "verse_key": "80:34",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407495,
          "resource_id": 85,
          "text": "the Day man will flee from his own brother,"
        },
        {
          "id": 1550229,
          "resource_id": 831,
          "text": "Us roz aadmi apne bhai"
        },
        {
          "id": -1005792,
          "resource_id": "ur.maududi",
          "text": "اُس روز آدمی اپنے بھائی"
        },
        {
          "id": -2005792,
          "resource_id": 227,
          "text": "ఆ రోజు, మానవుడు తన సోదరుని నుండి దూరంగా పారిపోతాడు;"
        }
      ]
    },
    {
      "id": 5793,
      "verse_number": 35,
      "verse_key": "80:35",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأُمِّهِۦ وَأَبِيهِ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407496,
          "resource_id": 85,
          "text": "his mother, his father,"
        },
        {
          "id": 1550230,
          "resource_id": 831,
          "text": "Aur apni maa aur apne baap"
        },
        {
          "id": -1005793,
          "resource_id": "ur.maududi",
          "text": "اور اپنی ماں اور اپنے باپ"
        },
        {
          "id": -2005793,
          "resource_id": 227,
          "text": "మరియు తన తల్లి నుండి మరియు తండ్రి నుండి;"
        }
      ]
    },
    {
      "id": 5794,
      "verse_number": 36,
      "verse_key": "80:36",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَصَـٰحِبَتِهِۦ وَبَنِيهِ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407497,
          "resource_id": 85,
          "text": "his wife, his children:"
        },
        {
          "id": 1550231,
          "resource_id": 831,
          "text": "Aur apni biwi aur apni aulad se bhagega"
        },
        {
          "id": -1005794,
          "resource_id": "ur.maududi",
          "text": "اور اپنی بیوی اور اپنی اولاد سے بھاگے گا"
        },
        {
          "id": -2005794,
          "resource_id": 227,
          "text": "మరియు తన భార్య (సాహిబతి) నుండి మరియు తన సంతానం నుండి;"
        }
      ]
    },
    {
      "id": 5795,
      "verse_number": 37,
      "verse_key": "80:37",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407498,
          "resource_id": 85,
          "text": "each of them will be absorbed in concerns of their own on that Day-"
        },
        {
          "id": 1550232,
          "resource_id": 831,
          "text": "Unmein har shaks par us din aisa waqt aa padega ke usay apne siwa kisi ka hosh na hoga"
        },
        {
          "id": -1005795,
          "resource_id": "ur.maududi",
          "text": "ان میں سے ہر شخص پر اس دن ایسا وقت آ پڑے گا کہ اسے اپنے سوا کسی کا ہوش نہ ہوگا"
        },
        {
          "id": -2005795,
          "resource_id": 227,
          "text": "ఆ రోజు వారిలో ప్రతి మానవునికి తనను గురించి మాత్రమే చాలినంత చింత ఉంటుంది."
        }
      ]
    },
    {
      "id": 5796,
      "verse_number": 38,
      "verse_key": "80:38",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407499,
          "resource_id": 85,
          "text": "on that Day some faces will be beaming,"
        },
        {
          "id": 1550233,
          "resource_id": 831,
          "text": "Kuch chehrey us roz damak rahe hongey"
        },
        {
          "id": -1005796,
          "resource_id": "ur.maududi",
          "text": "کچھ چہرے اُس روز دمک رہے ہوں گے"
        },
        {
          "id": -2005796,
          "resource_id": 227,
          "text": "ఆ రోజు కొన్ని ముఖాలు ఆనందంతో ప్రకాశిస్తూ ఉంటాయి;"
        }
      ]
    },
    {
      "id": 5797,
      "verse_number": 39,
      "verse_key": "80:39",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ضَاحِكَةٌ مُّسْتَبْشِرَةٌ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407500,
          "resource_id": 85,
          "text": "laughing, and rejoicing,"
        },
        {
          "id": 1550234,
          "resource_id": 831,
          "text": "Hashash bashash aur khush o khurram hongey"
        },
        {
          "id": -1005797,
          "resource_id": "ur.maududi",
          "text": "ہشاش بشاش اور خوش و خرم ہوں گے"
        },
        {
          "id": -2005797,
          "resource_id": 227,
          "text": "అవి చిరునవ్వులతో ఆనందోత్సాహాలతో కళకళలాడుతుంటాయి."
        }
      ]
    },
    {
      "id": 5798,
      "verse_number": 40,
      "verse_key": "80:40",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407501,
          "resource_id": 85,
          "text": "but some faces will be dust-stained"
        },
        {
          "id": 1550235,
          "resource_id": 831,
          "text": "Aur kuch chehron par uss roz khaak(dust) udd rahi hogi"
        },
        {
          "id": -1005798,
          "resource_id": "ur.maududi",
          "text": "اور کچھ چہروں پر اس روز خاک اڑ رہی ہوگی"
        },
        {
          "id": -2005798,
          "resource_id": 227,
          "text": "మరికొన్ని ముఖాలు ఆ రోజు, దుమ్ము కొట్టుకొని (ఎంతో వ్యాకులంతో) నిండి ఉంటాయి."
        }
      ]
    },
    {
      "id": 5799,
      "verse_number": 41,
      "verse_key": "80:41",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "تَرْهَقُهَا قَتَرَةٌ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407502,
          "resource_id": 85,
          "text": "and covered in darkness:"
        },
        {
          "id": 1550236,
          "resource_id": 831,
          "text": "Aur kalons(darkness) chayi hui hogi"
        },
        {
          "id": -1005799,
          "resource_id": "ur.maududi",
          "text": "اور کلونس چھائی ہوئی ہوگی"
        },
        {
          "id": -2005799,
          "resource_id": 227,
          "text": "అవి నల్లగా మాడిపోయి ఉంటాయి;"
        }
      ]
    },
    {
      "id": 5800,
      "verse_number": 42,
      "verse_key": "80:42",
      "hizb_number": 59,
      "rub_el_hizb_number": 234,
      "ruku_number": 524,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أُو۟لَـٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ",
      "page_number": 585,
      "juz_number": 30,
      "translations": [
        {
          "id": 407503,
          "resource_id": 85,
          "text": "those are the disbelievers, the licentious."
        },
        {
          "id": 1550237,
          "resource_id": 831,
          "text": "Yahi kafir o fajir (unbelivers and wicked) log hain"
        },
        {
          "id": -1005800,
          "resource_id": "ur.maududi",
          "text": "یہی کافر و فاجر لوگ ہوں گے"
        },
        {
          "id": -2005800,
          "resource_id": 227,
          "text": "అలాంటి వారు, వారే! సత్యతిరస్కారులైన దుష్టులు."
        }
      ]
    }
  ]
}