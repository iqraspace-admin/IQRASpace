{
  "syncedAt": "2026-08-31T09:57:55.199Z",
  "chapter": {
    "id": 100,
    "revelation_place": "makkah",
    "revelation_order": 14,
    "bismillah_pre": true,
    "name_simple": "Al-'Adiyat",
    "name_complex": "Al-`Ādiyāt",
    "name_arabic": "العاديات",
    "verses_count": 11,
    "pages": [
      599,
      600
    ],
    "translated_name": {
      "language_name": "english",
      "name": "The Courser"
    }
  },
  "verses": [
    {
      "id": 6147,
      "verse_number": 1,
      "verse_key": "100:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 544,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " وَٱلْعَـٰدِيَـٰتِ ضَبْحًا",
      "page_number": 599,
      "juz_number": 30,
      "translations": [
        {
          "id": 407850,
          "resource_id": 85,
          "text": "By the charging steeds that pant"
        },
        {
          "id": 1550584,
          "resource_id": 831,
          "text": "Kasam hai un (ghodon) ki jo phunkare marte hue dhaudte hai"
        },
        {
          "id": -1006147,
          "resource_id": "ur.maududi",
          "text": "قسم ہے اُن (گھوڑوں) کی جو پھنکارے مارتے ہوئے دوڑتے ہیں"
        },
        {
          "id": -2006147,
          "resource_id": 227,
          "text": "వగర్చుతూ పరిగెత్తే గుర్రాల సాక్షిగా!"
        }
      ]
    },
    {
      "id": 6148,
      "verse_number": 2,
      "verse_key": "100:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 544,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَٱلْمُورِيَـٰتِ قَدْحًا",
      "page_number": 599,
      "juz_number": 30,
      "translations": [
        {
          "id": 407851,
          "resource_id": 85,
          "text": "and strike sparks with their hooves,"
        },
        {
          "id": 1550585,
          "resource_id": 831,
          "text": "Phir (apne tapon se) chingariyan jhaadte hain"
        },
        {
          "id": -1006148,
          "resource_id": "ur.maududi",
          "text": "پھر (اپنی ٹاپوں سے) چنگاریاں جھاڑتے ہیں"
        },
        {
          "id": -2006148,
          "resource_id": 227,
          "text": "తమ ఖురాల తట్టులతో అగ్నికణాలు లేపేవాటి;"
        }
      ]
    },
    {
      "id": 6149,
      "verse_number": 3,
      "verse_key": "100:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 544,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَٱلْمُغِيرَٰتِ صُبْحًا",
      "page_number": 599,
      "juz_number": 30,
      "translations": [
        {
          "id": 407852,
          "resource_id": 85,
          "text": "who make dawn raids,"
        },
        {
          "id": 1550586,
          "resource_id": 831,
          "text": "Phir subah sawere chapa marte hain"
        },
        {
          "id": -1006149,
          "resource_id": "ur.maududi",
          "text": "پھر صبح سویرے چھاپہ مارتے ہیں"
        },
        {
          "id": -2006149,
          "resource_id": 227,
          "text": "తెల్లవారుఝామున దాడి చేసేవాటి;"
        }
      ]
    },
    {
      "id": 6150,
      "verse_number": 4,
      "verse_key": "100:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 544,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَثَرْنَ بِهِۦ نَقْعًا",
      "page_number": 599,
      "juz_number": 30,
      "translations": [
        {
          "id": 407853,
          "resource_id": 85,
          "text": "raising a cloud of dust,"
        },
        {
          "id": 1550587,
          "resource_id": 831,
          "text": "Phir is mauke par gard o gubar udatey hai"
        },
        {
          "id": -1006150,
          "resource_id": "ur.maududi",
          "text": "پھر اس موقع پر گرد و غبار اڑاتے ہیں"
        },
        {
          "id": -2006150,
          "resource_id": 227,
          "text": "(మేఘాల వంటి) దుమ్ము లేపుతూ;"
        }
      ]
    },
    {
      "id": 6151,
      "verse_number": 5,
      "verse_key": "100:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 544,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَوَسَطْنَ بِهِۦ جَمْعًا",
      "page_number": 599,
      "juz_number": 30,
      "translations": [
        {
          "id": 407854,
          "resource_id": 85,
          "text": "and plunging into the midst of the enemy,"
        },
        {
          "id": 1550588,
          "resource_id": 831,
          "text": "Phir isi halat mei kisi majmey ke andar ja ghustey hai"
        },
        {
          "id": -1006151,
          "resource_id": "ur.maududi",
          "text": "پھر اِسی حالت میں کسی مجمع کے اندر جا گھستے ہیں"
        },
        {
          "id": -2006151,
          "resource_id": 227,
          "text": "(శత్రువుల) సమూహంలో దూరిపోయే వాటి."
        }
      ]
    },
    {
      "id": 6152,
      "verse_number": 6,
      "verse_key": "100:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 544,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ ٱلْإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودٌ",
      "page_number": 599,
      "juz_number": 30,
      "translations": [
        {
          "id": 407855,
          "resource_id": 85,
          "text": "man is ungrateful to his Lord––"
        },
        {
          "id": 1550589,
          "resource_id": 831,
          "text": "Haqiqat yeh hai ke Insan apne Rubb ka bada nashukra hai"
        },
        {
          "id": -1006152,
          "resource_id": "ur.maududi",
          "text": "حقیقت یہ ہے کہ انسان اپنے رب کا بڑا ناشکرا ہے"
        },
        {
          "id": -2006152,
          "resource_id": 227,
          "text": "నిశ్చయంగా, మానవుడు తన ప్రభువు పట్ల ఎంతో కృతఘ్నుడు."
        }
      ]
    },
    {
      "id": 6153,
      "verse_number": 7,
      "verse_key": "100:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 544,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ",
      "page_number": 599,
      "juz_number": 30,
      "translations": [
        {
          "id": 407856,
          "resource_id": 85,
          "text": "and He is witness to this––"
        },
        {
          "id": 1550590,
          "resource_id": 831,
          "text": "Aur woh khud is par gawah hai"
        },
        {
          "id": -1006153,
          "resource_id": "ur.maududi",
          "text": "اور وہ خود اِس پر گواہ ہے"
        },
        {
          "id": -2006153,
          "resource_id": 227,
          "text": "మరియు నిశ్చయంగా, దీనికి స్వయంగా అతడే సాక్షి."
        }
      ]
    },
    {
      "id": 6154,
      "verse_number": 8,
      "verse_key": "100:8",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 544,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ",
      "page_number": 599,
      "juz_number": 30,
      "translations": [
        {
          "id": 407857,
          "resource_id": 85,
          "text": "he is truly excessive in his love of wealth."
        },
        {
          "id": 1550591,
          "resource_id": 831,
          "text": "Aur woh maal-o-daulat ki muhabbat mei buri tarah mubtala hai"
        },
        {
          "id": -1006154,
          "resource_id": "ur.maududi",
          "text": "اور وہ مال و دولت کی محبت میں بری طرح مبتلا ہے"
        },
        {
          "id": -2006154,
          "resource_id": 227,
          "text": "మరియు నిశ్చయంగా, అతడు సిరిసంపదల వ్యామోహంలో పూర్తిగా మునిగి ఉన్నాడు."
        }
      ]
    },
    {
      "id": 6155,
      "verse_number": 9,
      "verse_key": "100:9",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 544,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ",
      "page_number": 599,
      "juz_number": 30,
      "translations": [
        {
          "id": 407858,
          "resource_id": 85,
          "text": "Does he not know that when the contents of graves burst forth,"
        },
        {
          "id": 1550592,
          "resource_id": 831,
          "text": "To kya woh us waqt ko nahin janta jab qabron mein jo kuch (madfun) hai usey nikal liya jayega"
        },
        {
          "id": -1006155,
          "resource_id": "ur.maududi",
          "text": "تو کیا وہ اُس حقیقت کو نہیں جانتا جب قبروں میں جو کچھ (مدفون) ہے اُسے نکال لیا جائے گا"
        },
        {
          "id": -2006155,
          "resource_id": 227,
          "text": "ఏమిటి? అతనికి తెలియదా? గోరీలలో ఉన్నదంతా పెళ్ళగించి బయటికి తీయబడినప్పుడు;"
        }
      ]
    },
    {
      "id": 6156,
      "verse_number": 10,
      "verse_key": "100:10",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 544,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَحُصِّلَ مَا فِى ٱلصُّدُورِ",
      "page_number": 600,
      "juz_number": 30,
      "translations": [
        {
          "id": 407859,
          "resource_id": 85,
          "text": "when the secrets of hearts are uncovered, on that Day,"
        },
        {
          "id": 1550593,
          "resource_id": 831,
          "text": "Aur seeno mein jo kuch (makhfi) hai usey baramad karke uski jaanch padtal ki jayegi"
        },
        {
          "id": -1006156,
          "resource_id": "ur.maududi",
          "text": "اور سینوں میں جو کچھ (مخفی) ہے اُسے برآمد کر کے اس کی جانچ پڑتال کی جائے گی؟"
        },
        {
          "id": -2006156,
          "resource_id": 227,
          "text": "మరియు (మానవుల) హృదయాలలోని విషయాలన్నీ వెల్లడి చేయబడినప్పుడు;"
        }
      ]
    },
    {
      "id": 6157,
      "verse_number": 11,
      "verse_key": "100:11",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 544,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍ لَّخَبِيرٌۢ",
      "page_number": 600,
      "juz_number": 30,
      "translations": [
        {
          "id": 407860,
          "resource_id": 85,
          "text": "their Lord will be fully aware of them all?"
        },
        {
          "id": 1550594,
          "resource_id": 831,
          "text": "Yaqeenan unka Rubb us roz unse khoob bakhabar hoga"
        },
        {
          "id": -1006157,
          "resource_id": "ur.maududi",
          "text": "یقیناً اُن کا رب اُس روز اُن سے خوب باخبر ہوگا"
        },
        {
          "id": -2006157,
          "resource_id": 227,
          "text": "నిశ్చయంగా, ఆ రోజున వారి ప్రభువు వారిని గురించి అంతా తెలుసుకొని ఉంటాడని!"
        }
      ]
    }
  ]
}