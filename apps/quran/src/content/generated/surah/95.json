  "verses": [
    {
      "id": 6099,
      "verse_number": 1,
      "verse_key": "95:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 539,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلتِّينِ وَٱلزَّيْتُونِ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407802,
          "resource_id": 85,
          "text": "By the fig, by the olive,"
        },
        {
          "id": 1550536,
          "resource_id": 831,
          "text": "Kasam hai Injir(fig) ki aur Zaitun ki"
        },
        {
          "id": -1006099,
          "resource_id": "ur.maududi",
          "text": "قسم ہے انجیر اور زیتون کی"
        },
        {
          "id": -2006099,
          "resource_id": 227,
          "text": "అంజూరం (అత్తిపండు) మరియు జైతూన్ సాక్షిగా!"
        }
      ]
    },
    {
      "id": 6100,
      "verse_number": 2,
      "verse_key": "95:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 539,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَطُورِ سِينِينَ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407803,
          "resource_id": 85,
          "text": "by Mount Sinai,"
        },
        {
          "id": 1550537,
          "resource_id": 831,
          "text": "Aur Tur-e-sina (Mount Sinai)"
        },
        {
          "id": -1006100,
          "resource_id": "ur.maududi",
          "text": "اور طور سینا کی"
        },
        {
          "id": -2006100,
          "resource_id": 227,
          "text": "సీనాయ్ (తూర్) కొండ సాక్షిగా!"
        }
      ]
    },
    {
      "id": 6101,
      "verse_number": 3,
      "verse_key": "95:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 539,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَهَـٰذَا ٱلْبَلَدِ ٱلْأَمِينِ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407804,
          "resource_id": 85,
          "text": "by this safe town,"
        },
        {
          "id": 1550538,
          "resource_id": 831,
          "text": "Aur is pur-aman shehar (Makkah) ki"
        },
        {
          "id": -1006101,
          "resource_id": "ur.maududi",
          "text": "اور اِس پرامن شہر (مکہ) کی"
        },
        {
          "id": -2006101,
          "resource_id": 227,
          "text": "ఈ శాంతి నగరం (మక్కా) సాక్షిగా!"
        }
      ]
    },
    {
      "id": 6102,
      "verse_number": 4,
      "verse_key": "95:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 539,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407805,
          "resource_id": 85,
          "text": "We create man in the finest state"
        },
        {
          "id": 1550539,
          "resource_id": 831,
          "text": "Humne Insan ko behtarin saakht par paida kiya"
        },
        {
          "id": -1006102,
          "resource_id": "ur.maududi",
          "text": "ہم نے انسان کو بہترین ساخت پر پیدا کیا"
        },
        {
          "id": -2006102,
          "resource_id": 227,
          "text": "వాస్తవంగా! మేము మానవుడిని సర్వశ్రేష్ఠమైన ఆకారంలో సృష్టించాము."
        }
      ]
    },
    {
      "id": 6103,
      "verse_number": 5,
      "verse_key": "95:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 539,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ رَدَدْنَـٰهُ أَسْفَلَ سَـٰفِلِينَ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407806,
          "resource_id": 85,
          "text": "then reduce him to the lowest of the low,"
        },
        {
          "id": 1550540,
          "resource_id": 831,
          "text": "Phir usey ulta pher kar humne sab neechon se neech kar diya"
        },
        {
          "id": -1006103,
          "resource_id": "ur.maududi",
          "text": "پھر اُسے الٹا پھیر کر ہم نے سب نیچوں سے نیچ کر دیا"
        },
        {
          "id": -2006103,
          "resource_id": 227,
          "text": "తరువాత మేము అతన్ని దిగజార్చి అధమాతి - అధమమైన స్థితికి మార్చాము."
        }
      ]
    },
    {
      "id": 6104,
      "verse_number": 6,
      "verse_key": "95:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 539,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407807,
          "resource_id": 85,
          "text": "except those who believe and do good deeds–– they will have an unfailing reward."
        },
        {
          "id": 1550541,
          "resource_id": 831,
          "text": "Siwaye un logon ke jo iman laye aur neik amal karte rahey kay unke liye kabhi khatam na hone wala ajar hai"
        },
        {
          "id": -1006104,
          "resource_id": "ur.maududi",
          "text": "سوائے اُن لوگوں کے جو ایمان لائے اور نیک عمل کرتے رہے کہ ان کے لیے کبھی ختم نہ ہونے والا اجر ہے"
        },
        {
          "id": -2006104,
          "resource_id": 227,
          "text": "కాని విశ్వసించి, సత్కార్యాలు చేసేవారు తప్ప! ఎందుకంటే అలాంటి వారికి అంతులేని ప్రతిఫలం ఉంది."
        }
      ]
    },
    {
      "id": 6105,
      "verse_number": 7,
      "verse_key": "95:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 539,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407808,
          "resource_id": 85,
          "text": "After this, what makes you [man] deny the Judgement?"
        },
        {
          "id": 1550542,
          "resource_id": 831,
          "text": "Pas (aey nabi) iske baad kaun jaza o saza ke maamle mei tumko jhutla sakta hai"
        },
        {
          "id": -1006105,
          "resource_id": "ur.maududi",
          "text": "پس (اے نبیؐ) اس کے بعد کون جزا و سزا کے معاملہ میں تم کو جھٹلا سکتا ہے؟"
        },
        {
          "id": -2006105,
          "resource_id": 227,
          "text": "అయితే (ఓ మానవుడా!) దీని తరువాత కూడా నీవు ఎందుకు ప్రతిఫలదినాన్ని తిరస్కరిస్తున్నావు?"
        }
      ]
    },
    {
      "id": 6106,
      "verse_number": 8,
      "verse_key": "95:8",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 539,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَـٰكِمِينَ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407809,
          "resource_id": 85,
          "text": "Is God not the most decisive of judges?"
        },
        {
          "id": 1550543,
          "resource_id": 831,
          "text": "Kya Allah sab hakimon se bada hakim nahin hai"
        },
        {
          "id": -1006106,
          "resource_id": "ur.maududi",
          "text": "کیا اللہ سب حاکموں سے بڑا حاکم نہیں ہے؟"
        },
        {
          "id": -2006106,
          "resource_id": 227,
          "text": "ఏమీ? అల్లాహ్ న్యాయాధిపతులలోకెల్లా సర్వోత్తమ న్యాయాధిపతి కాడా?"
        }
      ]
    }
  ]
}