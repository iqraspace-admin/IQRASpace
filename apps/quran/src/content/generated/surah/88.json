{
  "syncedAt": "2026-08-31T09:57:50.098Z",
  "chapter": {
    "id": 88,
    "revelation_place": "makkah",
    "revelation_order": 68,
    "bismillah_pre": true,
    "name_simple": "Al-Ghashiyah",
    "name_complex": "Al-Ghāshiyah",
    "name_arabic": "الغاشية",
    "verses_count": 26,
    "pages": [
      592,
      592
    ],
    "translated_name": {
      "language_name": "english",
      "name": "The Overwhelming"
    }
  },
  "verses": [
    {
      "id": 5968,
      "verse_number": 1,
      "verse_key": "88:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 532,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَـٰشِيَةِ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407671,
          "resource_id": 85,
          "text": "Have you heard tell [Prophet] about the Overwhelming Event?"
        },
        {
          "id": 1550405,
          "resource_id": 831,
          "text": "Kya tumhein us chaa janey wali aafat ki khabar pahunchi hai"
        },
        {
          "id": -1005968,
          "resource_id": "ur.maududi",
          "text": "کیا تمہیں اُس چھا جانے والی آفت کی خبر پہنچی ہے؟"
        },
        {
          "id": -2005968,
          "resource_id": 227,
          "text": "హఠాత్తుగా ఆసన్నమయ్యే ఆ విపత్తు (పునరుత్థాన దినపు) సమాచారం నీకు అందిందా?"
        }
      ]
    },
    {
      "id": 5969,
      "verse_number": 2,
      "verse_key": "88:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 532,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وُجُوهٌ يَوْمَئِذٍ خَـٰشِعَةٌ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407672,
          "resource_id": 85,
          "text": "On that Day, there will be downcast faces,"
        },
        {
          "id": 1550406,
          "resource_id": 831,
          "text": "Kuch chehrey us roz khauff zada hongey"
        },
        {
          "id": -1005969,
          "resource_id": "ur.maududi",
          "text": "کچھ چہرے اُس روز خوف زدہ ہونگے"
        },
        {
          "id": -2005969,
          "resource_id": 227,
          "text": "కొన్ని ముఖాలు ఆ రోజు వాలి (క్రుంగి) పోయి ఉంటాయి."
        }
      ]
    },
    {
      "id": 5970,
      "verse_number": 3,
      "verse_key": "88:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 532,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَامِلَةٌ نَّاصِبَةٌ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407673,
          "resource_id": 85,
          "text": "toiling and weary,"
        },
        {
          "id": 1550407,
          "resource_id": 831,
          "text": "Sakht mashakkat kar rahe hongey"
        },
        {
          "id": -1005970,
          "resource_id": "ur.maududi",
          "text": "سخت مشقت کر رہے ہونگے"
        },
        {
          "id": -2005970,
          "resource_id": 227,
          "text": "(ప్రపంచంలోని వృథా) శ్రమకు, (పరలోకంలో జరిగే) అవమానానికి,"
        }
      ]
    },
    {
      "id": 5971,
      "verse_number": 4,
      "verse_key": "88:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 532,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "تَصْلَىٰ نَارًا حَامِيَةً",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407674,
          "resource_id": 85,
          "text": "as they enter the blazing Fire"
        },
        {
          "id": 1550408,
          "resource_id": 831,
          "text": "Thakey jatey hongey, shadeed aag mei jhulas rahe hongey"
        },
        {
          "id": -1005971,
          "resource_id": "ur.maududi",
          "text": "تھکے جاتے ہونگے، شدید آگ میں جھلس رہے ہونگے"
        },
        {
          "id": -2005971,
          "resource_id": 227,
          "text": "వారు దహించే అగ్నిలో పడి కాలుతారు."
        }
      ]
    },
    {
      "id": 5972,
      "verse_number": 5,
      "verse_key": "88:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 532,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407675,
          "resource_id": 85,
          "text": "and are forced to drink from a boiling spring,"
        },
        {
          "id": 1550409,
          "resource_id": 831,
          "text": "khaultey(boiling) huey chashmey(spring) ka paani unhei peene ko diya jaeyga"
        },
        {
          "id": -1005972,
          "resource_id": "ur.maududi",
          "text": "کھولتے ہوئے چشمے کا پانی انہیں پینے کو دیا جائے گا"
        },
        {
          "id": -2005972,
          "resource_id": 227,
          "text": "వారికి సలసల కాగే చెలమ నీరు త్రాగటానికి ఇవ్వబడుతుంది."
        }
      ]
    },
    {
      "id": 5973,
      "verse_number": 6,
      "verse_key": "88:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 532,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407676,
          "resource_id": 85,
          "text": "with no food for them except bitter dry thorns"
        },
        {
          "id": 1550410,
          "resource_id": 831,
          "text": "khar-dar(kaante-daar) sukhi ghaans ke siwa koi khana unke liye na hoga"
        },
        {
          "id": -1005973,
          "resource_id": "ur.maududi",
          "text": "خار دار سوکھی گھاس کے سوا کوئی کھانا اُن کے لیے نہ ہوگا"
        },
        {
          "id": -2005973,
          "resource_id": 227,
          "text": "వారికి చేదు ముళ్ళగడ్డ (దరీఅ) తప్ప మరొక ఆహారం ఉండదు."
        }
      ]
    },
    {
      "id": 5974,
      "verse_number": 7,
      "verse_key": "88:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 532,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407677,
          "resource_id": 85,
          "text": "that neither nourish nor satisfy hunger."
        },
        {
          "id": 1550411,
          "resource_id": 831,
          "text": "Jo na mota karey na bhook mitaye"
        },
        {
          "id": -1005974,
          "resource_id": "ur.maududi",
          "text": "جو نہ موٹا کرے نہ بھوک مٹائے"
        },
        {
          "id": -2005974,
          "resource_id": 227,
          "text": "అది వారికి బలమూ నియ్యదు మరియు ఆకలీ తీర్చదు!"
        }
      ]
    },
    {
      "id": 5975,
      "verse_number": 8,
      "verse_key": "88:8",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 532,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407678,
          "resource_id": 85,
          "text": "On that Day there will also be faces radiant with bliss,"
        },
        {
          "id": 1550412,
          "resource_id": 831,
          "text": "kuch chehrey us roz ba-raunak hongey"
        },
        {
          "id": -1005975,
          "resource_id": "ur.maududi",
          "text": "کچھ چہرے اُس روز با رونق ہوں گے"
        },
        {
          "id": -2005975,
          "resource_id": 227,
          "text": "ఆ రోజున, మరికొన్ని ముఖాలు కళకళలాడుతూ ఉంటాయి;"
        }
      ]
    },
    {
      "id": 5976,
      "verse_number": 9,
      "verse_key": "88:9",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 532,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لِّسَعْيِهَا رَاضِيَةٌ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407679,
          "resource_id": 85,
          "text": "well pleased with their labour,"
        },
        {
          "id": 1550413,
          "resource_id": 831,
          "text": "Apne kar-guzari par khush hongey"
        },
        {
          "id": -1005976,
          "resource_id": "ur.maududi",
          "text": "اپنی کار گزاری پر خوش ہونگے"
        },
        {
          "id": -2005976,
          "resource_id": 227,
          "text": "తాము చేసుకున్న సత్కార్యాలకు (ఫలితాలకు) వారు సంతోషపడుతూ ఉంటారు."
        }
      ]
    },
    {
      "id": 5977,
      "verse_number": 10,
      "verse_key": "88:10",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 532,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فِى جَنَّةٍ عَالِيَةٍ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407680,
          "resource_id": 85,
          "text": "in a lofty garden,"
        },
        {
          "id": 1550414,
          "resource_id": 831,
          "text": "Aali muqaam jannat mein hongey"
        },
        {
          "id": -1005977,
          "resource_id": "ur.maududi",
          "text": "عالی مقام جنت میں ہوں گے"
        },
        {
          "id": -2005977,
          "resource_id": 227,
          "text": "అత్యున్నతమైన స్వర్గవనంలో."
        }
      ]
    },
    {
      "id": 5978,
      "verse_number": 11,
      "verse_key": "88:11",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 532,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَّا تَسْمَعُ فِيهَا لَـٰغِيَةً",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407681,
          "resource_id": 85,
          "text": "where they will hear no idle talk,"
        },
        {
          "id": 1550415,
          "resource_id": 831,
          "text": "koi behuda baat wahan na sunengey"
        },
        {
          "id": -1005978,
          "resource_id": "ur.maududi",
          "text": "کوئی بیہودہ بات وہاں نہ سنیں گے"
        },
        {
          "id": -2005978,
          "resource_id": 227,
          "text": "అందులో వారు ఎలాంటి వృథా మాటలు వినరు."
        }
      ]
    },
    {
      "id": 5979,
      "verse_number": 12,
      "verse_key": "88:12",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 532,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فِيهَا عَيْنٌ جَارِيَةٌ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407682,
          "resource_id": 85,
          "text": "with a flowing spring,"
        },
        {
          "id": 1550416,
          "resource_id": 831,
          "text": "Usmein chasmey rawan hongey"
        },
        {
          "id": -1005979,
          "resource_id": "ur.maududi",
          "text": "اُس میں چشمے رواں ہونگے"
        },
        {
          "id": -2005979,
          "resource_id": 227,
          "text": "అందులో ప్రవహించే సెలయేళ్ళు ఉంటాయి;"
        }
      ]
    },
    {
      "id": 5980,
      "verse_number": 13,
      "verse_key": "88:13",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 532,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فِيهَا سُرُرٌ مَّرْفُوعَةٌ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407683,
          "resource_id": 85,
          "text": "raised couches,"
        },
        {
          "id": 1550417,
          "resource_id": 831,
          "text": "Uske andar unchi masnadein hongi"
        },
        {
          "id": -1005980,
          "resource_id": "ur.maududi",
          "text": "اُس کے اندر اونچی مسندیں ہوں گی"
        },
        {
          "id": -2005980,
          "resource_id": 227,
          "text": "అందులో ఎత్తైన ఆసనాలు ఉంటాయి;"
        }
      ]
    },
    {
      "id": 5981,
      "verse_number": 14,
      "verse_key": "88:14",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 532,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَكْوَابٌ مَّوْضُوعَةٌ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407684,
          "resource_id": 85,
          "text": "goblets placed before them,"
        },
        {
          "id": 1550418,
          "resource_id": 831,
          "text": "Sagar rakhey huey hongey"
        },
        {
          "id": -1005981,
          "resource_id": "ur.maududi",
          "text": "ساغر رکھے ہوئے ہوں گے"
        },
        {
          "id": -2005981,
          "resource_id": 227,
          "text": "మరియు పేర్చబడిన (మధు) పాత్రలు;"
        }
      ]
    },
    {
      "id": 5982,
      "verse_number": 15,
      "verse_key": "88:15",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 532,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَنَمَارِقُ مَصْفُوفَةٌ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407685,
          "resource_id": 85,
          "text": "cushions set in rows,"
        },
        {
          "id": 1550419,
          "resource_id": 831,
          "text": "gaon takiyon(cushions arrayed) ke qatarein lagi hongi"
        },
        {
          "id": -1005982,
          "resource_id": "ur.maududi",
          "text": "گاؤ تکیوں کی قطاریں لگی ہوں گی"
        },
        {
          "id": -2005982,
          "resource_id": 227,
          "text": "మరియు వరుసలుగా వేయబడిన, దిండ్లు;"
        }
      ]
    },
    {
      "id": 5983,
      "verse_number": 16,
      "verse_key": "88:16",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 532,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَزَرَابِىُّ مَبْثُوثَةٌ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407686,
          "resource_id": 85,
          "text": "and carpets spread."
        },
        {
          "id": 1550420,
          "resource_id": 831,
          "text": "Aur nafees farsh bichey huey hongey"
        },
        {
          "id": -1005983,
          "resource_id": "ur.maududi",
          "text": "اور نفیس فرش بچھے ہوئے ہوں گے"
        },
        {
          "id": -2005983,
          "resource_id": 227,
          "text": "మరియు పరచబడిన నాణ్యమైన తివాచీలు."
        }
      ]
    },
    {
      "id": 5984,
      "verse_number": 17,
      "verse_key": "88:17",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 532,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407687,
          "resource_id": 85,
          "text": "Do the disbelievers not see how rain clouds are formed <sup foot_note=77646>1</sup>"
        },
        {
          "id": 1550421,
          "resource_id": 831,
          "text": "(yeh log nahin mantey) to kya yeh unton ko nahin dekhtey ke kaisey banaye gaye"
        },
        {
          "id": -1005984,
          "resource_id": "ur.maududi",
          "text": "(یہ لوگ نہیں مانتے) تو کیا یہ اونٹوں کو نہیں دیکھتے کہ کیسے بنائے گئے؟"
        },
        {
          "id": -2005984,
          "resource_id": 227,
          "text": "ఏమిటీ? వారు ఒంటెల వైపు చూడరా? అవి ఎలా సృష్టించబడ్డాయో?"
        }
      ]
    },
    {
      "id": 5985,
      "verse_number": 18,
      "verse_key": "88:18",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 532,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407688,
          "resource_id": 85,
          "text": "how the heavens are lifted,"
        },
        {
          "id": 1550422,
          "resource_id": 831,
          "text": "Asman ko nahin dekhte ke kaise uthaya gaya"
        },
        {
          "id": -1005985,
          "resource_id": "ur.maududi",
          "text": "آسمان کو نہیں دیکھتے کہ کیسے اٹھایا گیا؟"
        },
        {
          "id": -2005985,
          "resource_id": 227,
          "text": "మరియు ఆకాశం వైపుకు (చూడరా)? అది ఎలా పైకి ఎత్తబడి ఉందో?"
        }
      ]
    },
    {
      "id": 5986,
      "verse_number": 19,
      "verse_key": "88:19",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 532,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407689,
          "resource_id": 85,
          "text": "how the mountains are raised high,"
        },
        {
          "id": 1550423,
          "resource_id": 831,
          "text": "Pahadon ko nahin dekhtey ke kaisey jamaye gaye"
        },
        {
          "id": -1005986,
          "resource_id": "ur.maududi",
          "text": "پہاڑوں کو نہیں دیکھتے کہ کیسے جمائے گئے؟"
        },
        {
          "id": -2005986,
          "resource_id": 227,
          "text": "మరియు కొండల వైపుకు చూడరా?అవి ఎలా గట్టిగా నాటబడి ఉన్నాయో?"
        }
      ]
    },
    {
      "id": 5987,
      "verse_number": 20,
      "verse_key": "88:20",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 532,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407690,
          "resource_id": 85,
          "text": "how the earth is spread out?"
        },
        {
          "id": 1550424,
          "resource_id": 831,
          "text": "Aur zameen ko nahin dekhtey ke kaisey bichayi gayi"
        },
        {
          "id": -1005987,
          "resource_id": "ur.maududi",
          "text": "اور زمین کو نہیں دیکھتے کہ کیسے بچھائی گئی؟"
        },
        {
          "id": -2005987,
          "resource_id": 227,
          "text": "మరియు భూమి వైపుకు (చూడరా)? అది ఎలా విశాలంగా పరచబడి ఉందో?"
        }
      ]
    },
    {
      "id": 5988,
      "verse_number": 21,
      "verse_key": "88:21",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 532,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407691,
          "resource_id": 85,
          "text": "So [Prophet] warn them: your only task is to give warning,"
        },
        {
          "id": 1550425,
          "resource_id": 831,
          "text": "Acha to ( aey nabi) nasihat kiye jao, tum bas nasihat hi karne wale ho"
        },
        {
          "id": -1005988,
          "resource_id": "ur.maududi",
          "text": "اچھا تو (اے نبیؐ) نصیحت کیے جاؤ، تم بس نصیحت ہی کرنے والے ہو"
        },
        {
          "id": -2005988,
          "resource_id": 227,
          "text": "కావున (ఓ ముహమ్మద్!) నీవు హితోపదేశం చేస్తూ ఉండు, వాస్తవానికి నీవు కేవలం హితోపదేశం చేసే వాడవు మాత్రమే!"
        }
      ]
    },
    {
      "id": 5989,
      "verse_number": 22,
      "verse_key": "88:22",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 532,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407692,
          "resource_id": 85,
          "text": "you are not there to control them."
        },
        {
          "id": 1550426,
          "resource_id": 831,
          "text": "kuch inpar jabr karne wale nahin ho"
        },
        {
          "id": -1005989,
          "resource_id": "ur.maududi",
          "text": "کچھ ان پر جبر کرنے والے نہیں ہو"
        },
        {
          "id": -2005989,
          "resource_id": 227,
          "text": "నీవు వారిని (విశ్వసించమని) బలవంతం చేసేవాడవు కావు."
        }
      ]
    },
    {
      "id": 5990,
      "verse_number": 23,
      "verse_key": "88:23",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 532,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407693,
          "resource_id": 85,
          "text": "As for those who turn away and disbelieve,"
        },
        {
          "id": 1550427,
          "resource_id": 831,
          "text": "Albatta jo shaks mooh modega aur inkar karega"
        },
        {
          "id": -1005990,
          "resource_id": "ur.maududi",
          "text": "البتہ جو شخص منہ موڑے گا اور انکار کرے گا"
        },
        {
          "id": -2005990,
          "resource_id": 227,
          "text": "ఇక, ఎవడైతే వెనుదిరుగుతాడో మరియు సత్యాన్ని తిరస్కరిస్తాడో!"
        }
      ]
    },
    {
      "id": 5991,
      "verse_number": 24,
      "verse_key": "88:24",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 532,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407694,
          "resource_id": 85,
          "text": "God will inflict the greatest torment upon them."
        },
        {
          "id": 1550428,
          "resource_id": 831,
          "text": "To Allah usko bhaari saza dega"
        },
        {
          "id": -1005991,
          "resource_id": "ur.maududi",
          "text": "تو اللہ اس کو بھاری سزا دے گا"
        },
        {
          "id": -2005991,
          "resource_id": 227,
          "text": "అప్పుడు అతనికి అల్లాహ్ ఘోరశిక్ష విధిస్తాడు."
        }
      ]
    },
    {
      "id": 5992,
      "verse_number": 25,
      "verse_key": "88:25",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 532,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ إِلَيْنَآ إِيَابَهُمْ",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407695,
          "resource_id": 85,
          "text": "It is to Us they will return,"
        },
        {
          "id": 1550429,
          "resource_id": 831,
          "text": "In logon ko palatna hamari taraf hi hai"
        },
        {
          "id": -1005992,
          "resource_id": "ur.maududi",
          "text": "اِن لوگوں کو پلٹنا ہماری طرف ہی ہے"
        },
        {
          "id": -2005992,
          "resource_id": 227,
          "text": "నిశ్చయంగా, మా వైపునకే వారి మరలింపు ఉంది;"
        }
      ]
    },
    {
      "id": 5993,
      "verse_number": 26,
      "verse_key": "88:26",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 532,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم",
      "page_number": 592,
      "juz_number": 30,
      "translations": [
        {
          "id": 407696,
          "resource_id": 85,
          "text": "and then it is for Us to call them to account."
        },
        {
          "id": 1550430,
          "resource_id": 831,
          "text": "Phir inka hisab lena hamare hi zimmey hai"
        },
        {
          "id": -1005993,
          "resource_id": "ur.maududi",
          "text": "پھر اِن کا حساب لینا ہمارے ہی ذمہ ہے"
        },
        {
          "id": -2005993,
          "resource_id": 227,
          "text": "ఆ తర్వాత నిశ్చయంగా, వారి లెక్క తీసుకునేదీ మేమే!"
        }
      ]
    }
  ]
}