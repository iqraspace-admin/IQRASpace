{
  "syncedAt": "2026-08-31T09:57:53.530Z",
  "chapter": {
    "id": 96,
    "revelation_place": "makkah",
    "revelation_order": 1,
    "bismillah_pre": true,
    "name_simple": "Al-'Alaq",
    "name_complex": "Al-`Alaq",
    "name_arabic": "العلق",
    "verses_count": 19,
    "pages": [
      597,
      597
    ],
    "translated_name": {
      "language_name": "english",
      "name": "The Clot"
    }
  },
  "verses": [
    {
      "id": 6107,
      "verse_number": 1,
      "verse_key": "96:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407810,
          "resource_id": 85,
          "text": "Read! In the name of your Lord who created:"
        },
        {
          "id": 1550544,
          "resource_id": 831,
          "text": "Padho (Aey Nabi) apne Rubb ke naam ke saath Jisne paida kiya"
        },
        {
          "id": -1006107,
          "resource_id": "ur.maududi",
          "text": "پڑھو (اے نبیؐ) اپنے رب کے نام کے ساتھ جس نے پیدا کیا"
        },
        {
          "id": -2006107,
          "resource_id": 227,
          "text": "చదువు! నీ ప్రభువు పేరుతో, ఆయనే (సర్వాన్ని) సృష్టించాడు!"
        }
      ]
    },
    {
      "id": 6108,
      "verse_number": 2,
      "verse_key": "96:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407811,
          "resource_id": 85,
          "text": "He created man from a clinging form."
        },
        {
          "id": 1550545,
          "resource_id": 831,
          "text": "Jamey huey khoon ke ek lothdey se Insan ki takhliq ki"
        },
        {
          "id": -1006108,
          "resource_id": "ur.maududi",
          "text": "جمے ہوئے خون کے ایک لوتھڑے سے انسان کی تخلیق کی"
        },
        {
          "id": -2006108,
          "resource_id": 227,
          "text": "ఆయనే మానవుణ్ణి రక్తముద్దతో (జీవకణంతో) సృష్టించాడు."
        }
      ]
    },
    {
      "id": 6109,
      "verse_number": 3,
      "verse_key": "96:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407812,
          "resource_id": 85,
          "text": "Read! Your Lord is the Most Bountiful One"
        },
        {
          "id": 1550546,
          "resource_id": 831,
          "text": "Padho aur tumhara Rubb bada kareem hai"
        },
        {
          "id": -1006109,
          "resource_id": "ur.maududi",
          "text": "پڑھو، اور تمہارا رب بڑا کریم ہے"
        },
        {
          "id": -2006109,
          "resource_id": 227,
          "text": "చదువు! మరియు నీ ప్రభువు పరమదాత."
        }
      ]
    },
    {
      "id": 6110,
      "verse_number": 4,
      "verse_key": "96:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407813,
          "resource_id": 85,
          "text": "who taught by [means of] the pen,"
        },
        {
          "id": 1550547,
          "resource_id": 831,
          "text": "jisne qalam ke zariya se ilm sikhaya"
        },
        {
          "id": -1006110,
          "resource_id": "ur.maududi",
          "text": "جس نے قلم کے ذریعہ سے علم سکھایا"
        },
        {
          "id": -2006110,
          "resource_id": 227,
          "text": "ఆయన కలం ద్వారా నేర్పాడు."
        }
      ]
    },
    {
      "id": 6111,
      "verse_number": 5,
      "verse_key": "96:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407814,
          "resource_id": 85,
          "text": "who taught man what he did not know."
        },
        {
          "id": 1550548,
          "resource_id": 831,
          "text": "Insan ko woh ilm diya jisey woh na jaanta tha"
        },
        {
          "id": -1006111,
          "resource_id": "ur.maududi",
          "text": "انسان کو وہ علم دیا جسے وہ نہ جانتا تھا"
        },
        {
          "id": -2006111,
          "resource_id": 227,
          "text": "మానవుడు ఎరుగని జ్ఞానాన్ని అతనికి బోధించాడు."
        }
      ]
    },
    {
      "id": 6112,
      "verse_number": 6,
      "verse_key": "96:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407815,
          "resource_id": 85,
          "text": "But man exceeds all bounds"
        },
        {
          "id": 1550549,
          "resource_id": 831,
          "text": "Hargiz nahin, Insan sarkahshi karta hai"
        },
        {
          "id": -1006112,
          "resource_id": "ur.maududi",
          "text": "ہرگز نہیں، انسان سرکشی کرتا ہے"
        },
        {
          "id": -2006112,
          "resource_id": 227,
          "text": "అలా కాదు! వాస్తవానికి, మానవుడు తలబిరుసుతనంతో ప్రవర్తిస్తాడు."
        }
      ]
    },
    {
      "id": 6113,
      "verse_number": 7,
      "verse_key": "96:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407816,
          "resource_id": 85,
          "text": "when he thinks he is self-sufficient:"
        },
        {
          "id": 1550550,
          "resource_id": 831,
          "text": "Is bina par ke woh apne aap ko be niyaz dekhta hai"
        },
        {
          "id": -1006113,
          "resource_id": "ur.maududi",
          "text": "اِس بنا پر کہ وہ اپنے آپ کو بے نیاز دیکھتا ہے"
        },
        {
          "id": -2006113,
          "resource_id": 227,
          "text": "ఎందుకంటే, అతడు తనను తాను నిరపేక్షాపరుడిగా భావిస్తాడు."
        }
      ]
    },
    {
      "id": 6114,
      "verse_number": 8,
      "verse_key": "96:8",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407817,
          "resource_id": 85,
          "text": "[Prophet], all will return to your Lord."
        },
        {
          "id": 1550551,
          "resource_id": 831,
          "text": "(halaanke) palatna yaqeenan tere Rubb hi ki taraf hai"
        },
        {
          "id": -1006114,
          "resource_id": "ur.maududi",
          "text": "پلٹنا یقیناً تیرے رب ہی کی طرف ہے"
        },
        {
          "id": -2006114,
          "resource_id": 227,
          "text": "నిశ్చయంగా నీ ప్రభువు వైపునకే (అందరికీ) మరలి పోవలసి ఉంది."
        }
      ]
    },
    {
      "id": 6115,
      "verse_number": 9,
      "verse_key": "96:9",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407818,
          "resource_id": 85,
          "text": "Have you seen the man who forbids"
        },
        {
          "id": 1550552,
          "resource_id": 831,
          "text": "Tumne dekha us shaks ko"
        },
        {
          "id": -1006115,
          "resource_id": "ur.maududi",
          "text": "تم نے دیکھا اُس شخص کو"
        },
        {
          "id": -2006115,
          "resource_id": 227,
          "text": "నీవు నిరోధించే వ్యక్తిని చూశావా?"
        }
      ]
    },
    {
      "id": 6116,
      "verse_number": 10,
      "verse_key": "96:10",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَبْدًا إِذَا صَلَّىٰٓ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407819,
          "resource_id": 85,
          "text": "[Our] servant to pray?"
        },
        {
          "id": 1550553,
          "resource_id": 831,
          "text": "Jo ek banday ko mana karta hai jabke woh namaz padta ho"
        },
        {
          "id": -1006116,
          "resource_id": "ur.maududi",
          "text": "جو ایک بندے کو منع کرتا ہے جبکہ وہ نماز پڑھتا ہو؟"
        },
        {
          "id": -2006116,
          "resource_id": 227,
          "text": "నమాజ్ చేసే (అల్లాహ్) దాసుణ్ణి?"
        }
      ]
    },
    {
      "id": 6117,
      "verse_number": 11,
      "verse_key": "96:11",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407820,
          "resource_id": 85,
          "text": "Have you seen whether he is rightly guided,"
        },
        {
          "id": 1550554,
          "resource_id": 831,
          "text": "Tumhara kya khayal hai agar (woh banda) raah e raast par ho"
        },
        {
          "id": -1006117,
          "resource_id": "ur.maududi",
          "text": "تمہارا کیا خیال ہے اگر (وہ بندہ) راہ راست پر ہو"
        },
        {
          "id": -2006117,
          "resource_id": 227,
          "text": "ఒకవేళ అతను (ముహమ్మద్!) సన్మార్గంపై ఉంటే నీ అభిప్రాయమేమిటి?"
        }
      ]
    },
    {
      "id": 6118,
      "verse_number": 12,
      "verse_key": "96:12",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407821,
          "resource_id": 85,
          "text": "or encourages true piety?"
        },
        {
          "id": 1550555,
          "resource_id": 831,
          "text": "ya parhezgari ki talqeen karta ho"
        },
        {
          "id": -1006118,
          "resource_id": "ur.maududi",
          "text": "یا پرہیزگاری کی تلقین کرتا ہو؟"
        },
        {
          "id": -2006118,
          "resource_id": 227,
          "text": "ఇంకా, దైవభీతిని గురించి ఆదేశిస్తూ ఉంటే?"
        }
      ]
    },
    {
      "id": 6119,
      "verse_number": 13,
      "verse_key": "96:13",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407822,
          "resource_id": 85,
          "text": "Have you seen whether he denies the truth and turns away from it?"
        },
        {
          "id": 1550556,
          "resource_id": 831,
          "text": "Tumhara kya khayal hai agar (yeh mana karne wala shakhs haqq ko) jhutlata aur mooh moadta ho"
        },
        {
          "id": -1006119,
          "resource_id": "ur.maududi",
          "text": "تمہارا کیا خیال ہے اگر (یہ منع کرنے والا شخص حق کو) جھٹلاتا اور منہ موڑتا ہو؟"
        },
        {
          "id": -2006119,
          "resource_id": 227,
          "text": "ఒకవేళ (ఆ నిరోధించే) వాడు సత్యాన్ని తిరస్కరించేవాడు మరియు సన్మార్గం నుండి విముఖుడయ్యేవాడైతే?"
        }
      ]
    },
    {
      "id": 6120,
      "verse_number": 14,
      "verse_key": "96:14",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407823,
          "resource_id": 85,
          "text": "Does he not realize that God sees all?"
        },
        {
          "id": 1550557,
          "resource_id": 831,
          "text": "Kya woh nahin jaanta ke Allah dekh raha hai"
        },
        {
          "id": -1006120,
          "resource_id": "ur.maududi",
          "text": "کیا وہ نہیں جانتا کہ اللہ دیکھ رہا ہے؟"
        },
        {
          "id": -2006120,
          "resource_id": 227,
          "text": "వాస్తవానికి, అల్లాహ్ అంతా చూస్తున్నాడని అతనికి తెలియదా?"
        }
      ]
    },
    {
      "id": 6121,
      "verse_number": 15,
      "verse_key": "96:15",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407824,
          "resource_id": 85,
          "text": "No! If he does not stop, We shall drag him by his forehead––"
        },
        {
          "id": 1550558,
          "resource_id": 831,
          "text": "Hargiz nahin agar woh baaz na aaya to hum uski peshani ke baal pakad kar usey khinchey ge"
        },
        {
          "id": -1006121,
          "resource_id": "ur.maududi",
          "text": "ہرگز نہیں، اگر وہ باز نہ آیا تو ہم اس کی پیشانی کے بال پکڑ کر اسے کھینچیں گے"
        },
        {
          "id": -2006121,
          "resource_id": 227,
          "text": "అలా కాదు! ఒకవేళ అతడు మానుకోకపోతే, మేము అతడిని, నుదుటి జుట్టు వెంట్రుకలను పట్టి ఈడుస్తాము."
        }
      ]
    },
    {
      "id": 6122,
      "verse_number": 16,
      "verse_key": "96:16",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "نَاصِيَةٍ كَـٰذِبَةٍ خَاطِئَةٍ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407825,
          "resource_id": 85,
          "text": "his lying, sinful forehead."
        },
        {
          "id": 1550559,
          "resource_id": 831,
          "text": "Us peshani ko jo jhooti aur sakth khatakaar hai"
        },
        {
          "id": -1006122,
          "resource_id": "ur.maududi",
          "text": "اُس پیشانی کو جو جھوٹی اور سخت خطا کار ہے"
        },
        {
          "id": -2006122,
          "resource_id": 227,
          "text": "అది అబద్ధాలలో, అపరాధాలలో మునిగివున్న నుదురు!"
        }
      ]
    },
    {
      "id": 6123,
      "verse_number": 17,
      "verse_key": "96:17",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 540,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَلْيَدْعُ نَادِيَهُۥ",
      "page_number": 597,
      "juz_number": 30,
      "translations": [
        {
          "id": 407826,
          "resource_id": 85,
          "text": "Let him summon his comrades;"
