      "page_number": 601,
      "juz_number": 30,
      "translations": [
        {
          "id": 407880,
          "resource_id": 85,
          "text": "By the declining day,"
        },
        {
          "id": 1550614,
          "resource_id": 831,
          "text": "Zamane ki qasam"
        },
        {
          "id": -1006177,
          "resource_id": "ur.maududi",
          "text": "زمانے کی قسم"
        },
        {
          "id": -2006177,
          "resource_id": 227,
          "text": "కాలం సాక్షిగా!"
        }
      ]
    },
    {
      "id": 6178,
      "verse_number": 2,
      "verse_key": "103:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 547,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ ٱلْإِنسَـٰنَ لَفِى خُسْرٍ",
      "page_number": 601,
      "juz_number": 30,
      "translations": [
        {
          "id": 407881,
          "resource_id": 85,
          "text": "man is [deep] in loss,"
        },
        {
          "id": 1550615,
          "resource_id": 831,
          "text": "Insan dar haqeeqat badey khasarey(nuksaan) mein hai"
        },
        {
          "id": -1006178,
          "resource_id": "ur.maududi",
          "text": "انسان درحقیقت بڑے خسارے میں ہے"
        },
        {
          "id": -2006178,
          "resource_id": 227,
          "text": "నిశ్చయంగా మానవుడు నష్టంలో ఉన్నాడు!"
        }
      ]
    },
    {
      "id": 6179,
      "verse_number": 3,
      "verse_key": "103:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 547,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ",
      "page_number": 601,
      "juz_number": 30,
      "translations": [
        {
          "id": 407882,
          "resource_id": 85,
          "text": "except for those who believe, do good deeds, urge one another to the truth, and urge one another to steadfastness."
        },
        {
          "id": 1550616,
          "resource_id": 831,
          "text": "Siwaye un logon ke jo iman laye aur neik aamal karte rahe aur ek dusrey ko haqq ki nasihat aur sabr ki talqeen karte rahe"
        },
        {
          "id": -1006179,
          "resource_id": "ur.maududi",
          "text": "سوائے اُن لوگوں کے جو ایمان لائے، اور نیک اعمال کرتے رہے، اور ایک دوسرے کو حق کی نصیحت اور صبر کی تلقین کرتے رہے"
        },
        {
          "id": -2006179,
          "resource_id": 227,
          "text": "కాని విశ్వసించి, సత్కార్యాలు చేసేవారు మరియు ఒకరికొకరు సత్యాన్ని బోధించుకునే వారు మరియు ఒకరికొకరు సహనాన్ని (స్థైర్యాన్ని) బోధించుకునే వారు తప్ప!"
        }
      ]
    }
  ]
}