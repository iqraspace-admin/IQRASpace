{
  "syncedAt": "2026-08-31T09:57:54.763Z",
  "chapter": {
    "id": 99,
    "revelation_place": "madinah",
    "revelation_order": 93,
    "bismillah_pre": true,
    "name_simple": "Az-Zalzalah",
    "name_complex": "Az-Zalzalah",
    "name_arabic": "الزلزلة",
    "verses_count": 8,
    "pages": [
      599,
      599
    ],
    "translated_name": {
      "language_name": "english",
      "name": "The Earthquake"
    }
  },
  "verses": [
    {
      "id": 6139,
      "verse_number": 1,
      "verse_key": "99:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 543,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا",
      "page_number": 599,
      "juz_number": 30,
      "translations": [
        {
          "id": 407842,
          "resource_id": 85,
          "text": "When the earth is shaken violently in its [last] quaking,"
        },
        {
          "id": 1550576,
          "resource_id": 831,
          "text": "Jab zameen apni puri shiddat kay saath hila daali jayegi"
        },
        {
          "id": -1006139,
          "resource_id": "ur.maududi",
          "text": "جب زمین اپنی پوری شدت کے ساتھ ہلا ڈالی جائے گی"
        },
        {
          "id": -2006139,
          "resource_id": 227,
          "text": "భూమి తన అతి తీవ్రమైన (అంతిమ) భూకంపంతో కంపింపజేయబడినప్పుడు!"
        }
      ]
    },
    {
      "id": 6140,
      "verse_number": 2,
      "verse_key": "99:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 543,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا",
      "page_number": 599,
      "juz_number": 30,
      "translations": [
        {
          "id": 407843,
          "resource_id": 85,
          "text": "when the earth throws out its burdens,"
        },
        {
          "id": 1550577,
          "resource_id": 831,
          "text": "Aur zameen apne andar kay sarey bojh nikal kar bahar daal degi"
        },
        {
          "id": -1006140,
          "resource_id": "ur.maududi",
          "text": "اور زمین اپنے اندر کے سارے بوجھ نکال کر باہر ڈال دے گی"
        },
        {
          "id": -2006140,
          "resource_id": 227,
          "text": "మరియు భూమి తన భారాన్నంతా తీసి బయట పడ వేసినప్పుడు!"
        }
      ]
    },
    {
      "id": 6141,
      "verse_number": 3,
      "verse_key": "99:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 543,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَقَالَ ٱلْإِنسَـٰنُ مَا لَهَا",
      "page_number": 599,
      "juz_number": 30,
      "translations": [
        {
          "id": 407844,
          "resource_id": 85,
          "text": "when man cries, ‘What is happening to it?’;"
        },
        {
          "id": 1550578,
          "resource_id": 831,
          "text": "Aur Insan kahega ke yeh isko kya ho raha hai"
        },
        {
          "id": -1006141,
          "resource_id": "ur.maududi",
          "text": "اور انسان کہے گا کہ یہ اِس کو کیا ہو رہا ہے"
        },
        {
          "id": -2006141,
          "resource_id": 227,
          "text": "మరియు మానవుడు: \"దీనికి ఏమయింది?\" అని అన్నప్పుడు."
        }
      ]
    },
    {
      "id": 6142,
      "verse_number": 4,
      "verse_key": "99:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 543,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَوْمَئِذٍ تُحَدِّثُ أَخْبَارَهَا",
      "page_number": 599,
      "juz_number": 30,
      "translations": [
        {
          "id": 407845,
          "resource_id": 85,
          "text": "on that Day, it will tell all"
        },
        {
          "id": 1550579,
          "resource_id": 831,
          "text": "Us roz woh apne (upar guzre huey) halaat bayan karegi"
        },
        {
          "id": -1006142,
          "resource_id": "ur.maududi",
          "text": "اُس روز وہ اپنے (اوپر گزرے ہوئے) حالات بیان کرے گی"
        },
        {
          "id": -2006142,
          "resource_id": 227,
          "text": "ఆ రోజు అది తన సమాచారాలను వివరిస్తుంది."
        }
      ]
    },
    {
      "id": 6143,
      "verse_number": 5,
      "verse_key": "99:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 543,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا",
      "page_number": 599,
      "juz_number": 30,
      "translations": [
        {
          "id": 407846,
          "resource_id": 85,
          "text": "because your Lord will inspire it [to do so]."
        },
        {
          "id": 1550580,
          "resource_id": 831,
          "text": "Kyunke tere Rubb ne usey (aisa karne ka) hukm diya hoga"
        },
        {
          "id": -1006143,
          "resource_id": "ur.maududi",
          "text": "کیونکہ تیرے رب نے اُسے (ایساکرنے کا) حکم دیا ہوگا"
        },
        {
          "id": -2006143,
          "resource_id": 227,
          "text": "ఎందుకంటే, నీ ప్రభువు దానిని ఆదేశించి ఉంటాడు."
        }
      ]
    },
    {
      "id": 6144,
      "verse_number": 6,
      "verse_key": "99:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 543,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَوْمَئِذٍ يَصْدُرُ ٱلنَّاسُ أَشْتَاتًا لِّيُرَوْا۟ أَعْمَـٰلَهُمْ",
      "page_number": 599,
      "juz_number": 30,
      "translations": [
        {
          "id": 407847,
          "resource_id": 85,
          "text": "On that Day, people will come forward in separate groups to be shown their deeds:"
        },
        {
          "id": 1550581,
          "resource_id": 831,
          "text": "Us roz log mutafarrik halat mein paltenge taakay unke aamal unko dikhaey jayein"
        },
        {
          "id": -1006144,
          "resource_id": "ur.maududi",
          "text": "اُس روز لوگ متفرق حالت میں پلٹیں گے تاکہ اُن کے اعمال اُن کو دکھائے جائیں"
        },
        {
          "id": -2006144,
          "resource_id": 227,
          "text": "ఆ రోజు ప్రజలు తమ తమ కర్మలు చూపించబడటానికి వేర్వేరు గుంపులలో వెళ్తారు."
        }
      ]
    },
    {
      "id": 6145,
      "verse_number": 7,
      "verse_key": "99:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 543,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُۥ",
      "page_number": 599,
      "juz_number": 30,
      "translations": [
        {
          "id": 407848,
          "resource_id": 85,
          "text": "whoever has done an atom’s-weight of good will see it,"
        },
        {
          "id": 1550582,
          "resource_id": 831,
          "text": "Phir jisne zarra barabar neki ki hogi woh usko dekh lega"
        },
        {
          "id": -1006145,
          "resource_id": "ur.maududi",
          "text": "پھر جس نے ذرہ برابر نیکی کی ہوگی وہ اس کو دیکھ لے گا"
        },
        {
          "id": -2006145,
          "resource_id": 227,
          "text": "అప్పుడు, ప్రతివాడు తాను, రవ్వంత (పరమాణువంత) మంచిని చేసి ఉన్నా, దానిని చూసుకుంటాడు."
        }
      ]
    },
    {
      "id": 6146,
      "verse_number": 8,
      "verse_key": "99:8",
      "hizb_number": 60,
      "rub_el_hizb_number": 239,
      "ruku_number": 543,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُۥ",
      "page_number": 599,
      "juz_number": 30,
      "translations": [
        {
          "id": 407849,
          "resource_id": 85,
          "text": "but whoever has done an atom’s-weight of evil will see that."
        },
        {
          "id": 1550583,
          "resource_id": 831,
          "text": "Aur jisne zarra barabar badi ki hogi woh usko dekh lega"
        },
        {
          "id": -1006146,
          "resource_id": "ur.maududi",
          "text": "اور جس نے ذرہ برابر بدی کی ہوگی وہ اس کو دیکھ لے گا"
        },
        {
          "id": -2006146,
          "resource_id": 227,
          "text": "మరియు అలాగే, ప్రతివాడు తాను రవ్వంత (పరమాణువంత) చెడును చేసి ఉన్నా, దానిని చూసుకుంటాడు."
        }
      ]
    }
  ]
}