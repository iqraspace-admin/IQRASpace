    "verses_count": 30,
    "pages": [
      593,
      594
    ],
    "translated_name": {
      "language_name": "english",
      "name": "The Dawn"
    }
  },
  "verses": [
    {
      "id": 5994,
      "verse_number": 1,
      "verse_key": "89:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " وَٱلْفَجْرِ",
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 407697,
          "resource_id": 85,
          "text": "By the Daybreak,"
        },
        {
          "id": 1550431,
          "resource_id": 831,
          "text": "Kasam hai fajr ki"
        },
        {
          "id": -1005994,
          "resource_id": "ur.maududi",
          "text": "قسم ہے فجر کی"
        },
        {
          "id": -2005994,
          "resource_id": 227,
          "text": "ప్రాంతః కాలం సాక్షిగా!"
        }
      ]
    },
    {
      "id": 5995,
      "verse_number": 2,
      "verse_key": "89:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَيَالٍ عَشْرٍ",
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 407698,
          "resource_id": 85,
          "text": "by the Ten Nights,"
        },
        {
          "id": 1550432,
          "resource_id": 831,
          "text": "Aur dus raaton ki"
        },
        {
          "id": -1005995,
          "resource_id": "ur.maududi",
          "text": "اور دس راتوں کی"
        },
        {
          "id": -2005995,
          "resource_id": 227,
          "text": "పది రాత్రుల సాక్షిగా!"
        }
      ]
    },
    {
      "id": 5996,
      "verse_number": 3,
      "verse_key": "89:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلشَّفْعِ وَٱلْوَتْرِ",
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 407699,
          "resource_id": 85,
          "text": "by the even and the odd,"
        },
        {
          "id": 1550433,
          "resource_id": 831,
          "text": "Aur jufft(even) aur taaq(odd) ki"
        },
        {
          "id": -1005996,
          "resource_id": "ur.maududi",
          "text": "اور جفت اور طاق کی"
        },
        {
          "id": -2005996,
          "resource_id": 227,
          "text": "సరి బేసీల సాక్షిగా!"
        }
      ]
    },
    {
      "id": 5997,
      "verse_number": 4,
      "verse_key": "89:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّيْلِ إِذَا يَسْرِ",
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 407700,
          "resource_id": 85,
          "text": "by the passing night––"
        },
        {
          "id": 1550434,
          "resource_id": 831,
          "text": "Aur Raat ki jabke woh ruksat ho rahi ho"
        },
        {
          "id": -1005997,
          "resource_id": "ur.maududi",
          "text": "اور رات کی جبکہ وہ رخصت ہو رہی ہو"
        },
        {
          "id": -2005997,
          "resource_id": 227,
          "text": "గడచిపోయే రాత్రి సాక్షిగా!"
        }
      ]
    },
    {
      "id": 5998,
      "verse_number": 5,
      "verse_key": "89:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "هَلْ فِى ذَٰلِكَ قَسَمٌ لِّذِى حِجْرٍ",
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 407701,
          "resource_id": 85,
          "text": "is this oath strong enough for a rational person?"
        },
        {
          "id": 1550435,
          "resource_id": 831,
          "text": "kya ismein kisi sahib-e-aqal ke liye koi kasam hai"
        },
        {
          "id": -1005998,
          "resource_id": "ur.maududi",
          "text": "کیا اِس میں کسی صاحب عقل کے لیے کوئی قسم ہے؟"
        },
        {
          "id": -2005998,
          "resource_id": 227,
          "text": "వీటిలో బుద్ధిగల వాని కొరకు ఏ ప్రమాణమూ లేదా ఏమిటి?"
        }
      ]
    },
    {
      "id": 5999,
      "verse_number": 6,
      "verse_key": "89:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ",
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 407702,
          "resource_id": 85,
          "text": "Have you [Prophet] considered how your Lord dealt with [the people] of 'Ad,"
        },
        {
          "id": 1550436,
          "resource_id": 831,
          "text": "Tumne dekha nahin ke tumhare Rubb ne kya bartao kiya"
        },
        {
          "id": -1005999,
          "resource_id": "ur.maududi",
          "text": "تم نے دیکھا نہیں کہ تمہارے رب نے کیا برتاؤ کیا"
        },
        {
          "id": -2005999,
          "resource_id": 227,
          "text": "నీ ప్రభువు ఆద్ (జాతి) వారి పట్ల ఎలా వ్యవహరించాడో నీకు తెలియదా?"
        }
      ]
    },
    {
      "id": 6000,
      "verse_number": 7,
      "verse_key": "89:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِرَمَ ذَاتِ ٱلْعِمَادِ",
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 407703,
          "resource_id": 85,
          "text": "of Iram, [the city] of lofty pillars,"
        },
        {
          "id": 1550437,
          "resource_id": 831,
          "text": "Unchey sutuno waley Aad-e-iram kay saath"
        },
        {
          "id": -1006000,
          "resource_id": "ur.maududi",
          "text": "اونچے ستونوں والے عاد ارم کے ساتھ"
        },
        {
          "id": -2006000,
          "resource_id": 227,
          "text": "ఎత్తైన స్థంభాల (భవనాలు గల) ఇరమ్ ప్రజల పట్ల?"
        }
      ]
    },
    {
      "id": 6001,
      "verse_number": 8,
      "verse_key": "89:8",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَـٰدِ",
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 407704,
          "resource_id": 85,
          "text": "whose like has never been made in any land,"
        },
        {
          "id": 1550438,
          "resource_id": 831,
          "text": "Jinke manind koi qaum duniya kay mulkon mein paida nahin ki gayi thi"
        },
        {
          "id": -1006001,
          "resource_id": "ur.maududi",
          "text": "جن کے مانند کوئی قوم دنیا کے ملکوں میں پیدا نہیں کی گئی تھی؟"
        },
        {
          "id": -2006001,
          "resource_id": 227,
          "text": "వారిలాంటి జాతి భూమిలో ఎన్నడూ సృష్టించబడలేదు."
        }
      ]
    },
    {
      "id": 6002,
      "verse_number": 9,
      "verse_key": "89:9",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ",
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 407705,
          "resource_id": 85,
          "text": "and the Thamud, who hewed into the rocks in the valley,"
        },
        {
          "id": 1550439,
          "resource_id": 831,
          "text": "Aur Samood ke saath jinhon ne wadi mei chattane tarashi thi"
        },
        {
          "id": -1006002,
          "resource_id": "ur.maududi",
          "text": "اور ثمود کے ساتھ جنہوں نے وادی میں چٹانیں تراشی تھیں؟"
        },
        {
          "id": -2006002,
          "resource_id": 227,
          "text": "మరియు లోయలలోని కొండరాళ్ళలో (భవనాలను) తొలిచిన సమూద్ జాతి పట్ల?"
        }
      ]
    },
    {
      "id": 6003,
      "verse_number": 10,
      "verse_key": "89:10",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ",
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 407706,
          "resource_id": 85,
          "text": "and the mighty and powerful Pharaoh?"
        },
        {
          "id": 1550440,
          "resource_id": 831,
          "text": "Aur mekhon waley Firoun kay saath"
        },
        {
          "id": -1006003,
          "resource_id": "ur.maududi",
          "text": "اور میخوں والے فرعون کے ساتھ؟"
        },
        {
          "id": -2006003,
          "resource_id": 227,
          "text": "మరియు మేకులవాడైన ఫిర్ఔన్ పట్ల?"
        }
      ]
    },
    {
      "id": 6004,
      "verse_number": 11,
      "verse_key": "89:11",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَـٰدِ",
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 407707,
          "resource_id": 85,
          "text": "All of them committed excesses in their lands,"
        },
        {
          "id": 1550441,
          "resource_id": 831,
          "text": "Yeh woh log (thay) jinhone duniya kay mulkon mein badi sarkashi ki thi"
        },
        {
          "id": -1006004,
          "resource_id": "ur.maududi",
          "text": "یہ وہ لوگ تھے جنہوں نے دنیا کے ملکوں میں بڑی سرکشی کی تھی"
        },
        {
          "id": -2006004,
          "resource_id": 227,
          "text": "వారంతా ఆయా దేశాలలో తలబిరుసుతనంతో ప్రవర్తించారు;"
        }
      ]
    },
    {
      "id": 6005,
      "verse_number": 12,
      "verse_key": "89:12",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ",
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 407708,
          "resource_id": 85,
          "text": "and spread corruption there:"
        },
        {
          "id": 1550442,
          "resource_id": 831,
          "text": "Aur inmein bahut fasaad failaya tha"
        },
        {
          "id": -1006005,
          "resource_id": "ur.maududi",
          "text": "اور ان میں بہت فساد پھیلایا تھا"
        },
        {
          "id": -2006005,
          "resource_id": 227,
          "text": "మరియు వాటిలో దౌర్జన్యాన్ని రేకెత్తించారు."
        }
      ]
    },
    {
      "id": 6006,
      "verse_number": 13,
      "verse_key": "89:13",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ",
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 407709,
          "resource_id": 85,
          "text": "your Lord let a scourge of punishment loose on them."
        },
        {
          "id": 1550443,
          "resource_id": 831,
          "text": "Aakhir-e-kaar tumhare Rubb ne inpar azaab ka koda barsa diya"
        },
        {
          "id": -1006006,
          "resource_id": "ur.maududi",
          "text": "آخرکار تمہارے رب نے ان پر عذاب کا کوڑا برسا دیا"
        },
        {
          "id": -2006006,
          "resource_id": 227,
          "text": "కాబట్టి నీ ప్రభువు వారిపైకి అనేక రకాల బాధాకరమైన శిక్షలను పంపాడు."
        }
      ]
    },
    {
      "id": 6007,
      "verse_number": 14,
      "verse_key": "89:14",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ",
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 407710,
          "resource_id": 85,
          "text": "Your Lord is always watchful."
        },
        {
          "id": 1550444,
          "resource_id": 831,
          "text": "Haqeeqat yeh hai kay tumhara Rubb ghaath(watchful) lagaye huey hai"
        },
        {
          "id": -1006007,
          "resource_id": "ur.maududi",
          "text": "حقیقت یہ ہے کہ تمہارا رب گھات لگائے ہوئے ہے"
        },
        {
          "id": -2006007,
          "resource_id": 227,
          "text": "వాస్తవానికి, నీ ప్రభువు మాటు వేసి ఉన్నాడు (అంతా కనిపెడ్తూ ఉంటాడు)!"
        }
      ]
    },
    {
      "id": 6008,
      "verse_number": 15,
      "verse_key": "89:15",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَمَّا ٱلْإِنسَـٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ",
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 407711,
          "resource_id": 85,
          "text": "[The nature of] man is that, when his Lord tries him through honour and blessings, he says, ‘My Lord has honoured me,’"
        },
        {
          "id": 1550445,
          "resource_id": 831,
          "text": "Magar Insan ka haal yeh hai kay uska Rubb jab usko aazmaish mein daalta hai aur usey izzat aur niyamat deta hai to woh kehta hai kay mere Rubb ne mujhey izzatdar bana diya"
        },
        {
          "id": -1006008,
          "resource_id": "ur.maududi",
          "text": "مگر انسان کا حال یہ ہے کہ اس کا رب جب اُس کو آزمائش میں ڈالتا ہے اور اُسے عزت اور نعمت دیتا ہے تو وہ کہتا ہے کہ میرے رب نے مجھے عزت دار بنا دیا"
        },
        {
          "id": -2006008,
          "resource_id": 227,
          "text": "అయితే మానవుడు ఎలాంటి వాడంటే: అతని ప్రభువు అతన్ని పరీక్షించటానికి, అతనికి గౌరవ ప్రతిష్టల నిచ్చి అనుగ్రహించి నప్పుడు: \"నా ప్రభువు నన్ను గౌరవించాడు.\" అని అంటాడు;"
        }
      ]
    },
    {
      "id": 6009,
      "verse_number": 16,
      "verse_key": "89:16",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَـٰنَنِ",
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 407712,
          "resource_id": 85,
          "text": "but when He tries him through the restriction of his provision, he says, ‘My Lord has humiliated me.’"
        },
        {
          "id": 1550446,
          "resource_id": 831,
          "text": "Aur jab woh usko azmaish mein daalta hai aur uska rizq uspar tangg kar deta hai to woh kehta hai mere Rubb ne mujhey zaleel kar diya"
        },
        {
          "id": -1006009,
          "resource_id": "ur.maududi",
          "text": "اور جب وہ اُس کو آزمائش میں ڈالتا ہے اور اُس کا رزق اُس پر تنگ کر دیتا ہے تو وہ کہتا ہے کہ میرے رب نے مجھے ذلیل کر دیا"
        },
        {
          "id": -2006009,
          "resource_id": 227,
          "text": "కాని, అతన్ని పరీక్షించటానికి, అతని ఉపాధిని తగ్గించినప్పుడు: \"నా ప్రభువు నన్ను అవమానించాడు.\" అని అంటాడు."
        }
      ]
    },
    {
      "id": 6010,
      "verse_number": 17,
      "verse_key": "89:17",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّا ۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ",
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 407713,
          "resource_id": 85,
          "text": "No indeed! You [people] do not honour orphans,"
        },
        {
          "id": 1550447,
          "resource_id": 831,
          "text": "Hargiz nahin, balke tum yateem se izzat ka sulook nahin kartey"
        },
        {
          "id": -1006010,
          "resource_id": "ur.maududi",
          "text": "ہرگز نہیں، بلکہ تم یتیم سے عزت کا سلوک نہیں کرتے"
        },
        {
          "id": -2006010,
          "resource_id": 227,
          "text": "అలా కాదు, వాస్తవానికి మీరు అనాథులను ఆదరించరు;"
        }
      ]
    },
    {
      "id": 6011,
      "verse_number": 18,
      "verse_key": "89:18",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَا تَحَـٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 407714,
          "resource_id": 85,
          "text": "you do not urge one another to feed the poor,"
        },
        {
          "id": 1550448,
          "resource_id": 831,
          "text": "Aur miskeen ko khana khilane par ek dusrey ko nahin uksatey"
        },
        {
          "id": -1006011,
          "resource_id": "ur.maududi",
          "text": "اور مسکین کو کھانا کھلانے پر ایک دوسرے کو نہیں اکساتے"
        },
        {
          "id": -2006011,
          "resource_id": 227,
          "text": "మరియు మీరు పేదలకు అన్నం పెట్టే విషయంలో ఒకరినొకరు ప్రోత్సహించుకోరు;"
        }
      ]
    },
    {
      "id": 6012,
      "verse_number": 19,
      "verse_key": "89:19",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًا لَّمًّا",
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 407715,
          "resource_id": 85,
          "text": "you consume inheritance greedily,"
        },
        {
          "id": 1550449,
          "resource_id": 831,
          "text": "Aur Miras(inheritance) ka sara maal sameith kar kha jatey ho"
        },
        {
          "id": -1006012,
          "resource_id": "ur.maududi",
          "text": "اور میراث کا سارا مال سمیٹ کر کھا جاتے ہو"
        },
        {
          "id": -2006012,
          "resource_id": 227,
          "text": "మరియు వారసత్వపు ఆస్తిని పేరాశతో అంతా మీరే తినేస్తారు."
        }
      ]
    },
    {
      "id": 6013,
      "verse_number": 20,
      "verse_key": "89:20",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَتُحِبُّونَ ٱلْمَالَ حُبًّا جَمًّا",
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 407716,
          "resource_id": 85,
          "text": "and you love wealth with a passion."
        },
        {
          "id": 1550450,
          "resource_id": 831,
          "text": "Aur maal ki muhabbat mei buri tarah giraftar ho"
        },
        {
          "id": -1006013,
          "resource_id": "ur.maududi",
          "text": "اور مال کی محبت میں بری طرح گرفتار ہو"
        },
        {
          "id": -2006013,
          "resource_id": 227,
          "text": "మరియు మీరు ధనవ్యామోహంలో దారుణంగా చిక్కుకు పోయారు!"
        }
      ]
    },
    {
      "id": 6014,
      "verse_number": 21,
      "verse_key": "89:21",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّا دَكًّا",
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 407717,
          "resource_id": 85,
          "text": "No indeed! When the earth is pounded to dust, pounded and pounded,"
        },
        {
          "id": 1550451,
          "resource_id": 831,
          "text": "Hargiz nahin jab zameen pai dar pai qoot qoot kar regzaar bana di jayegi"
        },
        {
          "id": -1006014,
          "resource_id": "ur.maududi",
          "text": "ہرگز نہیں، جب زمین پے در پے کوٹ کوٹ کر ریگ زار بنا دی جائے گی"
        },
        {
          "id": -2006014,
          "resource_id": 227,
          "text": "అలా కాదు, భూమి, దంచి పిండిపిండిగా చేయబడినపుడు;"
        }
      ]
    },
    {
      "id": 6015,
      "verse_number": 22,
      "verse_key": "89:22",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّا صَفًّا",
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 407718,
          "resource_id": 85,
          "text": "when your Lord comes with the angels, rank upon rank,"
        },
        {
          "id": 1550452,
          "resource_id": 831,
          "text": "Aur tumahra Rubb jalwa farma hoga is haal mei kay farishtey saff dar saff khade hongey"
        },
        {
          "id": -1006015,
          "resource_id": "ur.maududi",
          "text": "اور تمہارا رب جلوہ فرما ہوگا اِس حال میں کہ فرشتے صف در صف کھڑے ہوں گے"
        },
        {
          "id": -2006015,
          "resource_id": 227,
          "text": "మరియు నీ ప్రభువు (స్వయంగా) వస్తాడు మరియు దేవదూతలు వరుసలలో వస్తారు."
        }
      ]
    },
    {
      "id": 6016,
      "verse_number": 23,
      "verse_key": "89:23",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍ يَتَذَكَّرُ ٱلْإِنسَـٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ",
      "page_number": 593,
      "juz_number": 30,
      "translations": [
        {
          "id": 407719,
          "resource_id": 85,
          "text": "when Hell is that Day brought near- on that Day man will take heed, but what good will that be to him then?"
        },
        {
          "id": 1550453,
          "resource_id": 831,
          "text": "Aur jahannum us roz samnay le aayi jaeygi, us din Insan ko samajh ayegi aur us waqt us ke samajhne ka kya hasil"
        },
        {
          "id": -1006016,
          "resource_id": "ur.maududi",
          "text": "اور جہنم اُس روز سامنے لے آئی جائے گی، اُس دن انسان کو سمجھ آئے گی اور اس وقت اُس کے سمجھنے کا کیا حاصل؟"
        },
        {
          "id": -2006016,
          "resource_id": 227,
          "text": "ఆ రోజు నరకం (ముందుకు) తీసుకు రాబడుతుంది. ఆ రోజు మానవుడు (తన కర్మలన్నీ) జ్ఞప్తికి తెచ్చుకుంటాడు; కాని ఆ రోజు జ్ఞప్తికి తెచ్చుకోవడం వల్ల అతనికి కలిగే ప్రయోజనమేమిటీ?"
        }
      ]
    },
    {
      "id": 6017,
      "verse_number": 24,
      "verse_key": "89:24",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَقُولُ يَـٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407720,
          "resource_id": 85,
          "text": "He will say, ‘Would that I had provided for this life to come!’"
        },
        {
          "id": 1550454,
          "resource_id": 831,
          "text": "Woh kahega ke kaash maine apni is zindagi ke liye kuch peshgi saman kiya hota"
        },
        {
          "id": -1006017,
          "resource_id": "ur.maududi",
          "text": "وہ کہے گا کہ کاش میں نے اپنی اِس زندگی کے لیے کچھ پیشگی سامان کیا ہوتا!"
        },
        {
          "id": -2006017,
          "resource_id": 227,
          "text": "అతడు: \"అయ్యో! నా పాడుగానూ! నా ఈ జీవితం కొరకు నేను (సత్కార్యాలు) చేసి పంపు కొని ఉంటే ఎంత బాగుండేది!\" అని వాపోతాడు."
        }
      ]
    },
    {
      "id": 6018,
      "verse_number": 25,
      "verse_key": "89:25",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَيَوْمَئِذٍ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407721,
          "resource_id": 85,
          "text": "On that Day, no one will punish as He punishes,"
        },
        {
          "id": 1550455,
          "resource_id": 831,
          "text": "Phir us din Allah jo azaab dega waisa azaab dene wala koi nahin"
        },
        {
          "id": -1006018,
          "resource_id": "ur.maududi",
          "text": "پھر اُس دن اللہ جو عذاب دے گا ویسا عذاب دینے والا کوئی نہیں"
        },
        {
          "id": -2006018,
          "resource_id": 227,
          "text": "అయితే, ఆ రోజు, ఆయన (అల్లాహ్) శిక్షించినట్లు, మరెవ్వడూ శిక్షించలేడు!"
        }
      ]
    },
    {
      "id": 6019,
      "verse_number": 26,
      "verse_key": "89:26",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407722,
          "resource_id": 85,
          "text": "and no one will bind as He binds."
        },
        {
          "id": 1550456,
          "resource_id": 831,
          "text": "Aur Allah jaisa bandhega waisa bandhne wala koi nahin"
        },
        {
          "id": -1006019,
          "resource_id": "ur.maududi",
          "text": "اور اللہ جیسا باندھے گا ویسا باندھنے والا کوئی نہیں"
        },
        {
          "id": -2006019,
          "resource_id": 227,
          "text": "మరియు ఆయన (అల్లాహ్) బంధించినట్లు, మరెవ్వడూ బంధించలేడు."
        }
      ]
    },
    {
      "id": 6020,
      "verse_number": 27,
      "verse_key": "89:27",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَـٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407723,
          "resource_id": 85,
          "text": "‘[But] you, soul at peace:"
        },
        {
          "id": 1550457,
          "resource_id": 831,
          "text": "(Dusri taraf irshad hoga) Aey nafsey mutmain(reassured soul/pious)"
        },
        {
          "id": -1006020,
          "resource_id": "ur.maududi",
          "text": "(دوسری طرف ارشاد ہوگا) اے نفس مطمئن!"
        },
        {
          "id": -2006020,
          "resource_id": 227,
          "text": "(సన్మార్గునితో ఇలా అనబడుతుంది): \"ఓ తృప్తి పొందిన ఆత్మా!"
        }
      ]
    },
    {
      "id": 6021,
      "verse_number": 28,
      "verse_key": "89:28",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407724,
          "resource_id": 85,
          "text": "return to your Lord well pleased and well pleasing;"
        },
        {
          "id": 1550458,
          "resource_id": 831,
          "text": "Chal apne Rubb ki taraf is haal mein ke tu (apne anjam-e-neik se) khush (Aur apne Rubb kay nazdeek) pasandida hai"
        },
        {
          "id": -1006021,
          "resource_id": "ur.maududi",
          "text": "چل اپنے رب کی طرف، اِس حال میں کہ تو (اپنے انجام نیک سے) خوش (اور اپنے رب کے نزدیک) پسندیدہ ہے"
        },
        {
          "id": -2006021,
          "resource_id": 227,
          "text": "నీ ప్రభువు సన్నిధికి మరలి రా! (నీకు లభించే సత్ఫలితానికి) ఆనందిస్తూ మరియు (నీ ప్రభువునకు) ప్రియమైనదానివై!"
        }
      ]
    },
    {
      "id": 6022,
      "verse_number": 29,
      "verse_key": "89:29",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَٱدْخُلِى فِى عِبَـٰدِى",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407725,
          "resource_id": 85,
          "text": "go in among My servants;"
        },
        {
          "id": 1550459,
          "resource_id": 831,
          "text": "Shamil ho ja mere (neik) bandon mein"
        },
        {
          "id": -1006022,
          "resource_id": "ur.maududi",
          "text": "شامل ہو جا میرے (نیک) بندوں میں"
        },
        {
          "id": -2006022,
          "resource_id": 227,
          "text": "నీవు (పుణ్యాత్ములైన) నా దాసులలో చేరిపో!"
        }
      ]
    },
    {
      "id": 6023,
      "verse_number": 30,
      "verse_key": "89:30",
      "hizb_number": 60,
      "rub_el_hizb_number": 237,
      "ruku_number": 533,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱدْخُلِى جَنَّتِى",
      "page_number": 594,
      "juz_number": 30,
      "translations": [
        {
          "id": 407726,
          "resource_id": 85,
          "text": "and into My Garden.’"
        },
        {
          "id": 1550460,
          "resource_id": 831,
          "text": "Aur dakhil hoja meri jannat mein"
        },
        {
          "id": -1006023,
          "resource_id": "ur.maududi",
          "text": "اور داخل ہو جا میری جنت میں"
        },
        {
          "id": -2006023,
          "resource_id": 227,
          "text": "మరియు నీవు నా స్వర్గంలో ప్రవేశించు!\""
        }
      ]
    }
  ]
}