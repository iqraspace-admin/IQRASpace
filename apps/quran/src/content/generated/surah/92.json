    ],
    "translated_name": {
      "language_name": "english",
      "name": "The Night"
    }
  },
  "verses": [
    {
      "id": 6059,
      "verse_number": 1,
      "verse_key": "92:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " وَٱلَّيْلِ إِذَا يَغْشَىٰ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407762,
          "resource_id": 85,
          "text": "By the enshrouding night,"
        },
        {
          "id": 1550496,
          "resource_id": 831,
          "text": "Kasam hai raat ki jabke woh chaa jaaye"
        },
        {
          "id": -1006059,
          "resource_id": "ur.maududi",
          "text": "قسم ہے رات کی جبکہ وہ چھا جائے"
        },
        {
          "id": -2006059,
          "resource_id": 227,
          "text": "క్రమ్ముకునే రాత్రి సాక్షిగా!"
        }
      ]
    },
    {
      "id": 6060,
      "verse_number": 2,
      "verse_key": "92:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407763,
          "resource_id": 85,
          "text": "by the radiant day,"
        },
        {
          "id": 1550497,
          "resource_id": 831,
          "text": "Aur din ki jabke woh roshan ho"
        },
        {
          "id": -1006060,
          "resource_id": "ur.maududi",
          "text": "اور دن کی جبکہ وہ روشن ہو"
        },
        {
          "id": -2006060,
          "resource_id": 227,
          "text": "ప్రకాశించే పగటి సాక్షిగా!"
        }
      ]
    },
    {
      "id": 6061,
      "verse_number": 3,
      "verse_key": "92:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407764,
          "resource_id": 85,
          "text": "by His creation of male and female!"
        },
        {
          "id": 1550498,
          "resource_id": 831,
          "text": "Aur us zaat ki jisne nar(male) aur maada(female) ko paida kiya"
        },
        {
          "id": -1006061,
          "resource_id": "ur.maududi",
          "text": "اور اُس ذات کی جس نے نر اور مادہ کو پیدا کیا"
        },
        {
          "id": -2006061,
          "resource_id": 227,
          "text": "మరియు, మగ మరియు ఆడ (జాతులను) సృష్టించిన ఆయన (అల్లాహ్) సాక్షిగా!"
        }
      ]
    },
    {
      "id": 6062,
      "verse_number": 4,
      "verse_key": "92:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407765,
          "resource_id": 85,
          "text": "The ways you take differ greatly."
        },
        {
          "id": 1550499,
          "resource_id": 831,
          "text": "Dar haqeeqat tum logon ki koshishein mukhtalif qism ki hai"
        },
        {
          "id": -1006062,
          "resource_id": "ur.maududi",
          "text": "درحقیقت تم لوگوں کی کوششیں مختلف قسم کی ہیں"
        },
        {
          "id": -2006062,
          "resource_id": 227,
          "text": "వాస్తవానికి, మీ ప్రయత్నాలు నానా విధాలుగా ఉన్నాయి;"
        }
      ]
    },
    {
      "id": 6063,
      "verse_number": 5,
      "verse_key": "92:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407766,
          "resource_id": 85,
          "text": "There is the one who gives, who is mindful of God,"
        },
        {
          "id": 1550500,
          "resource_id": 831,
          "text": "To jisne (rah e khuda mein) maal diya aur (khuda ki nafarmani se) parhez kiya"
        },
        {
          "id": -1006063,
          "resource_id": "ur.maududi",
          "text": "تو جس نے (راہ خدا میں) مال دیا اور (خدا کی نافرمانی سے) پرہیز کیا"
        },
        {
          "id": -2006063,
          "resource_id": 227,
          "text": "కాని ఎవడైతే (దానధర్మాలు) చేస్తూ దైవభీతి కలిగి ఉంటాడో!"
        }
      ]
    },
    {
      "id": 6064,
      "verse_number": 6,
      "verse_key": "92:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَصَدَّقَ بِٱلْحُسْنَىٰ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407767,
          "resource_id": 85,
          "text": "who testifies to goodness––"
        },
        {
          "id": 1550501,
          "resource_id": 831,
          "text": "Aur bhalayi ko sach mana"
        },
        {
          "id": -1006064,
          "resource_id": "ur.maududi",
          "text": "اور بھلائی کو سچ مانا"
        },
        {
          "id": -2006064,
          "resource_id": 227,
          "text": "మరియు మంచిని నమ్ముతాడో!"
        }
      ]
    },
    {
      "id": 6065,
      "verse_number": 7,
      "verse_key": "92:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407768,
          "resource_id": 85,
          "text": "We shall smooth his way towards ease."
        },
        {
          "id": 1550502,
          "resource_id": 831,
          "text": "Usko hum aasan raastey kay liye sahulat denge"
        },
        {
          "id": -1006065,
          "resource_id": "ur.maududi",
          "text": "اس کو ہم آسان راستے کے لیے سہولت دیں گے"
        },
        {
          "id": -2006065,
          "resource_id": 227,
          "text": "అతనికి మేము మేలు కొరకు దారిని సులభం చేస్తాము."
        }
      ]
    },
    {
      "id": 6066,
      "verse_number": 8,
      "verse_key": "92:8",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407769,
          "resource_id": 85,
          "text": "There is the one who is miserly, who is self-satisfied,"
        },
        {
          "id": 1550503,
          "resource_id": 831,
          "text": "Aur jisne bukhl(kanjoosi) kiya aur (apney khuda se) be niyazi(self-sufficient/independent) barti"
        },
        {
          "id": -1006066,
          "resource_id": "ur.maududi",
          "text": "اور جس نے بخل کیا اور (اپنے خدا سے) بے نیازی برتی"
        },
        {
          "id": -2006066,
          "resource_id": 227,
          "text": "కాని ఎవడైతే పిసినారితనం చేస్తూ, నిర్లక్ష్య వైఖరిని అవలంబిస్తాడో!"
        }
      ]
    },
    {
      "id": 6067,
      "verse_number": 9,
      "verse_key": "92:9",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَكَذَّبَ بِٱلْحُسْنَىٰ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407770,
          "resource_id": 85,
          "text": "who denies goodness––"
        },
        {
          "id": 1550504,
          "resource_id": 831,
          "text": "aur bhalayi ko jhutlaya"
        },
        {
          "id": -1006067,
          "resource_id": "ur.maududi",
          "text": "اور بھلائی کو جھٹلایا"
        },
        {
          "id": -2006067,
          "resource_id": 227,
          "text": "మరియు మంచిని అబద్ధమని తిరస్కరిస్తాడో!"
        }
      ]
    },
    {
      "id": 6068,
      "verse_number": 10,
      "verse_key": "92:10",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407771,
          "resource_id": 85,
          "text": "We shall smooth his way towards hardship"
        },
        {
          "id": 1550505,
          "resource_id": 831,
          "text": "Usko hum sakht rastey kay liye sahulat dengey"
        },
        {
          "id": -1006068,
          "resource_id": "ur.maududi",
          "text": "اس کو ہم سخت راستے کے لیے سہولت دیں گے"
        },
        {
          "id": -2006068,
          "resource_id": 227,
          "text": "అతనికి మేము చెడు కొరకు దారిని సులభం చేస్తాము."
        }
      ]
    },
    {
      "id": 6069,
      "verse_number": 11,
      "verse_key": "92:11",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407772,
          "resource_id": 85,
          "text": "and his wealth will not help him as he falls."
        },
        {
          "id": 1550506,
          "resource_id": 831,
          "text": "Aur uska maal aakhir uske kis kaam aayega jabke woh halaq ho jaye"
        },
        {
          "id": -1006069,
          "resource_id": "ur.maududi",
          "text": "اور اُس کا مال آخر اُس کے کس کام آئے گا جبکہ وہ ہلاک ہو جائے؟"
        },
        {
          "id": -2006069,
          "resource_id": 227,
          "text": "మరియు అతడు నశించి పోయినప్పుడు, అతని ధనం అతనికి ఎలా ఉపయోగపడుతుంది?"
        }
      ]
    },
    {
      "id": 6070,
      "verse_number": 12,
      "verse_key": "92:12",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ عَلَيْنَا لَلْهُدَىٰ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407773,
          "resource_id": 85,
          "text": "Our part is to provide guidance––"
        },
        {
          "id": 1550507,
          "resource_id": 831,
          "text": "Beshak rasta batana hamare zimmey hai"
        },
        {
          "id": -1006070,
          "resource_id": "ur.maududi",
          "text": "بے شک راستہ بتانا ہمارے ذمہ ہے"
        },
        {
          "id": -2006070,
          "resource_id": 227,
          "text": "నిశ్చయంగా, సన్మార్గం చూపడం మా పని!"
        }
      ]
    },
    {
      "id": 6071,
      "verse_number": 13,
      "verse_key": "92:13",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407774,
          "resource_id": 85,
          "text": "this world and the next belong to Us––"
        },
        {
          "id": 1550508,
          "resource_id": 831,
          "text": "aur dar haqeeqat aakhirat aur duniya dono kay hum hi malik hai"
        },
        {
          "id": -1006071,
          "resource_id": "ur.maududi",
          "text": "اور درحقیقت آخرت اور دنیا، دونوں کے ہم ہی مالک ہیں"
        },
        {
          "id": -2006071,
          "resource_id": 227,
          "text": "మరియు నిశ్చయంగా, ఇహపరలోకాల (ఆధిపత్యం) మాకే చెందినది."
        }
      ]
    },
    {
      "id": 6072,
      "verse_number": 14,
      "verse_key": "92:14",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407775,
          "resource_id": 85,
          "text": "so I warn you about the raging Fire,"
        },
        {
          "id": 1550509,
          "resource_id": 831,
          "text": "Pas maine tumko khabardar kar diya hai bhadakti hui aag se"
        },
        {
          "id": -1006072,
          "resource_id": "ur.maududi",
          "text": "پس میں نے تم کو خبردار کر دیا ہے بھڑکتی ہوئی آگ سے"
        },
        {
          "id": -2006072,
          "resource_id": 227,
          "text": "కాబట్టి నేను మిమ్మల్ని ప్రజ్వలించే నరకాగ్నిని గురించి హెచ్చరించాను."
        }
      ]
    },
    {
      "id": 6073,
      "verse_number": 15,
      "verse_key": "92:15",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407776,
          "resource_id": 85,
          "text": "in which none but the most wicked one will burn,"
        },
        {
          "id": 1550510,
          "resource_id": 831,
          "text": "Usmein nahin jhulsega magar woh intihayi badbakth"
        },
        {
          "id": -1006073,
          "resource_id": "ur.maududi",
          "text": "اُس میں نہیں جھلسے گا مگر وہ انتہائی بد بخت"
        },
        {
          "id": -2006073,
          "resource_id": 227,
          "text": "పరమ దౌర్భాగ్యుడు తప్ప, మరెవ్వడూ అందులో కాలడు!"
        }
      ]
    },
    {
      "id": 6074,
      "verse_number": 16,
      "verse_key": "92:16",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407777,
          "resource_id": 85,
          "text": "who denied [the truth], and turned away."
        },
        {
          "id": 1550511,
          "resource_id": 831,
          "text": "jisne jhutlaya aur mooh phera"
        },
        {
          "id": -1006074,
          "resource_id": "ur.maududi",
          "text": "جس نے جھٹلایا اور منہ پھیرا"
        },
        {
          "id": -2006074,
          "resource_id": 227,
          "text": "ఎవడైతే (సత్యాన్ని) తిరస్కరించి (దాని నుండి) విముఖుడవుతాడో!"
        }
      ]
    },
    {
      "id": 6075,
      "verse_number": 17,
      "verse_key": "92:17",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407778,
          "resource_id": 85,
          "text": "The most pious one will be spared this––"
        },
        {
          "id": 1550512,
          "resource_id": 831,
          "text": "Aur usse door rakkha jayega woh nihayat parhezgaar"
        },
        {
          "id": -1006075,
          "resource_id": "ur.maududi",
          "text": "اور اُس سے دور رکھا جائیگا وہ نہایت پرہیزگار"
        },
        {
          "id": -2006075,
          "resource_id": 227,
          "text": "కాని దైవభీతి గలవాడు దాని నుండి (ఆ నరకాగ్ని నుండి) దూరంగా ఉంచబడతాడు!"
        }
      ]
    },
    {
      "id": 6076,
      "verse_number": 18,
      "verse_key": "92:18",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407779,
          "resource_id": 85,
          "text": "who gives his wealth away as self-purification,"
        },
        {
          "id": 1550513,
          "resource_id": 831,
          "text": "Jo paakiza honay ki khatir apna maal deta hai"
        },
        {
          "id": -1006076,
          "resource_id": "ur.maududi",
          "text": "جو پاکیزہ ہونے کی خاطر اپنا مال دیتا ہے"
        },
        {
          "id": -2006076,
          "resource_id": 227,
          "text": "అతడే! ఎవడైతే, పవిత్రుడవటానికి తన ధనం నుండి (ఇతరులకు) ఇస్తాడో!"
        }
      ]
    },
    {
      "id": 6077,
      "verse_number": 19,
      "verse_key": "92:19",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407780,
          "resource_id": 85,
          "text": "not to return a favour to anyone"
        },
        {
          "id": 1550514,
          "resource_id": 831,
          "text": "Uspar kisi ka koi ehsan nahin hai jiska badla usey dena ho"
        },
        {
          "id": -1006077,
          "resource_id": "ur.maududi",
          "text": "اُس پر کسی کا کوئی احسان نہیں ہے جس کا بدلہ اُسے دینا ہو"
        },
        {
          "id": -2006077,
          "resource_id": 227,
          "text": "కాని అది, వారు అతనికి చేసిన ఏ ఉపకారానికి బదులుగా గాక;"
        }
      ]
    },
    {
      "id": 6078,
      "verse_number": 20,
      "verse_key": "92:20",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407781,
          "resource_id": 85,
          "text": "but for the sake of his Lord the Most High––"
        },
        {
          "id": 1550515,
          "resource_id": 831,
          "text": "Woh to sirf apne Rubb-e-bartrar ki raza joii ke liye yeh kaam karta hai"
        },
        {
          "id": -1006078,
          "resource_id": "ur.maududi",
          "text": "وہ تو صرف اپنے رب برتر کی رضا جوئی کے لیے یہ کام کرتا ہے"
        },
        {
          "id": -2006078,
          "resource_id": 227,
          "text": "కేవలం మహోన్నతుడైన తన ప్రభువు ప్రసన్నతను పొందటానికి మాత్రమే అయితే!"
        }
      ]
    },
    {
      "id": 6079,
      "verse_number": 21,
      "verse_key": "92:21",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 536,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَسَوْفَ يَرْضَىٰ",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407782,
          "resource_id": 85,
          "text": "and he will be well pleased."
        },
        {
          "id": 1550516,
          "resource_id": 831,
          "text": "Aur zaroor woh (us se) khush hoga"
        },
        {
          "id": -1006079,
          "resource_id": "ur.maududi",
          "text": "اور ضرور وہ (اُس سے) خوش ہوگا"
        },
        {
          "id": -2006079,
          "resource_id": 227,
          "text": "మరియు అలాంటి వాడే తప్పక సంతోషిస్తాడు."
        }
      ]
    }
  ]
}