{
  "syncedAt": "2026-08-31T09:57:46.271Z",
  "chapter": {
    "id": 79,
    "revelation_place": "makkah",
    "revelation_order": 81,
    "bismillah_pre": true,
    "name_simple": "An-Nazi'at",
    "name_complex": "An-Nāzi`āt",
    "name_arabic": "النازعات",
    "verses_count": 46,
    "pages": [
      583,
      584
    ],
    "translated_name": {
      "language_name": "english",
      "name": "Those who drag forth"
    }
  },
  "verses": [
    {
      "id": 5713,
      "verse_number": 1,
      "verse_key": "79:1",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " وَٱلنَّـٰزِعَـٰتِ غَرْقًا",
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 407416,
          "resource_id": 85,
          "text": "By the forceful chargers"
        },
        {
          "id": 1550150,
          "resource_id": 831,
          "text": "Kasam hai un (Farishton) ki jo doob kar khinchte hain"
        },
        {
          "id": -1005713,
          "resource_id": "ur.maududi",
          "text": "قسم ہے اُن (فرشتوں کی) جو ڈوب کر کھینچتے ہیں"
        },
        {
          "id": -2005713,
          "resource_id": 227,
          "text": "(అవిశ్వాసుల ప్రాణాలను) కఠినంగా లాగి తీసే వారి (దేవదూతల) సాక్షిగా!"
        }
      ]
    },
    {
      "id": 5714,
      "verse_number": 2,
      "verse_key": "79:2",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلنَّـٰشِطَـٰتِ نَشْطًا",
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 407417,
          "resource_id": 85,
          "text": "raring to go,"
        },
        {
          "id": 1550151,
          "resource_id": 831,
          "text": "aur aahistagi se (gently) nikaal le jataey hain"
        },
        {
          "id": -1005714,
          "resource_id": "ur.maududi",
          "text": "اور آہستگی سے نکال لے جاتے ہیں"
        },
        {
          "id": -2005714,
          "resource_id": 227,
          "text": "(విశ్వాసుల ప్రాణాలను) నెమ్మదిగా తీసేవారి (దేవదూతల) సాక్షిగా!"
        }
      ]
    },
    {
      "id": 5715,
      "verse_number": 3,
      "verse_key": "79:3",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلسَّـٰبِحَـٰتِ سَبْحًا",
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 407418,
          "resource_id": 85,
          "text": "sweeping ahead at full stretch,"
        },
        {
          "id": 1550152,
          "resource_id": 831,
          "text": "Aur (un farishton ki jo qayinaat mein) tezi se tairtey phirtay hain"
        },
        {
          "id": -1005715,
          "resource_id": "ur.maududi",
          "text": "اور (اُن فرشتوں کی جو کائنات میں) تیزی سے تیرتے پھرتے ہیں"
        },
        {
          "id": -2005715,
          "resource_id": 227,
          "text": "(విశ్వంలో) తేలియాడుతూ పోయే వారి సాక్షిగా!"
        }
      ]
    },
    {
      "id": 5716,
      "verse_number": 4,
      "verse_key": "79:4",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَٱلسَّـٰبِقَـٰتِ سَبْقًا",
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 407419,
          "resource_id": 85,
          "text": "overtaking swiftly"
        },
        {
          "id": 1550153,
          "resource_id": 831,
          "text": "phir (hukum baja laane mein) sabqat karte hain"
        },
        {
          "id": -1005716,
          "resource_id": "ur.maududi",
          "text": "پھر (حکم بجا لانے میں) سبقت کرتے ہیں"
        },
        {
          "id": -2005716,
          "resource_id": 227,
          "text": "మరియు పందెంలో వలే (ఒకరితో నొకరు) పోటీ పడే వారి సాక్షిగా!"
        }
      ]
    },
    {
      "id": 5717,
      "verse_number": 5,
      "verse_key": "79:5",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَٱلْمُدَبِّرَٰتِ أَمْرًا",
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 407420,
          "resource_id": 85,
          "text": "to bring the matter to an end,"
        },
        {
          "id": 1550154,
          "resource_id": 831,
          "text": "phir (ehkam-ilahi ke mutabiq) maamlaat ka intizam chalate hain"
        },
        {
          "id": -1005717,
          "resource_id": "ur.maududi",
          "text": "پھر (احکام الٰہی کے مطابق) معاملات کا انتظام چلاتے ہیں"
        },
        {
          "id": -2005717,
          "resource_id": 227,
          "text": "మరియు (తమ ప్రభువు) ఆజ్ఞానుసారం వ్యవహారాలు నిర్వహించేవారి (దేవదూతల) సాక్షిగా!"
        }
      ]
    },
    {
      "id": 5718,
      "verse_number": 6,
      "verse_key": "79:6",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ",
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 407421,
          "resource_id": 85,
          "text": "on the Day when the blast reverberates"
        },
        {
          "id": 1550155,
          "resource_id": 831,
          "text": "Jis roz hila marey ga zalzalay ka jhatka"
        },
        {
          "id": -1005718,
          "resource_id": "ur.maududi",
          "text": "جس روز ہلا مارے گا زلزلے کا جھٹکا"
        },
        {
          "id": -2005718,
          "resource_id": 227,
          "text": "ఆ రోజు (మొదటి) బాకా ధ్వని భూగోళాన్ని తీవ్రంగా కంపింపజేస్తుంది."
        }
      ]
    },
    {
      "id": 5719,
      "verse_number": 7,
      "verse_key": "79:7",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "تَتْبَعُهَا ٱلرَّادِفَةُ",
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 407422,
          "resource_id": 85,
          "text": "and the second blast follows,"
        },
        {
          "id": 1550156,
          "resource_id": 831,
          "text": "Aur uske pichey ek aur jhatka padega"
        },
        {
          "id": -1005719,
          "resource_id": "ur.maududi",
          "text": "اور اس کے پیچھے ایک اور جھٹکا پڑے گا"
        },
        {
          "id": -2005719,
          "resource_id": 227,
          "text": "దాని తర్వాత రెండవ సారి బాకా ఊదబడుతుంది. (అప్పుడు అందరూ పునరుత్థరింప బడతారు)."
        }
      ]
    },
    {
      "id": 5720,
      "verse_number": 8,
      "verse_key": "79:8",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ",
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 407423,
          "resource_id": 85,
          "text": "hearts will tremble"
        },
        {
          "id": 1550157,
          "resource_id": 831,
          "text": "Kuch dil hongey jo us roz khauf se kaanp rahey hongey"
        },
        {
          "id": -1005720,
          "resource_id": "ur.maududi",
          "text": "کچھ دل ہوں گے جو اُس روز خوف سے کانپ رہے ہوں گے"
        },
        {
          "id": -2005720,
          "resource_id": 227,
          "text": "ఆ రోజు (కొన్ని) హృదయాలు (భయంతో) దడదడలాడుతూ ఉంటాయి."
        }
      ]
    },
    {
      "id": 5721,
      "verse_number": 9,
      "verse_key": "79:9",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَبْصَـٰرُهَا خَـٰشِعَةٌ",
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 407424,
          "resource_id": 85,
          "text": "and eyes will be downcast."
        },
        {
          "id": 1550158,
          "resource_id": 831,
          "text": "Nigahein unki sehmi(downcast) hui hogi"
        },
        {
          "id": -1005721,
          "resource_id": "ur.maududi",
          "text": "نگاہیں اُن کی سہمی ہوئی ہوں گی"
        },
        {
          "id": -2005721,
          "resource_id": 227,
          "text": "వారి చూపులు క్రిందికి వాలి ఉంటాయి."
        }
      ]
    },
    {
      "id": 5722,
      "verse_number": 10,
      "verse_key": "79:10",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ",
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 407425,
          "resource_id": 85,
          "text": "They say, ‘What? shall we be brought back to life,"
        },
        {
          "id": 1550159,
          "resource_id": 831,
          "text": "Yeh log kehte hain “Kya waqai hum palta kar phir wapas laaye jayenge?”"
        },
        {
          "id": -1005722,
          "resource_id": "ur.maududi",
          "text": "یہ لوگ کہتے ہیں \"کیا واقعی ہم پلٹا کر پھر واپس لائے جائیں گے؟"
        },
        {
          "id": -2005722,
          "resource_id": 227,
          "text": "వారు ఇలా అంటున్నారు: \"ఏమీ? మనం మన పూర్వ స్థితిలోకి మళ్ళీ తీసుకు రాబడతామా?"
        }
      ]
    },
    {
      "id": 5723,
      "verse_number": 11,
      "verse_key": "79:11",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَءِذَا كُنَّا عِظَـٰمًا نَّخِرَةً",
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 407426,
          "resource_id": 85,
          "text": "after we have turned into decayed bones?’ and they say,"
        },
        {
          "id": 1550160,
          "resource_id": 831,
          "text": "“Kya jab hum khokli boseeda (hollow and rotten) haddiyan ban chuke hongey?”"
        },
        {
          "id": -1005723,
          "resource_id": "ur.maududi",
          "text": "کیا جب ہم کھوکھلی بوسیدہ ہڈیاں بن چکے ہوں گے؟\""
        },
        {
          "id": -2005723,
          "resource_id": 227,
          "text": "మనం శిథిలమైన ఎముకలుగా మారి పోయిన తరువాత కూడానా?\""
        }
      ]
    },
    {
      "id": 5724,
      "verse_number": 12,
      "verse_key": "79:12",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ",
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 407427,
          "resource_id": 85,
          "text": "‘Such a return is impossible!’"
        },
        {
          "id": 1550161,
          "resource_id": 831,
          "text": "Kehne lagey “yeh wapsi to phir badey ghatey(nuksan) ki hogi”"
        },
        {
          "id": -1005724,
          "resource_id": "ur.maududi",
          "text": "کہنے لگے \"یہ واپسی تو پھر بڑے گھاٹے کی ہوگی!\""
        },
        {
          "id": -2005724,
          "resource_id": 227,
          "text": "వారు (ఇంకా ఇలా) అంటారు: \"అయితే ఈ తిరిగి రావటమనేది చాల నష్టదాయకమైనదే!\""
        }
      ]
    },
    {
      "id": 5725,
      "verse_number": 13,
      "verse_key": "79:13",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ",
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 407428,
          "resource_id": 85,
          "text": "But all it will take is a single blast,"
        },
        {
          "id": 1550162,
          "resource_id": 831,
          "text": "Halaanke yeh bas itna kaam hai ke ek zoar ki daant padegi"
        },
        {
          "id": -1005725,
          "resource_id": "ur.maududi",
          "text": "حالانکہ یہ بس اتنا کام ہے کہ ایک زور کی ڈانٹ پڑے گی"
        },
        {
          "id": -2005725,
          "resource_id": 227,
          "text": "కాని అది వాస్తవానికి, ఒకే ఒక (తీవ్రమైన) ధ్వని."
        }
      ]
    },
    {
      "id": 5726,
      "verse_number": 14,
      "verse_key": "79:14",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَإِذَا هُم بِٱلسَّاهِرَةِ",
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 407429,
          "resource_id": 85,
          "text": "and they will be back above ground."
        },
        {
          "id": 1550163,
          "resource_id": 831,
          "text": "Aur yakayk yeh khule maidan mein maujood hongey"
        },
        {
          "id": -1005726,
          "resource_id": "ur.maududi",
          "text": "اور یکایک یہ کھلے میدان میں موجود ہوں گے"
        },
        {
          "id": -2005726,
          "resource_id": 227,
          "text": "అప్పుడు వారందరూ, ఒకేసారి లేచి మైదానంలోకి వచ్చి ఉంటారు."
        }
      ]
    },
    {
      "id": 5727,
      "verse_number": 15,
      "verse_key": "79:15",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ",
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 407430,
          "resource_id": 85,
          "text": "Have you [Prophet] heard the story of Moses?"
        },
        {
          "id": 1550164,
          "resource_id": 831,
          "text": "Kya tumhein Moosa ke qissey ki khabar pahunchi hai"
        },
        {
          "id": -1005727,
          "resource_id": "ur.maududi",
          "text": "کیا تمہیں موسیٰؑ کے قصے کی خبر پہنچی ہے؟"
        },
        {
          "id": -2005727,
          "resource_id": 227,
          "text": "ఏమీ? నీకు మూసా వృత్తాంతం అందిందా?"
        }
      ]
    },
    {
      "id": 5728,
      "verse_number": 16,
      "verse_key": "79:16",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407431,
          "resource_id": 85,
          "text": "His Lord called out to him in the sacred valley of Tuwa:"
        },
        {
          "id": 1550165,
          "resource_id": 831,
          "text": "Jab uske Rubb ne usey Tuwa ke muqaddas wadi(valley) mein pukara tha"
        },
        {
          "id": -1005728,
          "resource_id": "ur.maududi",
          "text": "جب اس کے رب نے اُسے طویٰ کی مقدس وادی میں پکارا تھا"
        },
        {
          "id": -2005728,
          "resource_id": 227,
          "text": "అతని ప్రభువు పవిత్ర తువా లోయలో అతనిని పిలిచినప్పుడు,"
        }
      ]
    },
    {
      "id": 5729,
      "verse_number": 17,
      "verse_key": "79:17",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407432,
          "resource_id": 85,
          "text": "‘Go to Pharaoh, for he has exceeded all bounds,"
        },
        {
          "id": 1550166,
          "resource_id": 831,
          "text": "Ke Firaun ke paas ja, woh sarkash ho gaya hai"
        },
        {
          "id": -1005729,
          "resource_id": "ur.maududi",
          "text": "کہ \"فرعون کے پاس جا، وہ سرکش ہو گیا ہے"
        },
        {
          "id": -2005729,
          "resource_id": 227,
          "text": "(ఇలా అన్నాడు): \"ఫిర్ఔన్ వద్దకు వెళ్ళు, నిశ్చయంగా, అతడు ధిక్కారుడయ్యాడు."
        }
      ]
    },
    {
      "id": 5730,
      "verse_number": 18,
      "verse_key": "79:18",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407433,
          "resource_id": 85,
          "text": "and ask him, “Do you want to purify yourself [of sin]?"
        },
        {
          "id": 1550167,
          "resource_id": 831,
          "text": "Aur ussey keh, kya tu iske liye tayyar hai ke pakeezgi ikhtiyar karey"
        },
        {
          "id": -1005730,
          "resource_id": "ur.maududi",
          "text": "اور اس سے کہہ کیا تو اِس کے لیے تیار ہے کہ پاکیزگی اختیار کرے"
        },
        {
          "id": -2005730,
          "resource_id": 227,
          "text": "\"ఇక (అతనితో) ఇట్లను: 'ఏమీ? నీవు పాపరహితుడవు అవటానికి ఇష్టపడతావా?"
        }
      ]
    },
    {
      "id": 5731,
      "verse_number": 19,
      "verse_key": "79:19",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407434,
          "resource_id": 85,
          "text": "Do you want me to guide you to your Lord, so that you may hold Him in awe?” ’"
        },
        {
          "id": 1550168,
          "resource_id": 831,
          "text": "Aur mai terey Rubb ki taraf teri rehnumai karoon to (uska) khauf terey andar paida ho?”"
        },
        {
          "id": -1005731,
          "resource_id": "ur.maududi",
          "text": "اور میں تیرے رب کی طرف تیری رہنمائی کروں تو (اُس کا) خوف تیرے اندر پیدا ہو؟\""
        },
        {
          "id": -2005731,
          "resource_id": 227,
          "text": "మరియు నేను నీకు నీ ప్రభువు వైపునకు మార్గదర్శకత్వం చేస్తాను, మరి నీవు ఆయన పట్ల భీతి కలిగి ఉంటావా?'\""
        }
      ]
    },
    {
      "id": 5732,
      "verse_number": 20,
      "verse_key": "79:20",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَرَىٰهُ ٱلْـَٔايَةَ ٱلْكُبْرَىٰ",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407435,
          "resource_id": 85,
          "text": "Moses showed him the great sign,"
        },
        {
          "id": 1550169,
          "resource_id": 831,
          "text": "Phir Moosa ne (Firaun ke paas ja kar) usko badi nishani dikhai"
        },
        {
          "id": -1005732,
          "resource_id": "ur.maududi",
          "text": "پھر موسیٰؑ نے (فرعون کے پاس جا کر) اُس کو بڑی نشانی دکھائی"
        },
        {
          "id": -2005732,
          "resource_id": 227,
          "text": "తరువాత అతను (మూసా) అతడికి (ఫిర్ఔన్ కు) గొప్ప అద్భుత నిదర్శనాన్ని చూపాడు."
        }
      ]
    },
    {
      "id": 5733,
      "verse_number": 21,
      "verse_key": "79:21",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَكَذَّبَ وَعَصَىٰ",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407436,
          "resource_id": 85,
          "text": "but he denied it and refused [the faith]."
        },
        {
          "id": 1550170,
          "resource_id": 831,
          "text": "Magar usne jhutla diya aur na mana"
        },
        {
          "id": -1005733,
          "resource_id": "ur.maududi",
          "text": "مگر اُس نے جھٹلا دیا اور نہ مانا"
        },
        {
          "id": -2005733,
          "resource_id": 227,
          "text": "కాని అతడు (ఫిర్ఔన్) దానిని అబద్ధమని తిరస్కరించాడు మరియు (అతని మాటను) ఉల్లంఘించాడు."
        }
      ]
    },
    {
      "id": 5734,
      "verse_number": 22,
      "verse_key": "79:22",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ أَدْبَرَ يَسْعَىٰ",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407437,
          "resource_id": 85,
          "text": "He turned away and hastily"
        },
        {
          "id": 1550171,
          "resource_id": 831,
          "text": "Phir chaal baaziyan karne ke liye palta"
        },
        {
          "id": -1005734,
          "resource_id": "ur.maududi",
          "text": "پھر چالبازیاں کرنے کے لیے پلٹا"
        },
        {
          "id": -2005734,
          "resource_id": 227,
          "text": "ఆ తర్వాత అతడు (ఫిర్ఔన్) వెనక్కి మరలి పోయి, (కుట్రలు) పన్నసాగాడు."
        }
      ]
    },
    {
      "id": 5735,
      "verse_number": 23,
      "verse_key": "79:23",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَحَشَرَ فَنَادَىٰ",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407438,
          "resource_id": 85,
          "text": "gathered his people, proclaiming,"
        },
        {
          "id": 1550172,
          "resource_id": 831,
          "text": "Aur logon ko jama karke usne pukaar kar kaha"
        },
        {
          "id": -1005735,
          "resource_id": "ur.maududi",
          "text": "اور لوگوں کو جمع کر کے اس نے پکار کر کہا"
        },
        {
          "id": -2005735,
          "resource_id": 227,
          "text": "పిదప (ప్రజలను) సమావేశపరచి, ఎలుగెత్తి చాటుతూ;"
        }
      ]
    },
    {
      "id": 5736,
      "verse_number": 24,
      "verse_key": "79:24",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407439,
          "resource_id": 85,
          "text": "‘I am your supreme lord,’"
        },
        {
          "id": 1550173,
          "resource_id": 831,
          "text": "“Main tumhara sabse bada Rubb hoon”"
        },
        {
          "id": -1005736,
          "resource_id": "ur.maududi",
          "text": "\"میں تمہارا سب سے بڑا رب ہوں\""
        },
        {
          "id": -2005736,
          "resource_id": 227,
          "text": "ఇలా అన్నాడు: \"నేనే మీ యొక్క మహాన్నత ప్రభువును!\""
        }
      ]
    },
    {
      "id": 5737,
      "verse_number": 25,
      "verse_key": "79:25",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْـَٔاخِرَةِ وَٱلْأُولَىٰٓ",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407440,
          "resource_id": 85,
          "text": "so God condemned him to punishment in the life to come as well as in this life:"
        },
        {
          "id": 1550174,
          "resource_id": 831,
          "text": "Aakhir-e-kaar Allah ne usey aakhirat aur duniya ke azaab mei pakad liya"
        },
        {
          "id": -1005737,
          "resource_id": "ur.maududi",
          "text": "آخرکار اللہ نے اسے آخرت اور دنیا کے عذاب میں پکڑ لیا"
        },
        {
          "id": -2005737,
          "resource_id": 227,
          "text": "కావున అల్లాహ్ అతనిని ఇహపరలోకాల శిక్షకు గురి చేశాడు."
        }
      ]
    },
    {
      "id": 5738,
      "verse_number": 26,
      "verse_key": "79:26",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 522,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰٓ",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407441,
          "resource_id": 85,
          "text": "there truly is a lesson in this for anyone who stands in awe of God."
        },
        {
          "id": 1550175,
          "resource_id": 831,
          "text": "Dar haqeeqat is mein badi ibrat hai har us shaks ke liye jo darey"
        },
        {
          "id": -1005738,
          "resource_id": "ur.maududi",
          "text": "درحقیقت اِس میں بڑی عبرت ہے ہر اُس شخص کے لیے جو ڈرے"
        },
        {
          "id": -2005738,
          "resource_id": 227,
          "text": "నిశ్చయంగా, ఇందులో (అల్లాహ్ కు) భయపడే ప్రతి వ్యక్తి కొరకు గుణపాఠముంది."
        }
      ]
    },
    {
      "id": 5739,
      "verse_number": 27,
      "verse_key": "79:27",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407442,
          "resource_id": 85,
          "text": "Which is harder to create: you people or the sky that He built,"
        },
        {
          "id": 1550176,
          "resource_id": 831,
          "text": "Kya tum logon ki takhleeq(paidaish) zyada sakht kaam hai ya aasmaan ki? Allah ne usko banaya"
        },
        {
          "id": -1005739,
          "resource_id": "ur.maududi",
          "text": "کیا تم لوگوں کی تخلیق زیادہ سخت کام ہے یا آسمان کی؟ اللہ نے اُس کو بنایا"
        },
        {
          "id": -2005739,
          "resource_id": 227,
          "text": "ఏమీ? మిమ్మల్ని సృష్టించడం కఠినమయిన పనా? లేక ఆకాశాన్నా? ఆయనే కదా దానిని నిర్మించింది!"
        }
      ]
    },
    {
      "id": 5740,
      "verse_number": 28,
      "verse_key": "79:28",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "رَفَعَ سَمْكَهَا فَسَوَّىٰهَا",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407443,
          "resource_id": 85,
          "text": "raising it high and perfecting it,"
        },
        {
          "id": 1550177,
          "resource_id": 831,
          "text": "Uski chhat(ceiling) khoob unchi uthayi phir uska tawazun qayam kiya(proportioned it)"
        },
        {
          "id": -1005740,
          "resource_id": "ur.maududi",
          "text": "اُس کی چھت خوب اونچی اٹھائی پھر اُس کا توازن قائم کیا"
        },
        {
          "id": -2005740,
          "resource_id": 227,
          "text": "ఆయన దాని కప్పు (ఎత్తు)ను చాలా పైకి లేపాడు. తరువాత దానిని క్రమపరిచాడు;"
        }
      ]
    },
    {
      "id": 5741,
      "verse_number": 29,
      "verse_key": "79:29",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407444,
          "resource_id": 85,
          "text": "giving darkness to its night and bringing out its morning brightness,"
        },
        {
          "id": 1550178,
          "resource_id": 831,
          "text": "Aur uski raat dhaanki aur uska din nikala"
        },
        {
          "id": -1005741,
          "resource_id": "ur.maududi",
          "text": "اور اُس کی رات ڈھانکی اور اُس کا دن نکالا"
        },
        {
          "id": -2005741,
          "resource_id": 227,
          "text": "మరియు ఆయన దాని రాత్రిని చీకటిగా చేశాడు. మరియు దాని పగటిని (వెలుగును) బహిర్గతం చేశాడు."
        }
      ]
    },
    {
      "id": 5742,
      "verse_number": 30,
      "verse_key": "79:30",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407445,
          "resource_id": 85,
          "text": "and the earth, too, He spread out,"
        },
        {
          "id": 1550179,
          "resource_id": 831,
          "text": "Iske baad zameen ko usne bichaya"
        },
        {
          "id": -1005742,
          "resource_id": "ur.maududi",
          "text": "اِس کے بعد زمین کو اس نے بچھایا"
        },
        {
          "id": -2005742,
          "resource_id": 227,
          "text": "మరియు ఆ పిదప భూమిని పరచినట్లు చేశాడు."
        }
      ]
    },
    {
      "id": 5743,
      "verse_number": 31,
      "verse_key": "79:31",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407446,
          "resource_id": 85,
          "text": "bringing waters and pastures out of it,"
        },
        {
          "id": 1550180,
          "resource_id": 831,
          "text": "Uske andar se uska paani aur chara nikala"
        },
        {
          "id": -1005743,
          "resource_id": "ur.maududi",
          "text": "اُس کے اندر سے اُس کا پانی اور چارہ نکالا"
        },
        {
          "id": -2005743,
          "resource_id": 227,
          "text": "దాని నుండి దాని నీళ్ళను మరియు దాని పచ్చికను బయటికి తీశాడు;"
        }
      ]
    },
    {
      "id": 5744,
      "verse_number": 32,
      "verse_key": "79:32",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلْجِبَالَ أَرْسَىٰهَا",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407447,
          "resource_id": 85,
          "text": "and setting firm mountains [in it]"
        },
        {
          "id": 1550181,
          "resource_id": 831,
          "text": "Aur pahad usmein gaadh diye"
        },
        {
          "id": -1005744,
          "resource_id": "ur.maududi",
          "text": "اور پہاڑ اس میں گاڑ دیے"
        },
        {
          "id": -2005744,
          "resource_id": 227,
          "text": "మరియు పర్వతాలను (దానిలో) స్థిరంగా నాటాడు;"
        }
      ]
    },
    {
      "id": 5745,
      "verse_number": 33,
      "verse_key": "79:33",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مَتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407448,
          "resource_id": 85,
          "text": "for you and your animals to enjoy?"
        },
        {
          "id": 1550182,
          "resource_id": 831,
          "text": "Saaman-e-zeist(provision) ke taur par tumharay liye aur tumharey maweshion ke liye"
        },
        {
          "id": -1005745,
          "resource_id": "ur.maududi",
          "text": "سامان زیست کے طور پر تمہارے لیے اور تمہارے مویشیوں کے لیے"
        },
        {
          "id": -2005745,
          "resource_id": 227,
          "text": "మీకు మరియు మీ పశువులకు జీవన సామగ్రిగా!"
        }
      ]
    },
    {
      "id": 5746,
      "verse_number": 34,
      "verse_key": "79:34",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407449,
          "resource_id": 85,
          "text": "When the great overwhelming event arrives"
        },
        {
          "id": 1550183,
          "resource_id": 831,
          "text": "Phir jab woh hungama-e-azeem barpa hoga"
        },
        {
          "id": -1005746,
          "resource_id": "ur.maududi",
          "text": "پھر جب وہ ہنگامہ عظیم برپا ہوگا"
        },
        {
          "id": -2005746,
          "resource_id": 227,
          "text": "ఇక ఆ గొప్ప దుర్ఘటన (పునరుత్థాన దినం) వచ్చినప్పుడు;"
        }
      ]
    },
    {
      "id": 5747,
      "verse_number": 35,
      "verse_key": "79:35",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَوْمَ يَتَذَكَّرُ ٱلْإِنسَـٰنُ مَا سَعَىٰ",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407450,
          "resource_id": 85,
          "text": "on the Day that man remembers what he has done"
        },
        {
          "id": 1550184,
          "resource_id": 831,
          "text": "Jis roz Insan apna sab kiya dhara yaad karega"
        },
        {
          "id": -1005747,
          "resource_id": "ur.maududi",
          "text": "جس روز انسان اپنا سب کیا دھرا یاد کرے گا"
        },
        {
          "id": -2005747,
          "resource_id": 227,
          "text": "ఆ రోజు మానవుడు తాను చేసిందంతా జ్ఞాపకం చేసుకుంటాడు;"
        }
      ]
    },
    {
      "id": 5748,
      "verse_number": 36,
      "verse_key": "79:36",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407451,
          "resource_id": 85,
          "text": "and Hell is there for all to see,"
        },
        {
          "id": 1550185,
          "resource_id": 831,
          "text": "Aur har dekhne wale ke samney dozak khol kar rakh di jayegi"
        },
        {
          "id": -1005748,
          "resource_id": "ur.maududi",
          "text": "اور ہر دیکھنے والے کے سامنے دوزخ کھول کر رکھ دی جائے گی"
        },
        {
          "id": -2005748,
          "resource_id": 227,
          "text": "మరియు చూసే వారి యెదుటకు, నరకాగ్ని స్పష్టంగా కనబడేటట్లు తేబడుతుంది."
        }
      ]
    },
    {
      "id": 5749,
      "verse_number": 37,
      "verse_key": "79:37",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَمَّا مَن طَغَىٰ",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407452,
          "resource_id": 85,
          "text": "for anyone who has transgressed"
        },
        {
          "id": 1550186,
          "resource_id": 831,
          "text": "To jisne sarkashi(transgress) ki thi"
        },
        {
          "id": -1005749,
          "resource_id": "ur.maududi",
          "text": "تو جس نے سرکشی کی تھی"
        },
        {
          "id": -2005749,
          "resource_id": 227,
          "text": "ఇక ధిక్కారంతో హద్దులు మీరి ప్రవర్తించిన వాడికి;"
        }
      ]
    },
    {
      "id": 5750,
      "verse_number": 38,
      "verse_key": "79:38",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407453,
          "resource_id": 85,
          "text": "and preferred the present life"
        },
        {
          "id": 1550187,
          "resource_id": 831,
          "text": "Aur dunya ki zindagi ko tarjeeh di thi"
        },
        {
          "id": -1005750,
          "resource_id": "ur.maududi",
          "text": "اور دنیا کی زندگی کو ترجیح دی تھی"
        },
        {
          "id": -2005750,
          "resource_id": 227,
          "text": "మరియు ఐహిక జీవితానికి ప్రాధాన్యత నిచ్చిన వాడికి;"
        }
      ]
    },
    {
      "id": 5751,
      "verse_number": 39,
      "verse_key": "79:39",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407454,
          "resource_id": 85,
          "text": "Hell will be home;"
        },
        {
          "id": 1550188,
          "resource_id": 831,
          "text": "dozakh hi uska thikana hogi"
        },
        {
          "id": -1005751,
          "resource_id": "ur.maududi",
          "text": "دوزخ ہی اس کا ٹھکانا ہوگی"
        },
        {
          "id": -2005751,
          "resource_id": 227,
          "text": "నిశ్చయంగా, నరకాగ్నియే, వాని నివాస స్థానమవుతుంది!"
        }
      ]
    },
    {
      "id": 5752,
      "verse_number": 40,
      "verse_key": "79:40",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407455,
          "resource_id": 85,
          "text": "for anyone who feared the meeting with his Lord and restrained himself from base desires,"
        },
        {
          "id": 1550189,
          "resource_id": 831,
          "text": "Aur jisne apne Rubb ke samney khade honay ka khauf kiya tha aur nafs ko buri khwaishaat se baaz rakha tha"
        },
        {
          "id": -1005752,
          "resource_id": "ur.maududi",
          "text": "اور جس نے اپنے رب کے سامنے کھڑے ہونے کا خوف کیا تھا اور نفس کو بری خواہشات سے باز رکھا تھا"
        },
        {
          "id": -2005752,
          "resource_id": 227,
          "text": "మరియు తన ప్రభువు ముందు నిలబడ వలసి వుంటుందన్న భయంతో తన మనస్సును దుష్టవాంఛలకు దూరంగా ఉంచిన వ్యక్తికి;"
        }
      ]
    },
    {
      "id": 5753,
      "verse_number": 41,
      "verse_key": "79:41",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407456,
          "resource_id": 85,
          "text": "Paradise will be home."
        },
        {
          "id": 1550190,
          "resource_id": 831,
          "text": "Jannat uska thikana hogi"
        },
        {
          "id": -1005753,
          "resource_id": "ur.maududi",
          "text": "جنت اس کا ٹھکانا ہوگی"
        },
        {
          "id": -2005753,
          "resource_id": 227,
          "text": "నిశ్చయంగా, స్వర్గమే, అతని నివాస స్థానమవుతుంది!"
        }
      ]
    },
    {
      "id": 5754,
      "verse_number": 42,
      "verse_key": "79:42",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407457,
          "resource_id": 85,
          "text": "They ask you [Prophet] about the Hour,"
        },
        {
          "id": 1550191,
          "resource_id": 831,
          "text": "Yeh log tumse puchte hain ke aakhir woh ghadi kab aakar thehre gi"
        },
        {
          "id": -1005754,
          "resource_id": "ur.maududi",
          "text": "یہ لوگ تم سے پوچھتے ہیں کہ \"آخر وہ گھڑی کب آ کر ٹھیرے گی؟\""
        },
        {
          "id": -2005754,
          "resource_id": 227,
          "text": "(ఓ ముహమ్మద్!) వీరు నిన్ను - ఆ ఘడియను గురించి: \"అసలు అది ఎప్పుడొస్తుంది?\" అని అడుగుతున్నారు."
        }
      ]
    },
    {
      "id": 5755,
      "verse_number": 43,
      "verse_key": "79:43",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فِيمَ أَنتَ مِن ذِكْرَىٰهَآ",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407458,
          "resource_id": 85,
          "text": "saying, ‘When will it arrive?’, but how can you tell [them that]?"
        },
        {
          "id": 1550192,
          "resource_id": 831,
          "text": "Tumhara kya kaam ke us ka waqt batao"
        },
        {
          "id": -1005755,
          "resource_id": "ur.maududi",
          "text": "تمہارا کیا کام کہ اس کا وقت بتاؤ"
        },
        {
          "id": -2005755,
          "resource_id": 227,
          "text": "దాని గురించి చెప్పడానికి దాంతో నీకేమి సంబంధం?"
        }
      ]
    },
    {
      "id": 5756,
      "verse_number": 44,
      "verse_key": "79:44",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407459,
          "resource_id": 85,
          "text": "Its time is known only to your Lord;"
        },
        {
          "id": 1550193,
          "resource_id": 831,
          "text": "Us ka ilm to Allah par khatm hai"
        },
        {
          "id": -1005756,
          "resource_id": "ur.maududi",
          "text": "اس کا علم تو اللہ پر ختم ہے"
        },
        {
          "id": -2005756,
          "resource_id": 227,
          "text": "దాని వాస్తవ జ్ఞానం నీ ప్రభువుకే ఉంది!"
        }
      ]
    },
    {
      "id": 5757,
      "verse_number": 45,
      "verse_key": "79:45",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407460,
          "resource_id": 85,
          "text": "you are only sent to warn those who fear it."
        },
        {
          "id": 1550194,
          "resource_id": 831,
          "text": "Tum sirf khabardar karne waley ho har us shaks ko jo uska khauff karey"
        },
        {
          "id": -1005757,
          "resource_id": "ur.maududi",
          "text": "تم صرف خبردار کرنے والے ہو ہر اُس شخص کو جو اُس کا خوف کرے"
        },
        {
          "id": -2005757,
          "resource_id": 227,
          "text": "(ఓ ముహమ్మద్!) నిశ్చయంగా, నీవు, దానికి భయపడే వారిని హెచ్చరించే వాడవు మాత్రమే!"
        }
      ]
    },
    {
      "id": 5758,
      "verse_number": 46,
      "verse_key": "79:46",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 523,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا",
      "page_number": 584,
      "juz_number": 30,
      "translations": [
        {
          "id": 407461,
          "resource_id": 85,
          "text": "On the Day they see it, it will seem they lingered [in this life] an evening [at most,] or its morning."
        },
        {
          "id": 1550195,
          "resource_id": 831,
          "text": "Jis roz yeh log usey dekh lengey to inhein yun mehsoos hoga ke (yeh duniya mein ya halat-e-mout mei) bas ek din ke pichle pehar ya aglay pehar tak thehrey hai"
        },
        {
          "id": -1005758,
          "resource_id": "ur.maududi",
          "text": "جس روز یہ لوگ اسے دیکھ لیں گے تو انہیں یوں محسوس ہوگا کہ (یہ دنیا میں یا حالت موت میں) بس ایک دن کے پچھلے پہر یا اگلے پہر تک ٹھیرے ہیں"
        },
        {
          "id": -2005758,
          "resource_id": 227,
          "text": "వారు దానిని చూసిన రోజు (తాము ప్రపంచంలో) కేవలం ఒక సాయంత్రమో లేక ఒక ఉదయమో గడిపినట్లు భావిస్తారు."
        }
      ]
    }
  ]
}