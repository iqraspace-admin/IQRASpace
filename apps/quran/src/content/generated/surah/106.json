  "verses": [
    {
      "id": 6194,
      "verse_number": 1,
      "verse_key": "106:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 550,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " لِإِيلَـٰفِ قُرَيْشٍ",
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 407897,
          "resource_id": 85,
          "text": "[He did this] to make the Quraysh feel secure,"
        },
        {
          "id": 1550631,
          "resource_id": 831,
          "text": "Chunke Quresh manoos huey"
        },
        {
          "id": -1006194,
          "resource_id": "ur.maududi",
          "text": "چونکہ قریش مانوس ہوئے"
        },
        {
          "id": -2006194,
          "resource_id": 227,
          "text": "(అల్లాహ్ రక్షణ మరియు ఆయన కరుణతో) ఖురైషులు (ప్రయాణాలకు) అలవాటు పడ్డారు."
        }
      ]
    },
    {
      "id": 6195,
      "verse_number": 2,
      "verse_key": "106:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 550,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِۦلَـٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ",
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 407898,
          "resource_id": 85,
          "text": "secure in their winter and summer journeys."
        },
        {
          "id": 1550632,
          "resource_id": 831,
          "text": "(yani) Jaadey(winter) aur garmi ke safaron se manoos"
        },
        {
          "id": -1006195,
          "resource_id": "ur.maududi",
          "text": "(یعنی) جاڑے اور گرمی کے سفروں سے مانوس"
        },
        {
          "id": -2006195,
          "resource_id": 227,
          "text": "(అల్లాహ్ కరుణ మరియు ఆయన రక్షణతో) వారు శీతాకాలపు మరియు వేసవి కాలపు ప్రయాణాలు చేయ గలుగుతున్నారు."
        }
      ]
    },
    {
      "id": 6196,
      "verse_number": 3,
      "verse_key": "106:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 550,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَلْيَعْبُدُوا۟ رَبَّ هَـٰذَا ٱلْبَيْتِ",
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 407899,
          "resource_id": 85,
          "text": "So let them worship the Lord of this House:"
        },
        {
          "id": 1550633,
          "resource_id": 831,
          "text": "Lihaza un ko chahiye ke is ghar ke Rubb ki ibadat karein"
        },
        {
          "id": -1006196,
          "resource_id": "ur.maududi",
          "text": "لہٰذا اُن کو چاہیے کہ اِس گھر کے رب کی عبادت کریں"
        },
        {
          "id": -2006196,
          "resource_id": 227,
          "text": "కావున వారు ఆ ఆలయ (కఅబహ్) ప్రభువు (అల్లాహ్)ను మాత్రమే ఆరాధించాలి!"
        }
      ]
    },
    {
      "id": 6197,
      "verse_number": 4,
      "verse_key": "106:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 550,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍ وَءَامَنَهُم مِّنْ خَوْفٍۭ",
      "page_number": 602,
      "juz_number": 30,
      "translations": [
        {
          "id": 407900,
          "resource_id": 85,
          "text": "who provides them with food to ward off hunger, safety to ward off fear."
        },
        {
          "id": 1550634,
          "resource_id": 831,
          "text": "Jisne unhein bhook se bacha kar khane ko diya aur khauf se bacha kar aman ata kiya"
        },
        {
          "id": -1006197,
          "resource_id": "ur.maududi",
          "text": "جس نے اُنہیں بھوک سے بچا کر کھانے کو دیا اور خوف سے بچا کر امن عطا کیا"
        },
        {
          "id": -2006197,
          "resource_id": 227,
          "text": "వారు ఆకలితో ఉన్నప్పుడు ఆయనే వారికి ఆహారమిచ్చాడు మరియు ఆయనే వారిని భయం (ప్రమాదం) నుండి కాపాడాడు."
        }
      ]
    }
  ]
}