{
  "syncedAt": "2026-08-31T09:57:51.434Z",
  "chapter": {
    "id": 91,
    "revelation_place": "makkah",
    "revelation_order": 26,
    "bismillah_pre": true,
    "name_simple": "Ash-Shams",
    "name_complex": "Ash-Shams",
    "name_arabic": "الشمس",
    "verses_count": 15,
    "pages": [
      595,
      595
    ],
    "translated_name": {
      "language_name": "english",
      "name": "The Sun"
    }
  },
  "verses": [
    {
      "id": 6044,
      "verse_number": 1,
      "verse_key": "91:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " وَٱلشَّمْسِ وَضُحَىٰهَا",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407747,
          "resource_id": 85,
          "text": "By the sun in its morning brightness"
        },
        {
          "id": 1550481,
          "resource_id": 831,
          "text": "Suraj aur uski dhoop ki kasam"
        },
        {
          "id": -1006044,
          "resource_id": "ur.maududi",
          "text": "سورج اور اُس کی دھوپ کی قسم"
        },
        {
          "id": -2006044,
          "resource_id": 227,
          "text": "సూర్యుని మరియు దాని ఎండ సాక్షిగా!"
        }
      ]
    },
    {
      "id": 6045,
      "verse_number": 2,
      "verse_key": "91:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلْقَمَرِ إِذَا تَلَىٰهَا",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407748,
          "resource_id": 85,
          "text": "and by the moon as it follows it,"
        },
        {
          "id": 1550482,
          "resource_id": 831,
          "text": "Aur Chand ki kasam jabke wo uske pichey aata hai"
        },
        {
          "id": -1006045,
          "resource_id": "ur.maududi",
          "text": "اور چاند کی قسم جبکہ وہ اُس کے پیچھے آتا ہے"
        },
        {
          "id": -2006045,
          "resource_id": 227,
          "text": "దాని వెనుక వచ్చే చంద్రుని సాక్షిగా!"
        }
      ]
    },
    {
      "id": 6046,
      "verse_number": 3,
      "verse_key": "91:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407749,
          "resource_id": 85,
          "text": "by the day as it displays the sun’s glory"
        },
        {
          "id": 1550483,
          "resource_id": 831,
          "text": "Aur din ki kasam jabke woh (Suraj ko) numaya kar deta hai"
        },
        {
          "id": -1006046,
          "resource_id": "ur.maududi",
          "text": "اور دن کی قسم جبکہ وہ (سورج کو) نمایاں کر دیتا ہے"
        },
        {
          "id": -2006046,
          "resource_id": 227,
          "text": "ప్రకాశించే పగటి సాక్షిగా!"
        }
      ]
    },
    {
      "id": 6047,
      "verse_number": 4,
      "verse_key": "91:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407750,
          "resource_id": 85,
          "text": "and by the night as it conceals it,"
        },
        {
          "id": 1550484,
          "resource_id": 831,
          "text": "Aur raat ki kasam jabke woh (suraj ko) dhank leti hai"
        },
        {
          "id": -1006047,
          "resource_id": "ur.maududi",
          "text": "اور رات کی قسم جبکہ وہ (سورج کو) ڈھانک لیتی ہے"
        },
        {
          "id": -2006047,
          "resource_id": 227,
          "text": "దానిని క్రమ్ముకునే, రాత్రి సాక్షిగా!"
        }
      ]
    },
    {
      "id": 6048,
      "verse_number": 5,
      "verse_key": "91:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407751,
          "resource_id": 85,
          "text": "by the sky and how He built it"
        },
        {
          "id": 1550485,
          "resource_id": 831,
          "text": "Aur aasman ki aur us zaat ki kasam jisne usey qayam kiya"
        },
        {
          "id": -1006048,
          "resource_id": "ur.maududi",
          "text": "اور آسمان کی اور اُس ذات کی قسم جس نے اُسے قائم کیا"
        },
        {
          "id": -2006048,
          "resource_id": 227,
          "text": "ఆకాశం మరియు దానిని నిర్మించిన ఆయన (అల్లాహ్) సాక్షిగా!"
        }
      ]
    },
    {
      "id": 6049,
      "verse_number": 6,
      "verse_key": "91:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407752,
          "resource_id": 85,
          "text": "and by the earth and how He spread it,"
        },
        {
          "id": 1550486,
          "resource_id": 831,
          "text": "Aur zameen ki aur us zaat ki kasam jisne usey bichaya"
        },
        {
          "id": -1006049,
          "resource_id": "ur.maududi",
          "text": "اور زمین کی اور اُس ذات کی قسم جس نے اُسے بچھایا"
        },
        {
          "id": -2006049,
          "resource_id": 227,
          "text": "భూమి మరియు దానిని విస్తరింపజేసిన ఆయన సాక్షిగా!"
        }
      ]
    },
    {
      "id": 6050,
      "verse_number": 7,
      "verse_key": "91:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَنَفْسٍ وَمَا سَوَّىٰهَا",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407753,
          "resource_id": 85,
          "text": "by the soul and how He formed it"
        },
        {
          "id": 1550487,
          "resource_id": 831,
          "text": "Aur nafs-e-Insani ki aur us zaat ki kasam jisne usey hamwar kiya"
        },
        {
          "id": -1006050,
          "resource_id": "ur.maududi",
          "text": "اور نفس انسانی کی اور اُس ذات کی قسم جس نے اُسے ہموار کیا"
        },
        {
          "id": -2006050,
          "resource_id": 227,
          "text": "మానవ ఆత్మ మరియు దానిని తీర్చిదిద్దిన ఆయన సాక్షిగా!"
        }
      ]
    },
    {
      "id": 6051,
      "verse_number": 8,
      "verse_key": "91:8",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407754,
          "resource_id": 85,
          "text": "and inspired it [to know] its own rebellion and piety!"
        },
        {
          "id": 1550488,
          "resource_id": 831,
          "text": "Phir uski badi aur uski parhezgari uss par ilham kar di"
        },
        {
          "id": -1006051,
          "resource_id": "ur.maududi",
          "text": "پھر اُس کی بدی اور اُس کی پرہیز گاری اس پر الہام کر دی"
        },
        {
          "id": -2006051,
          "resource_id": 227,
          "text": "ఆ తరువాత ఆయనే దానికి దుష్టతనాన్ని మరియు దైవభీతిని తెలియజేశాడు."
        }
      ]
    },
    {
      "id": 6052,
      "verse_number": 9,
      "verse_key": "91:9",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407755,
          "resource_id": 85,
          "text": "The one who purifies his soul succeeds"
        },
        {
          "id": 1550489,
          "resource_id": 831,
          "text": "Yaqeenan falah pa gaya woh jisne nafs ka tazkiya kiya"
        },
        {
          "id": -1006052,
          "resource_id": "ur.maududi",
          "text": "یقیناً فلاح پا گیا وہ جس نے نفس کا تزکیہ کیا"
        },
        {
          "id": -2006052,
          "resource_id": 227,
          "text": "వాస్తవానికి తన ఆత్మను శుద్ధపరచుకున్నవాడే సఫలుడవుతాడు."
        }
      ]
    },
    {
      "id": 6053,
      "verse_number": 10,
      "verse_key": "91:10",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَقَدْ خَابَ مَن دَسَّىٰهَا",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407756,
          "resource_id": 85,
          "text": "and the one who corrupts it fails."
        },
        {
          "id": 1550490,
          "resource_id": 831,
          "text": "Aur na-murad hua woh jisne usko daba diya"
        },
        {
          "id": -1006053,
          "resource_id": "ur.maududi",
          "text": "اور نامراد ہوا وہ جس نے اُس کو دبا دیا"
        },
        {
          "id": -2006053,
          "resource_id": 227,
          "text": "మరియు వాస్తవానికి దానిని అణగ ద్రొక్కిన వాడే విఫలుడవుతాడు."
        }
      ]
    },
    {
      "id": 6054,
      "verse_number": 11,
      "verse_key": "91:11",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407757,
          "resource_id": 85,
          "text": "In their arrogant cruelty, the people of Thamud called [their messenger] a liar,"
        },
        {
          "id": 1550491,
          "resource_id": 831,
          "text": "Samood ne apni sarkashi ki bina par jhutlaya"
        },
        {
          "id": -1006054,
          "resource_id": "ur.maududi",
          "text": "ثمود نے اپنی سرکشی کی بنا پر جھٹلایا"
        },
        {
          "id": -2006054,
          "resource_id": 227,
          "text": "సమూద్ జాతి తలబిరుసుతనంతో (ప్రవక్తను) అసత్యవాదుడవని తిరస్కరించింది; తమలోని పరమ దుష్టుడు (ఆ దుష్కార్యం చేయటానికి) లేచినప్పుడు;"
        }
      ]
    },
    {
      "id": 6055,
      "verse_number": 12,
      "verse_key": "91:12",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407758,
          "resource_id": 85,
          "text": "when the most wicked man among them rose [against him]."
        },
        {
          "id": 1550492,
          "resource_id": 831,
          "text": "Jab us qaum ka sab se zyada shaqi (Badnaseeb) aadmi biphar kar utha"
        },
        {
          "id": -1006055,
          "resource_id": "ur.maududi",
          "text": "جب اُس قوم کا سب سے زیادہ شقی آدمی بپھر کر اٹھا"
        },
        {
          "id": -2006055,
          "resource_id": 227,
          "text": "అల్లాహ్ సందేశహరుడు (సాలిహ్) వారితో: \"ఈ ఆడ ఒంటె అల్లాహ్ కు చెందింది. కాబట్టి దీనిని (నీళ్ళు) త్రాగనివ్వండి!\" అని అన్నాడు."
        }
      ]
    },
    {
      "id": 6056,
      "verse_number": 13,
      "verse_key": "91:13",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَـٰهَا",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407759,
          "resource_id": 85,
          "text": "The messenger of God said to them, ‘[Leave] God’s camel to drink,’"
        },
        {
          "id": 1550493,
          "resource_id": 831,
          "text": "To Allah ke Rasool ne un logon se kaha ke khabardar Allah ki ountni (she-camel) ko (haath na lagana) aur uske paani peene (mein maane na hona)"
        },
        {
          "id": -1006056,
          "resource_id": "ur.maududi",
          "text": "تو اللہ کے رسول نے اُن لوگوں سے کہا کہ خبردار، اللہ کی اونٹنی کو (ہاتھ نہ لگانا) اوراُس کے پانی پینے (میں مانع نہ ہونا)"
        },
        {
          "id": -2006056,
          "resource_id": 227,
          "text": "అయినా వారు అతని (సాలిహ్) మాటను అబద్ధమని తిరస్కరించారు. మరియు దాని (ఆ ఒంటె) వెనక మోకాలి నరాన్ని కోసి, కుంటిదాన్ని చేసి చంపారు."
        }
      ]
    },
    {
      "id": 6057,
      "verse_number": 14,
      "verse_key": "91:14",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407760,
          "resource_id": 85,
          "text": "but they called him a liar and hamstrung her. Their Lord destroyed them for their crime and levelled them."
        },
        {
          "id": 1550494,
          "resource_id": 831,
          "text": "Magar unhon ne uski baat ko jhuta qarar diya aur ountni ko maar dala. Aakhir-e-kaar unke gunah ke padash mein unke Rubb ne unpar aisi aafat toodi ke ek saath sab ko paywand-e-khaaq kar diya"
        },
        {
          "id": -1006057,
          "resource_id": "ur.maududi",
          "text": "مگر انہوں نے اُس کی بات کو جھوٹا قرار دیا اور اونٹنی کو مار ڈالا آخرکار اُن کے گناہ کی پاداش میں ان کے رب نے ان پر ایسی آفت توڑی کہ ایک ساتھ سب کو پیوند خاک کر دیا"
        },
        {
          "id": -2006057,
          "resource_id": 227,
          "text": "కాబట్టి వారి ప్రభువు వారి పాపానికి పర్యవసానంగా వారి మీద మహా విపత్తును పంపి వారందరినీ నాశనం చేశాడు."
        }
      ]
    },
    {
      "id": 6058,
      "verse_number": 15,
      "verse_key": "91:15",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 535,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَا يَخَافُ عُقْبَـٰهَا",
      "page_number": 595,
      "juz_number": 30,
      "translations": [
        {
          "id": 407761,
          "resource_id": 85,
          "text": "He did not hesitate to punish them."
        },
        {
          "id": 1550495,
          "resource_id": 831,
          "text": "Aur usey (apne is fail kay) kisi burey natije ka koi khauf(darr) nahin hai"
        },
        {
          "id": -1006058,
          "resource_id": "ur.maududi",
          "text": "اور اسے (اپنے ا س فعل کے) کسی برے نتیجے کا کوئی خوف نہیں ہے"
        },
        {
          "id": -2006058,
          "resource_id": 227,
          "text": "మరియు ఆయన (అల్లాహ్) దాని పర్యవసానాన్ని గురించి భయపడలేదు!"
        }
      ]
    }
  ]
}