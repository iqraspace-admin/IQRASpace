{
  "syncedAt": "2026-08-31T09:57:52.257Z",
  "chapter": {
    "id": 93,
    "revelation_place": "makkah",
    "revelation_order": 11,
    "bismillah_pre": true,
    "name_simple": "Ad-Duhaa",
    "name_complex": "Ađ-Đuĥaá",
    "name_arabic": "الضحى",
    "verses_count": 11,
    "pages": [
      596,
      596
    ],
    "translated_name": {
      "language_name": "english",
      "name": "The Morning Hours"
    }
  },
  "verses": [
    {
      "id": 6080,
      "verse_number": 1,
      "verse_key": "93:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 537,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " وَٱلضُّحَىٰ",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407783,
          "resource_id": 85,
          "text": "By the morning brightness"
        },
        {
          "id": 1550517,
          "resource_id": 831,
          "text": "Kasam hai rozey roshan ki"
        },
        {
          "id": -1006080,
          "resource_id": "ur.maududi",
          "text": "قسم ہے روز روشن کی"
        },
        {
          "id": -2006080,
          "resource_id": 227,
          "text": "ప్రకాశవంతమైన ప్రొద్దుటి పూట (పూర్వాహ్ణం) సాక్షిగా!"
        }
      ]
    },
    {
      "id": 6081,
      "verse_number": 2,
      "verse_key": "93:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 537,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلَّيْلِ إِذَا سَجَىٰ",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407784,
          "resource_id": 85,
          "text": "and by the night when it grows still,"
        },
        {
          "id": 1550518,
          "resource_id": 831,
          "text": "Aur raat ki jabke woh sukoon ke saath taari ho jaye"
        },
        {
          "id": -1006081,
          "resource_id": "ur.maududi",
          "text": "اور رات کی جبکہ وہ سکون کے ساتھ طاری ہو جائے"
        },
        {
          "id": -2006081,
          "resource_id": 227,
          "text": "మరియు చీకటి పడ్డ రాత్రి సాక్షిగా!"
        }
      ]
    },
    {
      "id": 6082,
      "verse_number": 3,
      "verse_key": "93:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 537,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407785,
          "resource_id": 85,
          "text": "your Lord has not forsaken you [Prophet], nor does He hate you,"
        },
        {
          "id": 1550519,
          "resource_id": 831,
          "text": "(Aey nabi) tumharey Rubb ne tumko hargiz nahin chodha aur na woh naraaz hua"
        },
        {
          "id": -1006082,
          "resource_id": "ur.maududi",
          "text": "(اے نبیؐ) تمہارے رب نے تم کو ہرگز نہیں چھوڑا اور نہ وہ ناراض ہوا"
        },
        {
          "id": -2006082,
          "resource_id": 227,
          "text": "(ఓ ముహమ్మద్!) నీ ప్రభువు, నిన్ను త్యజించనూ లేదు మరియు నిన్ను ఉపేక్షించనూ లేదు."
        }
      ]
    },
    {
      "id": 6083,
      "verse_number": 4,
      "verse_key": "93:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 537,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَلْـَٔاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407786,
          "resource_id": 85,
          "text": "and the future will be better for you than the past;"
        },
        {
          "id": 1550520,
          "resource_id": 831,
          "text": "Aur yaqeenan tumhare liya baad ka daur pehle daur se behtar hai"
        },
        {
          "id": -1006083,
          "resource_id": "ur.maududi",
          "text": "اور یقیناً تمہارے لیے بعد کا دور پہلے دور سے بہتر ہے"
        },
        {
          "id": -2006083,
          "resource_id": 227,
          "text": "మరియు రాబోయే కాలం (జీవితం) నీ కొరకు మొదటి కాలం (జీవితం) కంటే ఎంతో మేలైనది!"
        }
      ]
    },
    {
      "id": 6084,
      "verse_number": 5,
      "verse_key": "93:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 537,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407787,
          "resource_id": 85,
          "text": "your Lord is sure to give you so much that you will be well satisfied."
        },
        {
          "id": 1550521,
          "resource_id": 831,
          "text": "Aur anqareeb tumhra Rubb tumko itna dega ke tum khush ho jaogey"
        },
        {
          "id": -1006084,
          "resource_id": "ur.maududi",
          "text": "اور عنقریب تمہارا رب تم کو اتنا دے گا کہ تم خوش ہو جاؤ گے"
        },
        {
          "id": -2006084,
          "resource_id": 227,
          "text": "మరియు త్వరలోనే నీ ప్రభువు నీకు (నీవు కోరేది) ప్రసాదిస్తాడు. దానితో నీవు సంతోషపడతావు."
        }
      ]
    },
    {
      "id": 6085,
      "verse_number": 6,
      "verse_key": "93:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 537,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔاوَىٰ",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407788,
          "resource_id": 85,
          "text": "Did He not find you an orphan and shelter you?"
        },
        {
          "id": 1550522,
          "resource_id": 831,
          "text": "Kya usne tumko yateem nahin paya aur phir thikana faraham kiya"
        },
        {
          "id": -1006085,
          "resource_id": "ur.maududi",
          "text": "کیا اس نے تم کو یتیم نہیں پایا اور پھر ٹھکانا فراہم کیا؟"
        },
        {
          "id": -2006085,
          "resource_id": 227,
          "text": "(ఓ ముహమ్మద్!) ఏమీ? నిన్ను అనాథునిగా చూసి, ఆయన (అల్లాహ్) నీకు ఆశ్రయం కల్పించలేదా?"
        }
      ]
    },
    {
      "id": 6086,
      "verse_number": 7,
      "verse_key": "93:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 537,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَوَجَدَكَ ضَآلًّا فَهَدَىٰ",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407789,
          "resource_id": 85,
          "text": "Did He not find you lost and guide you?"
        },
        {
          "id": 1550523,
          "resource_id": 831,
          "text": "Aur tumhey nawaqif-e-raah paya aur phir hidayat bakshi"
        },
        {
          "id": -1006086,
          "resource_id": "ur.maududi",
          "text": "اور تمہیں ناواقف راہ پایا اور پھر ہدایت بخشی"
        },
        {
          "id": -2006086,
          "resource_id": 227,
          "text": "మరియు నీకు మార్గం తోచనప్పుడు, ఆయన నీకు మార్గదర్శకత్వం చేయలేదా?"
        }
      ]
    },
    {
      "id": 6087,
      "verse_number": 8,
      "verse_key": "93:8",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 537,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَوَجَدَكَ عَآئِلًا فَأَغْنَىٰ",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407790,
          "resource_id": 85,
          "text": "Did He not find you in need and make you self-sufficient?"
        },
        {
          "id": 1550524,
          "resource_id": 831,
          "text": "Aur tumhein nadaar(in want) paya aur phir maldar kar diya"
        },
        {
          "id": -1006087,
          "resource_id": "ur.maududi",
          "text": "اور تمہیں نادار پایا اور پھر مالدار کر دیا"
        },
        {
          "id": -2006087,
          "resource_id": 227,
          "text": "మరియు ఆయన, పేదవానిగా చూసి, నిన్ను సంపన్నుడిగా చేయలేదా?"
        }
      ]
    },
    {
      "id": 6088,
      "verse_number": 9,
      "verse_key": "93:9",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 537,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407791,
          "resource_id": 85,
          "text": "So do not be harsh with the orphan"
        },
        {
          "id": 1550525,
          "resource_id": 831,
          "text": "Lihaza yateem par sakhti na karo"
        },
        {
          "id": -1006088,
          "resource_id": "ur.maududi",
          "text": "لہٰذا یتیم پر سختی نہ کرو"
        },
        {
          "id": -2006088,
          "resource_id": 227,
          "text": "కాబట్టి నీవు అనాథుల పట్ల కఠినంగా ప్రవర్తించకు;"
        }
      ]
    },
    {
      "id": 6089,
      "verse_number": 10,
      "verse_key": "93:10",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 537,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407792,
          "resource_id": 85,
          "text": "and do not chide the one who asks for help;"
        },
        {
          "id": 1550526,
          "resource_id": 831,
          "text": "Aur saayil(maangne waley) ko na jhidko"
        },
        {
          "id": -1006089,
          "resource_id": "ur.maududi",
          "text": "اور سائل کو نہ جھڑکو"
        },
        {
          "id": -2006089,
          "resource_id": 227,
          "text": "మరియు యాచకుణ్ణి కసరుకోకు;"
        }
      ]
    },
    {
      "id": 6090,
      "verse_number": 11,
      "verse_key": "93:11",
      "hizb_number": 60,
      "rub_el_hizb_number": 238,
      "ruku_number": 537,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ",
      "page_number": 596,
      "juz_number": 30,
      "translations": [
        {
          "id": 407793,
          "resource_id": 85,
          "text": "talk about the blessings of your Lord."
        },
        {
          "id": 1550527,
          "resource_id": 831,
          "text": "Aur apne Rubb ki niyamt ka izhar karo"
        },
        {
          "id": -1006090,
          "resource_id": "ur.maududi",
          "text": "اور اپنے رب کی نعمت کا اظہار کرو"
        },
        {
          "id": -2006090,
          "resource_id": 227,
          "text": "మరియు నీ ప్రభువు అనుగ్రహాలను బహిరంగంగా ప్రకటిస్తూ ఉండు."
        }
      ]
    }
  ]
}