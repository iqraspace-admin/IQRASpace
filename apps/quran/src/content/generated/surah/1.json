  "verses": [
    {
      "id": 1,
      "verse_number": 1,
      "verse_key": "1:1",
      "hizb_number": 1,
      "rub_el_hizb_number": 1,
      "ruku_number": 1,
      "manzil_number": 1,
      "sajdah_number": null,
      "text_uthmani": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ",
      "page_number": 1,
      "juz_number": 1,
      "translations": [
        {
          "id": 401704,
          "resource_id": 85,
          "text": "In the name of God, the Lord of Mercy, the Giver of Mercy!"
        },
        {
          "id": 1544438,
          "resource_id": 831,
          "text": "Allah ke naam se jo Rehman o Raheem hai"
        },
        {
          "id": -1000001,
          "resource_id": "ur.maududi",
          "text": "اللہ کے نام سے جو رحمان و رحیم ہے"
        },
        {
          "id": -2000001,
          "resource_id": 227,
          "text": "అనంత కరుణామయుడు అపార కరుణా ప్రదాత అయిన అల్లాహ్ పేరుతో"
        }
      ]
    },
    {
      "id": 2,
      "verse_number": 2,
      "verse_key": "1:2",
      "hizb_number": 1,
      "rub_el_hizb_number": 1,
      "ruku_number": 1,
      "manzil_number": 1,
      "sajdah_number": null,
      "text_uthmani": "ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ",
      "page_number": 1,
      "juz_number": 1,
      "translations": [
        {
          "id": 401705,
          "resource_id": 85,
          "text": "Praise belongs to God, Lord of the Worlds,"
        },
        {
          "id": 1544439,
          "resource_id": 831,
          "text": "Tareef Allah hi ke liye hai jo tamaam qayinaat ka Rubb hai"
        },
        {
          "id": -1000002,
          "resource_id": "ur.maududi",
          "text": "تعریف اللہ ہی کے لیے ہے جو تمام کائنات کا رب ہے"
        },
        {
          "id": -2000002,
          "resource_id": 227,
          "text": "సర్వలోకాలకు ప్రభువైన అల్లాహ్ మాత్రమే సమస్త స్తోత్రాలకు అర్హుడు."
        }
      ]
    },
    {
      "id": 3,
      "verse_number": 3,
      "verse_key": "1:3",
      "hizb_number": 1,
      "rub_el_hizb_number": 1,
      "ruku_number": 1,
      "manzil_number": 1,
      "sajdah_number": null,
      "text_uthmani": "ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ",
      "page_number": 1,
      "juz_number": 1,
      "translations": [
        {
          "id": 401706,
          "resource_id": 85,
          "text": "the Lord of Mercy, the Giver of Mercy,"
        },
        {
          "id": 1544440,
          "resource_id": 831,
          "text": "Rehman aur Raheem hai"
        },
        {
          "id": -1000003,
          "resource_id": "ur.maududi",
          "text": "رحمان اور رحیم ہے"
        },
        {
          "id": -2000003,
          "resource_id": 227,
          "text": "అనంత కరుణామయుడు, అపార కరుణా ప్రదాత"
        }
      ]
    },
    {
      "id": 4,
      "verse_number": 4,
      "verse_key": "1:4",
      "hizb_number": 1,
      "rub_el_hizb_number": 1,
      "ruku_number": 1,
      "manzil_number": 1,
      "sajdah_number": null,
      "text_uthmani": "مَـٰلِكِ يَوْمِ ٱلدِّينِ",
      "page_number": 1,
      "juz_number": 1,
      "translations": [
        {
          "id": 401707,
          "resource_id": 85,
          "text": "Master of the Day of Judgement."
        },
        {
          "id": 1544441,
          "resource_id": 831,
          "text": "Roz e jaza ka maalik hai"
        },
        {
          "id": -1000004,
          "resource_id": "ur.maududi",
          "text": "روز جزا کا مالک ہے"
        },
        {
          "id": -2000004,
          "resource_id": 227,
          "text": "తీర్పుదినానికి స్వామి"
        }
      ]
    },
    {
      "id": 5,
      "verse_number": 5,
      "verse_key": "1:5",
      "hizb_number": 1,
      "rub_el_hizb_number": 1,
      "ruku_number": 1,
      "manzil_number": 1,
      "sajdah_number": null,
      "text_uthmani": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ",
      "page_number": 1,
      "juz_number": 1,
      "translations": [
        {
          "id": 401708,
          "resource_id": 85,
          "text": "It is You we worship; it is You we ask for help."
        },
        {
          "id": 1544442,
          "resource_id": 831,
          "text": "Hum teri hi ibadat karte hain aur tujh hi se madad maangte hain"
        },
        {
          "id": -1000005,
          "resource_id": "ur.maududi",
          "text": "ہم تیری ہی عبادت کرتے ہیں اور تجھی سے مدد مانگتے ہیں"
        },
        {
          "id": -2000005,
          "resource_id": 227,
          "text": "మేము నిన్నే ఆరాధిస్తున్నాము మరియు నీ సహాయాన్నే అర్థిస్తున్నాము"
        }
      ]
    },
    {
      "id": 6,
      "verse_number": 6,
      "verse_key": "1:6",
      "hizb_number": 1,
      "rub_el_hizb_number": 1,
      "ruku_number": 1,
      "manzil_number": 1,
      "sajdah_number": null,
      "text_uthmani": "ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ",
      "page_number": 1,
      "juz_number": 1,
      "translations": [
        {
          "id": 401709,
          "resource_id": 85,
          "text": "Guide us to the straight path:"
        },
        {
          "id": 1544443,
          "resource_id": 831,
          "text": "Humein seedha raasta dikha"
        },
        {
          "id": -1000006,
          "resource_id": "ur.maududi",
          "text": "ہمیں سیدھا راستہ دکھا"
        },
        {
          "id": -2000006,
          "resource_id": 227,
          "text": "మాకు ఋజుమార్గం వైపునకు మార్గదర్శకత్వం చేయి"
        }
      ]
    },
    {
      "id": 7,
      "verse_number": 7,
      "verse_key": "1:7",
      "hizb_number": 1,
      "rub_el_hizb_number": 1,
      "ruku_number": 1,
      "manzil_number": 1,
      "sajdah_number": null,
      "text_uthmani": "صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ",
      "page_number": 1,
      "juz_number": 1,
      "translations": [
        {
          "id": 401710,
          "resource_id": 85,
          "text": "the path of those You have blessed, those who incur no anger and who have not gone astray."
        },
        {
          "id": 1544444,
          "resource_id": 831,
          "text": "Un logon ka raasta jinpar tu nay inam farmaya, jo maatoob nahin huey (na unka jinpar tera gazab hota raha) , jo bhatke huey nahin hain"
        },
        {
          "id": -1000007,
          "resource_id": "ur.maududi",
          "text": "اُن لوگوں کا راستہ جن پر تو نے انعام فرمایا، جو معتوب نہیں ہوئے، جو بھٹکے ہوئے نہیں ہیں"
        },
        {
          "id": -2000007,
          "resource_id": 227,
          "text": "నీవు అనుగ్రహించిన వారి మార్గం మాత్రమే (చూపు) నీ ఆగ్రహానికి గురి అయిన వారి (మార్గం కానీ) లేక మార్గభ్రష్టులైన వారి (మార్గం కానీ) కాదు"
        }
      ]
    }
  ]
}