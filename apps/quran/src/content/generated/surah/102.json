    ],
    "translated_name": {
      "language_name": "english",
      "name": "The Rivalry in world increase"
    }
  },
  "verses": [
    {
      "id": 6169,
      "verse_number": 1,
      "verse_key": "102:1",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 546,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " أَلْهَىٰكُمُ ٱلتَّكَاثُرُ",
      "page_number": 600,
      "juz_number": 30,
      "translations": [
        {
          "id": 407872,
          "resource_id": 85,
          "text": "Striving for more distracts you"
        },
        {
          "id": 1550606,
          "resource_id": 831,
          "text": "Tum logon ko zyada se zyada aur ek dusre se badh kar duniya hasil karne ki dhun ne gaflat mei daal rakha hai"
        },
        {
          "id": -1006169,
          "resource_id": "ur.maududi",
          "text": "تم لوگوں کو زیادہ سے زیادہ اور ایک دوسرے سے بڑھ کر دنیا حاصل کرنے کی دھن نے غفلت میں ڈال رکھا ہے"
        },
        {
          "id": -2006169,
          "resource_id": 227,
          "text": "(ఇహలోక) పేరాస మిమ్మల్ని ఏమరుపాటులో పడవేసింది;"
        }
      ]
    },
    {
      "id": 6170,
      "verse_number": 2,
      "verse_key": "102:2",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 546,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ",
      "page_number": 600,
      "juz_number": 30,
      "translations": [
        {
          "id": 407873,
          "resource_id": 85,
          "text": "until you go into your graves."
        },
        {
          "id": 1550607,
          "resource_id": 831,
          "text": "Yahan tak ke (isi fikr mei) tum lab-e-gaur tak pahunch jatey ho"
        },
        {
          "id": -1006170,
          "resource_id": "ur.maududi",
          "text": "یہاں تک کہ (اسی فکر میں) تم لب گور تک پہنچ جاتے ہو"
        },
        {
          "id": -2006170,
          "resource_id": 227,
          "text": "మీరు గోరీలలోకి చేరే వరకు."
        }
      ]
    },
    {
      "id": 6171,
      "verse_number": 3,
      "verse_key": "102:3",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 546,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّا سَوْفَ تَعْلَمُونَ",
      "page_number": 600,
      "juz_number": 30,
      "translations": [
        {
          "id": 407874,
          "resource_id": 85,
          "text": "No indeed! You will come to know."
        },
        {
          "id": 1550608,
          "resource_id": 831,
          "text": "Hargiz nahin, ankareeb tumko maloom ho jayega"
        },
        {
          "id": -1006171,
          "resource_id": "ur.maududi",
          "text": "ہرگز نہیں، عنقریب تم کو معلوم ہو جائے گا"
        },
        {
          "id": -2006171,
          "resource_id": 227,
          "text": "అలా కాదు! త్వరలోనే మీరు తెలుసు కుంటారు."
        }
      ]
    },
    {
      "id": 6172,
      "verse_number": 4,
      "verse_key": "102:4",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 546,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ",
      "page_number": 600,
      "juz_number": 30,
      "translations": [
        {
          "id": 407875,
          "resource_id": 85,
          "text": "No indeed! In the end you will come to know."
        },
        {
          "id": 1550609,
          "resource_id": 831,
          "text": "phir (sunlo kay) hargiz nahin, ankarib tumko maloom ho jayega"
        },
        {
          "id": -1006172,
          "resource_id": "ur.maududi",
          "text": "پھر (سن لو کہ) ہرگز نہیں، عنقریب تم کو معلوم ہو جائے گا"
        },
        {
          "id": -2006172,
          "resource_id": 227,
          "text": "మరొకసారి (వినండి)! వాస్తవంగా, మీరు అతి త్వరలోనే తెలుసుకుంటారు."
        }
      ]
    },
    {
      "id": 6173,
      "verse_number": 5,
      "verse_key": "102:5",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 546,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ",
      "page_number": 600,
      "juz_number": 30,
      "translations": [
        {
          "id": 407876,
          "resource_id": 85,
          "text": "No indeed! If only you knew for certain."
        },
        {
          "id": 1550610,
          "resource_id": 831,
          "text": "Hargiz nahin agar tum yaqeeni ilm ki haisiyat se (is rawish ke anjam ko) jantey hotey (to tumhara yeh tarze amal na hota)"
        },
        {
          "id": -1006173,
          "resource_id": "ur.maududi",
          "text": "ہرگز نہیں، اگر تم یقینی علم کی حیثیت سے (اِس روش کے انجام کو) جانتے ہوتے (تو تمہارا یہ طرز عمل نہ ہوتا)"
        },
        {
          "id": -2006173,
          "resource_id": 227,
          "text": "ఎంత మాత్రము కాదు! ఒకవేళ మీరు నిశ్చిత జ్ఞానంతో తెలుసుకొని ఉంటే (మీ వైఖరి ఇలా ఉండేది కాదు)."
        }
      ]
    },
    {
      "id": 6174,
      "verse_number": 6,
      "verse_key": "102:6",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 546,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَتَرَوُنَّ ٱلْجَحِيمَ",
      "page_number": 600,
      "juz_number": 30,
      "translations": [
        {
          "id": 407877,
          "resource_id": 85,
          "text": "You will most definitely see Hellfire,"
        },
        {
          "id": 1550611,
          "resource_id": 831,
          "text": "Tum dozakh dekh kar rahogey"
        },
        {
          "id": -1006174,
          "resource_id": "ur.maududi",
          "text": "تم دوزخ دیکھ کر رہو گے"
        },
        {
          "id": -2006174,
          "resource_id": 227,
          "text": "నిశ్చయంగా, మీరు భగభగ మండే నరకాగ్నిని చూడగలరు!"
        }
      ]
    },
    {
      "id": 6175,
      "verse_number": 7,
      "verse_key": "102:7",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 546,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ",
      "page_number": 600,
      "juz_number": 30,
      "translations": [
        {
          "id": 407878,
          "resource_id": 85,
          "text": "you will see it with the eye of certainty."
        },
        {
          "id": 1550612,
          "resource_id": 831,
          "text": "Phir (sun lo ke) tum bilkul yaqeen kay saath usey dekh logey"
        },
        {
          "id": -1006175,
          "resource_id": "ur.maududi",
          "text": "پھر (سن لو کہ) تم بالکل یقین کے ساتھ اُسے دیکھ لو گے"
        },
        {
          "id": -2006175,
          "resource_id": 227,
          "text": "మళ్ళీ అంటున్నాను! మీరు తప్పక దానిని (నరకాగ్నిని) నిస్సంకోచమైన దృష్టితో చూడగలరు!"
        }
      ]
    },
    {
      "id": 6176,
      "verse_number": 8,
      "verse_key": "102:8",
      "hizb_number": 60,
      "rub_el_hizb_number": 240,
      "ruku_number": 546,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ",
      "page_number": 600,
      "juz_number": 30,
      "translations": [
        {
          "id": 407879,
          "resource_id": 85,
          "text": "On that Day, you will be asked about your pleasures."
        },
        {
          "id": 1550613,
          "resource_id": 831,
          "text": "Phir zaroor us roz tum se in neyamaton kay barey mein jawab talabi ki jayegi"
        },
        {
          "id": -1006176,
          "resource_id": "ur.maududi",
          "text": "پھر ضرور اُس روز تم سے اِن نعمتوں کے بارے میں جواب طلبی کی جائے گی"
        },
        {
          "id": -2006176,
          "resource_id": 227,
          "text": "అప్పుడు, ఆ రోజు మీరు (ఈ జీవితంలో అనుభవించిన) సౌఖ్యాలను గురించి తప్పక ప్రశ్నించబడతారు!"
        }
      ]
    }
  ]
}