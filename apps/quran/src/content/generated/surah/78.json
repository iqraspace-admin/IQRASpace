{
  "syncedAt": "2026-08-31T09:57:45.853Z",
  "chapter": {
    "id": 78,
    "revelation_place": "makkah",
    "revelation_order": 80,
    "bismillah_pre": true,
    "name_simple": "An-Naba",
    "name_complex": "An-Naba",
    "name_arabic": "النبإ",
    "verses_count": 40,
    "pages": [
      582,
      583
    ],
    "translated_name": {
      "language_name": "english",
      "name": "The Tidings"
    }
  },
  "verses": [
    {
      "id": 5673,
      "verse_number": 1,
      "verse_key": "78:1",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": " عَمَّ يَتَسَآءَلُونَ",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407376,
          "resource_id": 85,
          "text": "What are they asking about?"
        },
        {
          "id": 1550110,
          "resource_id": 831,
          "text": "Yeh log kis cheez ke baarey mei puch-gajj kar rahe hain"
        },
        {
          "id": -1005673,
          "resource_id": "ur.maududi",
          "text": "یہ لوگ کس چیز کے بارے میں پوچھ گچھ کر رہے ہیں؟"
        },
        {
          "id": -2005673,
          "resource_id": 227,
          "text": "ఏ విషయాన్ని గురించి వారు (ఒకరినొకరు) ప్రశ్నించుకుంటున్నారు?"
        }
      ]
    },
    {
      "id": 5674,
      "verse_number": 2,
      "verse_key": "78:2",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407377,
          "resource_id": 85,
          "text": "The momentous announcement"
        },
        {
          "id": 1550111,
          "resource_id": 831,
          "text": "Kya us badi khabar ke baarey mein"
        },
        {
          "id": -1005674,
          "resource_id": "ur.maududi",
          "text": "کیا اُس بڑی خبر کے بارے میں"
        },
        {
          "id": -2005674,
          "resource_id": 227,
          "text": "ఆ మహా వార్తను గురించేనా?"
        }
      ]
    },
    {
      "id": 5675,
      "verse_number": 3,
      "verse_key": "78:3",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407378,
          "resource_id": 85,
          "text": "about which they differ."
        },
        {
          "id": 1550112,
          "resource_id": 831,
          "text": "Jiske mutaaliq yeh mukhtalif che-mei-goiyan (disagreement) karne mein lagey huey hain"
        },
        {
          "id": -1005675,
          "resource_id": "ur.maududi",
          "text": "جس کے متعلق یہ مختلف چہ میگوئیاں کرنے میں لگے ہوئے ہیں؟"
        },
        {
          "id": -2005675,
          "resource_id": 227,
          "text": "దేనిని గురించైతే వారు భేదాభిప్రాయాలను కలిగి ఉన్నారో?"
        }
      ]
    },
    {
      "id": 5676,
      "verse_number": 4,
      "verse_key": "78:4",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "كَلَّا سَيَعْلَمُونَ",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407379,
          "resource_id": 85,
          "text": "They will find out."
        },
        {
          "id": 1550113,
          "resource_id": 831,
          "text": "Hargiz nahin an-qareeb inhein maloom ho jayega"
        },
        {
          "id": -1005676,
          "resource_id": "ur.maududi",
          "text": "ہرگز نہیں، عنقریب اِنہیں معلوم ہو جائیگا"
        },
        {
          "id": -2005676,
          "resource_id": 227,
          "text": "అది కాదు! వారు త్వరలోనే దానిని తెలుసుకోగలరు."
        }
      ]
    },
    {
      "id": 5677,
      "verse_number": 5,
      "verse_key": "78:5",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ثُمَّ كَلَّا سَيَعْلَمُونَ",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407380,
          "resource_id": 85,
          "text": "In the end they will find out."
        },
        {
          "id": 1550114,
          "resource_id": 831,
          "text": "Haan hargiz nahin, an-qareeb inhein maloom ho jayega"
        },
        {
          "id": -1005677,
          "resource_id": "ur.maududi",
          "text": "ہاں، ہرگز نہیں، عنقریب اِنہیں معلوم ہو جائے گا"
        },
        {
          "id": -2005677,
          "resource_id": 227,
          "text": "ఎంత మాత్రము కాదు! వారు త్వరలోనే దానిని తెలుసుకోగలరు."
        }
      ]
    },
    {
      "id": 5678,
      "verse_number": 6,
      "verse_key": "78:6",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَـٰدًا",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407381,
          "resource_id": 85,
          "text": "Did We not make the earth smooth,"
        },
        {
          "id": 1550115,
          "resource_id": 831,
          "text": "Kya yeh waqiya nahin hai ke humne zameen ko farsh banaya"
        },
        {
          "id": -1005678,
          "resource_id": "ur.maududi",
          "text": "کیا یہ واقعہ نہیں ہے کہ ہم نے زمین کو فرش بنایا"
        },
        {
          "id": -2005678,
          "resource_id": 227,
          "text": "ఏమీ? మేము భూమిని పరుపుగా చేయలేదా?"
        }
      ]
    },
    {
      "id": 5679,
      "verse_number": 7,
      "verse_key": "78:7",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَٱلْجِبَالَ أَوْتَادًا",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407382,
          "resource_id": 85,
          "text": "and make the mountains to keep it stable?"
        },
        {
          "id": 1550116,
          "resource_id": 831,
          "text": "Aur pahadon ko mekhon(pegs) ki tarah gaad diya"
        },
        {
          "id": -1005679,
          "resource_id": "ur.maududi",
          "text": "اور پہاڑوں کو میخوں کی طرح گاڑ دیا"
        },
        {
          "id": -2005679,
          "resource_id": 227,
          "text": "మరియు పర్వతాలను మేకులుగా?"
        }
      ]
    },
    {
      "id": 5680,
      "verse_number": 8,
      "verse_key": "78:8",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَخَلَقْنَـٰكُمْ أَزْوَٰجًا",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407383,
          "resource_id": 85,
          "text": "Did We not create you in pairs,"
        },
        {
          "id": 1550117,
          "resource_id": 831,
          "text": "Aur tumhein (mardon aur auraton ke) jodon ki shakal mein paida kiya"
        },
        {
          "id": -1005680,
          "resource_id": "ur.maududi",
          "text": "اور تمہیں (مَردوں اور عورتوں کے) جوڑوں کی شکل میں پیدا کیا"
        },
        {
          "id": -2005680,
          "resource_id": 227,
          "text": "మరియు మేము మిమ్మల్ని (స్త్రీ-పురుషుల) జంటలుగా సృష్టించాము."
        }
      ]
    },
    {
      "id": 5681,
      "verse_number": 9,
      "verse_key": "78:9",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407384,
          "resource_id": 85,
          "text": "give you sleep for rest,"
        },
        {
          "id": 1550118,
          "resource_id": 831,
          "text": "Aur tumhari neend ko baaisey sukoon banaya"
        },
        {
          "id": -1005681,
          "resource_id": "ur.maududi",
          "text": "اور تمہاری نیند کو باعث سکون بنایا"
        },
        {
          "id": -2005681,
          "resource_id": 227,
          "text": "మరియు మేము నిద్రను, మీకు విశ్రాంతి నిచ్చేదిగా చేశాము."
        }
      ]
    },
    {
      "id": 5682,
      "verse_number": 10,
      "verse_key": "78:10",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَجَعَلْنَا ٱلَّيْلَ لِبَاسًا",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407385,
          "resource_id": 85,
          "text": "the night as a cover,"
        },
        {
          "id": 1550119,
          "resource_id": 831,
          "text": "Aur raat ko purdah posh"
        },
        {
          "id": -1005682,
          "resource_id": "ur.maududi",
          "text": "اور رات کو پردہ پوش"
        },
        {
          "id": -2005682,
          "resource_id": 227,
          "text": "మరియు రాత్రిని ఆచ్ఛాదనగా చేశాము."
        }
      ]
    },
    {
      "id": 5683,
      "verse_number": 11,
      "verse_key": "78:11",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًا",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407386,
          "resource_id": 85,
          "text": "and the day for your livelihood?"
        },
        {
          "id": 1550120,
          "resource_id": 831,
          "text": "Aur din ko muaash ka waqt banaya"
        },
        {
          "id": -1005683,
          "resource_id": "ur.maududi",
          "text": "اور دن کو معاش کا وقت بنایا"
        },
        {
          "id": -2005683,
          "resource_id": 227,
          "text": "మరియు పగటిని జీవనోపాధి సమయంగా చేశాము."
        }
      ]
    },
    {
      "id": 5684,
      "verse_number": 12,
      "verse_key": "78:12",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407387,
          "resource_id": 85,
          "text": "Did We not build seven strong [heavens] above you,"
        },
        {
          "id": 1550121,
          "resource_id": 831,
          "text": "Aur Tumharey upar saat mazboot aasman qayam kiye"
        },
        {
          "id": -1005684,
          "resource_id": "ur.maududi",
          "text": "اور تمہارے اوپر سات مضبوط آسمان قائم کیے"
        },
        {
          "id": -2005684,
          "resource_id": 227,
          "text": "మరియు మేము మీపైన పటిష్టమైన ఏడు (ఆకాశాలను) నిర్మించాము."
        }
      ]
    },
    {
      "id": 5685,
      "verse_number": 13,
      "verse_key": "78:13",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَجَعَلْنَا سِرَاجًا وَهَّاجًا",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407388,
          "resource_id": 85,
          "text": "and make a blazing lamp?"
        },
        {
          "id": 1550122,
          "resource_id": 831,
          "text": "Aur ek nihayat roshan aur garm chirag paida kya"
        },
        {
          "id": -1005685,
          "resource_id": "ur.maududi",
          "text": "اور ایک نہایت روشن اور گرم چراغ پیدا کیا"
        },
        {
          "id": -2005685,
          "resource_id": 227,
          "text": "మరియు (అందులో) ప్రకాశించే దీపాన్ని (సూర్యుణ్ణి) ఉంచాము."
        }
      ]
    },
    {
      "id": 5686,
      "verse_number": 14,
      "verse_key": "78:14",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءً ثَجَّاجًا",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407389,
          "resource_id": 85,
          "text": "Did We not send water pouring down from the clouds"
        },
        {
          "id": 1550123,
          "resource_id": 831,
          "text": "Aur baadalon se lagatar baarish barsayi"
        },
        {
          "id": -1005686,
          "resource_id": "ur.maududi",
          "text": "اور بادلوں سے لگاتار بارش برسائی"
        },
        {
          "id": -2005686,
          "resource_id": 227,
          "text": "మరియు మేఘాల నుండి ధారాపాతంగా వర్షాన్ని కురిపించాము."
        }
      ]
    },
    {
      "id": 5687,
      "verse_number": 15,
      "verse_key": "78:15",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لِّنُخْرِجَ بِهِۦ حَبًّا وَنَبَاتًا",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407390,
          "resource_id": 85,
          "text": "to bring forth with it grain, plants,"
        },
        {
          "id": 1550124,
          "resource_id": 831,
          "text": "Taa-ke iske zariye se galla(grain) aur sabzi"
        },
        {
          "id": -1005687,
          "resource_id": "ur.maududi",
          "text": "تاکہ اس کے ذریعہ سے غلہ اور سبزی"
        },
        {
          "id": -2005687,
          "resource_id": 227,
          "text": "దానితో మేము ధాన్యం మరియు పచ్చికను (చెట్లు చేమలను) పెరిగించటానికి!"
        }
      ]
    },
    {
      "id": 5688,
      "verse_number": 16,
      "verse_key": "78:16",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَجَنَّـٰتٍ أَلْفَافًا",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407391,
          "resource_id": 85,
          "text": "and luxuriant gardens?"
        },
        {
          "id": 1550125,
          "resource_id": 831,
          "text": "Aur ghaney baagh ugaye"
        },
        {
          "id": -1005688,
          "resource_id": "ur.maududi",
          "text": "اور گھنے باغ اگائیں؟"
        },
        {
          "id": -2005688,
          "resource_id": 227,
          "text": "మరియు దట్టమైన తోటలను."
        }
      ]
    },
    {
      "id": 5689,
      "verse_number": 17,
      "verse_key": "78:17",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَـٰتًا",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407392,
          "resource_id": 85,
          "text": "A time has been appointed for the Day of Decision:"
        },
        {
          "id": 1550126,
          "resource_id": 831,
          "text": "Beshak faisley ka din ek mukarrar waqt hai"
        },
        {
          "id": -1005689,
          "resource_id": "ur.maududi",
          "text": "بے شک فیصلے کا دن ایک مقرر وقت ہے"
        },
        {
          "id": -2005689,
          "resource_id": 227,
          "text": "నిశ్చయంగా, తీర్పుదినం ఒక నిర్ణీత సమయం."
        }
      ]
    },
    {
      "id": 5690,
      "verse_number": 18,
      "verse_key": "78:18",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًا",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407393,
          "resource_id": 85,
          "text": "a Day when the Trumpet will sound and you will come forward in crowds,"
        },
        {
          "id": 1550127,
          "resource_id": 831,
          "text": "Jis roz soor mei phook maar di jayegi tum fauj dar fauj nikal aaogey"
        },
        {
          "id": -1005690,
          "resource_id": "ur.maududi",
          "text": "جس روز صور میں پھونک مار دی جائے گی، تم فوج در فوج نکل آؤ گے"
        },
        {
          "id": -2005690,
          "resource_id": 227,
          "text": "ఆ రోజు బాకా ఊదబడినప్పుడు! అప్పుడు మీరంతా గుంపులు గుంపులుగా లేచి వస్తారు."
        }
      ]
    },
    {
      "id": 5691,
      "verse_number": 19,
      "verse_key": "78:19",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًا",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407394,
          "resource_id": 85,
          "text": "when the sky will open up like wide portals,"
        },
        {
          "id": 1550128,
          "resource_id": 831,
          "text": "Aur aasmaan khol diya jayega hatta ke woh darwaze hi darwaze ban kar reh jayega"
        },
        {
          "id": -1005691,
          "resource_id": "ur.maududi",
          "text": "اور آسمان کھول دیا جائے گا حتیٰ کہ وہ دروازے ہی دروازے بن کر رہ جائے گا"
        },
        {
          "id": -2005691,
          "resource_id": 227,
          "text": "మరియు ఆకాశం తెరువబడుతుంది, అందులో ద్వారాలు ఏర్పడుతాయి;"
        }
      ]
    },
    {
      "id": 5692,
      "verse_number": 20,
      "verse_key": "78:20",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407395,
          "resource_id": 85,
          "text": "when the mountains will vanish like a mirage."
        },
        {
          "id": 1550129,
          "resource_id": 831,
          "text": "Aur pahad chalaye jayenge yahan tak ke woh saraab(mirage) ho jayenge"
        },
        {
          "id": -1005692,
          "resource_id": "ur.maududi",
          "text": "اور پہاڑ چلائے جائیں گے یہاں تک کہ وہ سراب ہو جائیں گے"
        },
        {
          "id": -2005692,
          "resource_id": 227,
          "text": "మరియు పర్వతాలు ఎండమావులుగా అదృశ్యమై పోతాయి."
        }
      ]
    },
    {
      "id": 5693,
      "verse_number": 21,
      "verse_key": "78:21",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407396,
          "resource_id": 85,
          "text": "Hell lies in wait,"
        },
        {
          "id": 1550130,
          "resource_id": 831,
          "text": "Dar haqeeqat jahannum ek ghaat(ambush) hai"
        },
        {
          "id": -1005693,
          "resource_id": "ur.maududi",
          "text": "درحقیقت جہنم ایک گھات ہے"
        },
        {
          "id": -2005693,
          "resource_id": 227,
          "text": "నిశ్చయంగా, నరకం ఒక మాటు;"
        }
      ]
    },
    {
      "id": 5694,
      "verse_number": 22,
      "verse_key": "78:22",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لِّلطَّـٰغِينَ مَـَٔابًا",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407397,
          "resource_id": 85,
          "text": "a home for oppressors"
        },
        {
          "id": 1550131,
          "resource_id": 831,
          "text": "Sarkashon ka thikana"
        },
        {
          "id": -1005694,
          "resource_id": "ur.maududi",
          "text": "سرکشوں کا ٹھکانا"
        },
        {
          "id": -2005694,
          "resource_id": 227,
          "text": "ధిక్కారుల గమ్యస్థానం;"
        }
      ]
    },
    {
      "id": 5695,
      "verse_number": 23,
      "verse_key": "78:23",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَّـٰبِثِينَ فِيهَآ أَحْقَابًا",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407398,
          "resource_id": 85,
          "text": "to stay in for a long, long time,"
        },
        {
          "id": 1550132,
          "resource_id": 831,
          "text": "Jismein woh muddaton padey rahengey"
        },
        {
          "id": -1005695,
          "resource_id": "ur.maududi",
          "text": "جس میں وہ مدتوں پڑے رہیں گے"
        },
        {
          "id": -2005695,
          "resource_id": 227,
          "text": "అందులో వారు యుగాల తరబడి ఉంటారు."
        }
      ]
    },
    {
      "id": 5696,
      "verse_number": 24,
      "verse_key": "78:24",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَّا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407399,
          "resource_id": 85,
          "text": "where they will taste no coolness nor drink"
        },
        {
          "id": 1550133,
          "resource_id": 831,
          "text": "Uske andar kisi thandak aur peene ke qabil kisi cheez ka maza woh na chakhengey"
        },
        {
          "id": -1005696,
          "resource_id": "ur.maududi",
          "text": "اُس کے اندر کسی ٹھنڈک اور پینے کے قابل کسی چیز کا مزہ وہ نہ چکھیں گے"
        },
        {
          "id": -2005696,
          "resource_id": 227,
          "text": "అందులో వారు ఎలాంటి చల్లదనాన్ని గానీ మరియు (చల్లని) పానీయాన్ని గానీ చవి చూడరు."
        }
      ]
    },
    {
      "id": 5697,
      "verse_number": 25,
      "verse_key": "78:25",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِلَّا حَمِيمًا وَغَسَّاقًا",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407400,
          "resource_id": 85,
          "text": "except one that is scalding and dark––"
        },
        {
          "id": 1550134,
          "resource_id": 831,
          "text": "kuch milega to bas garam paani aur zakhmon ka dho-wan(peep)"
        },
        {
          "id": -1005697,
          "resource_id": "ur.maududi",
          "text": "کچھ ملے گا تو بس گرم پانی اور زخموں کا دھوون"
        },
        {
          "id": -2005697,
          "resource_id": 227,
          "text": "సలసల కాగే నీరు మరియు చీము లాంటి మురికి (పానీయం) తప్ప!"
        }
      ]
    },
    {
      "id": 5698,
      "verse_number": 26,
      "verse_key": "78:26",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "جَزَآءً وِفَاقًا",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407401,
          "resource_id": 85,
          "text": "a fitting requital,"
        },
        {
          "id": 1550135,
          "resource_id": 831,
          "text": "(Unke kartuton) ka bharpur badla"
        },
        {
          "id": -1005698,
          "resource_id": "ur.maududi",
          "text": "(اُن کے کرتوتوں) کا بھرپور بدلہ"
        },
        {
          "id": -2005698,
          "resource_id": 227,
          "text": "(వారి కర్మలకు) తగిన పూర్తి ప్రతిఫలంగా!"
        }
      ]
    },
    {
      "id": 5699,
      "verse_number": 27,
      "verse_key": "78:27",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًا",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407402,
          "resource_id": 85,
          "text": "for they did not fear a reckoning,"
        },
        {
          "id": 1550136,
          "resource_id": 831,
          "text": "Woh kisi hisab ki tawakku na rakhte thay"
        },
        {
          "id": -1005699,
          "resource_id": "ur.maududi",
          "text": "وہ کسی حساب کی توقع نہ رکھتے تھے"
        },
        {
          "id": -2005699,
          "resource_id": 227,
          "text": "వాస్తవానికి వారు లెక్క తీసుకోబడుతుందని ఆశించలేదు."
        }
      ]
    },
    {
      "id": 5700,
      "verse_number": 28,
      "verse_key": "78:28",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَكَذَّبُوا۟ بِـَٔايَـٰتِنَا كِذَّابًا",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407403,
          "resource_id": 85,
          "text": "and they rejected Our messages as lies."
        },
        {
          "id": 1550137,
          "resource_id": 831,
          "text": "Aur hamari aayat ko unhon ne bilkul jhutla diya tha"
        },
        {
          "id": -1005700,
          "resource_id": "ur.maududi",
          "text": "اور ہماری آیات کو انہوں نے بالکل جھٹلا دیا تھا"
        },
        {
          "id": -2005700,
          "resource_id": 227,
          "text": "పైగా వారు మా సూచనలను (ఆయాత్ లను) అసత్యాలని తిరస్కరించారు."
        }
      ]
    },
    {
      "id": 5701,
      "verse_number": 29,
      "verse_key": "78:29",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَكُلَّ شَىْءٍ أَحْصَيْنَـٰهُ كِتَـٰبًا",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407404,
          "resource_id": 85,
          "text": "We have recorded everything in a Record."
        },
        {
          "id": 1550138,
          "resource_id": 831,
          "text": "Aur haal yeh tha ke humne har cheez gin gin kar likh rakkhi thi"
        },
        {
          "id": -1005701,
          "resource_id": "ur.maududi",
          "text": "اور حال یہ تھا کہ ہم نے ہر چیز گن گن کر لکھ رکھی تھی"
        },
        {
          "id": -2005701,
          "resource_id": 227,
          "text": "మరియు మేము (వారు చేసిన) ప్రతిదానిని ఒక పుస్తకంలో వ్రాసి పెట్టాము."
        }
      ]
    },
    {
      "id": 5702,
      "verse_number": 30,
      "verse_key": "78:30",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 520,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا",
      "page_number": 582,
      "juz_number": 30,
      "translations": [
        {
          "id": 407405,
          "resource_id": 85,
          "text": "‘Taste this: all you will get from Us is more torment.’"
        },
        {
          "id": 1550139,
          "resource_id": 831,
          "text": "Ab chakho maza, Hum tumhare liye azaab ke siwa kisi cheez mei hargiz izafa na karengey"
        },
        {
          "id": -1005702,
          "resource_id": "ur.maududi",
          "text": "اب چکھو مزہ، ہم تمہارے لیے عذاب کے سوا کسی چیز میں ہرگز اضافہ نہ کریں گے"
        },
        {
          "id": -2005702,
          "resource_id": 227,
          "text": "కావున మీరు (మీ కర్మల ఫలితాన్ని) చవి చూడండి. ఎందుకంటే, మేము మీకు శిక్ష తప్ప మరేమీ అధికం చేయము."
        }
      ]
    },
    {
      "id": 5703,
      "verse_number": 31,
      "verse_key": "78:31",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 521,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّ لِلْمُتَّقِينَ مَفَازًا",
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 407406,
          "resource_id": 85,
          "text": "For those who were aware of God there is supreme fulfilment:"
        },
        {
          "id": 1550140,
          "resource_id": 831,
          "text": "Yakeenan muttakiyon(pious) ke liye kamrani ka ek Muqaam hai"
        },
        {
          "id": -1005703,
          "resource_id": "ur.maududi",
          "text": "یقیناً متقیوں کے لیے کامرانی کا ایک مقام ہے"
        },
        {
          "id": -2005703,
          "resource_id": 227,
          "text": "నిశ్చయంగా, దైవభీతి గలవారికి సాఫల్యం (స్వర్గం) ఉంది;"
        }
      ]
    },
    {
      "id": 5704,
      "verse_number": 32,
      "verse_key": "78:32",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 521,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "حَدَآئِقَ وَأَعْنَـٰبًا",
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 407407,
          "resource_id": 85,
          "text": "private gardens, vineyards,"
        },
        {
          "id": 1550141,
          "resource_id": 831,
          "text": "Baagh aur angur"
        },
        {
          "id": -1005704,
          "resource_id": "ur.maududi",
          "text": "باغ اور انگور"
        },
        {
          "id": -2005704,
          "resource_id": 227,
          "text": "ఉద్యానవనాలూ, ద్రాక్ష తోటలూ!"
        }
      ]
    },
    {
      "id": 5705,
      "verse_number": 33,
      "verse_key": "78:33",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 521,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَكَوَاعِبَ أَتْرَابًا",
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 407408,
          "resource_id": 85,
          "text": "nubile, well-matched companions,"
        },
        {
          "id": 1550142,
          "resource_id": 831,
          "text": "Aur naukhez humsin ladkiyan"
        },
        {
          "id": -1005705,
          "resource_id": "ur.maududi",
          "text": "اور نوخیر ہم سن لڑکیاں"
        },
        {
          "id": -2005705,
          "resource_id": 227,
          "text": "మరియు ఈడూజోడూ గల (యవ్వన) సుందర కన్యలు;"
        }
      ]
    },
    {
      "id": 5706,
      "verse_number": 34,
      "verse_key": "78:34",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 521,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "وَكَأْسًا دِهَاقًا",
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 407409,
          "resource_id": 85,
          "text": "and an overflowing cup."
        },
        {
          "id": 1550143,
          "resource_id": 831,
          "text": "Aur jhalakte huey jaam"
        },
        {
          "id": -1005706,
          "resource_id": "ur.maududi",
          "text": "اور چھلکتے ہوئے جام"
        },
        {
          "id": -2005706,
          "resource_id": 227,
          "text": "మరియు నిండి పొర్లే (మధు) పాత్ర"
        }
      ]
    },
    {
      "id": 5707,
      "verse_number": 35,
      "verse_key": "78:35",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 521,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "لَّا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا كِذَّٰبًا",
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 407410,
          "resource_id": 85,
          "text": "There they will hear no vain or lying talk:"
        },
        {
          "id": 1550144,
          "resource_id": 831,
          "text": "Wahan koi lagv(vain) aur jhuthi baat woh na sunengey"
        },
        {
          "id": -1005707,
          "resource_id": "ur.maududi",
          "text": "وہاں کوئی لغو اور جھوٹی بات وہ نہ سنیں گے"
        },
        {
          "id": -2005707,
          "resource_id": 227,
          "text": "అందులో (స్వర్గంలో) వారు ఎలాంటి వ్యర్థపు మాటలు గానీ, అసత్యాలు గానీ వినరు."
        }
      ]
    },
    {
      "id": 5708,
      "verse_number": 36,
      "verse_key": "78:36",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 521,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "جَزَآءً مِّن رَّبِّكَ عَطَآءً حِسَابًا",
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 407411,
          "resource_id": 85,
          "text": "a reward from your Lord, a fitting gift"
        },
        {
          "id": 1550145,
          "resource_id": 831,
          "text": "Jazaa aur kafi inaam tumharey Rubb ki taraf se"
        },
        {
          "id": -1005708,
          "resource_id": "ur.maududi",
          "text": "جزا اور کافی انعام تمہارے رب کی طرف سے"
        },
        {
          "id": -2005708,
          "resource_id": 227,
          "text": "(ఇదంతా) నీ ప్రభువు తరఫు నుండి లభించే ప్రతిఫలం, చాలినంత బహుమానం."
        }
      ]
    },
    {
      "id": 5709,
      "verse_number": 37,
      "verse_key": "78:37",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 521,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "رَّبِّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَـٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًا",
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 407412,
          "resource_id": 85,
          "text": "from the Lord of the heavens and earth and everything between, the Lord of Mercy. They will have no authority from Him to speak."
        },
        {
          "id": 1550146,
          "resource_id": 831,
          "text": "Us nihayat meharban khuda ki taraf se jo zameen aur aasmaano ka aur inke darmiyan ki har cheez ka malik hai jiske samney kisi ko bolne ka yara nahin"
        },
        {
          "id": -1005709,
          "resource_id": "ur.maududi",
          "text": "اُس نہایت مہربان خدا کی طرف سے جو زمین اور آسمانوں کا اور ان کے درمیان کی ہر چیز کا مالک ہے جس کے سامنے کسی کو بولنے کا یارا نہیں"
        },
        {
          "id": -2005709,
          "resource_id": 227,
          "text": "భూమ్యాకాశాలు మరియు వాటి మధ్య ఉన్న సమస్తానికీ ప్రభువైన అనంత కరుణామయుని (బహుమానం), ఆయన ముందు మాట్లాడే సాహసం ఎవ్వరికీ లేదు."
        }
      ]
    },
    {
      "id": 5710,
      "verse_number": 38,
      "verse_key": "78:38",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 521,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَـٰٓئِكَةُ صَفًّا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَـٰنُ وَقَالَ صَوَابًا",
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 407413,
          "resource_id": 85,
          "text": "On the Day when the Spirit and the angels stand in rows, they will not speak except for those to whom the Lord of Mercy gives permission, who will say only what is right."
        },
        {
          "id": 1550147,
          "resource_id": 831,
          "text": "Jis roz rooh aur malaika saff basta khade hongey. Koi na bolega siwaye uske jisey Rehman ijazat de aur jo theek baat kahey"
        },
        {
          "id": -1005710,
          "resource_id": "ur.maududi",
          "text": "جس روز روح اور ملائکہ صف بستہ کھڑے ہونگے، کوئی نہ بولے گا سوائے اُس کے جسے رحمٰن اجازت دے اور جو ٹھیک بات کہے"
        },
        {
          "id": -2005710,
          "resource_id": 227,
          "text": "ఏ రోజునయితే ఆత్మ (జిబ్రీల్) మరియు దేవదూతలు వరుసలలో నిలిచి ఉంటారో! అప్పుడు ఆ అనంత కరుణామయుడు అనుమతించిన వాడు తప్ప, మరెవ్వరూ మాట్లాడలేరు; ఒకవేళ ఎవడైనా మాట్లాడినా అతడు సరైన మాటే మాట్లాడుతాడు."
        }
      ]
    },
    {
      "id": 5711,
      "verse_number": 39,
      "verse_key": "78:39",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 521,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا",
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 407414,
          "resource_id": 85,
          "text": "That is the Day of Truth. So whoever wishes to do so should take the path that leads to his Lord."
        },
        {
          "id": 1550148,
          "resource_id": 831,
          "text": "Woh din bar-haqq hai, ab jiska jee chahey apne Rubb ki taraf palatne ka rasta ikhtiyar karle"
        },
        {
          "id": -1005711,
          "resource_id": "ur.maududi",
          "text": "وہ دن برحق ہے، اب جس کا جی چاہے اپنے رب کی طرف پلٹنے کا راستہ اختیار کر لے"
        },
        {
          "id": -2005711,
          "resource_id": 227,
          "text": "అదే అంతిమ సత్యదినం. కావున ఇష్టమున్నవాడు, తన ప్రభువు వైపునకు చేరే మార్గాన్ని అవలంబించాలి!"
        }
      ]
    },
    {
      "id": 5712,
      "verse_number": 40,
      "verse_key": "78:40",
      "hizb_number": 59,
      "rub_el_hizb_number": 233,
      "ruku_number": 521,
      "manzil_number": 7,
      "sajdah_number": null,
      "text_uthmani": "إِنَّآ أَنذَرْنَـٰكُمْ عَذَابًا قَرِيبًا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَـٰلَيْتَنِى كُنتُ تُرَٰبًۢا",
      "page_number": 583,
      "juz_number": 30,
      "translations": [
        {
          "id": 407415,
          "resource_id": 85,
          "text": "We have warned you of imminent torment, on the Day when every person will see what their own hands have sent ahead for them, when the disbeliever will say, ‘If only I were dust!’"
        },
        {
          "id": 1550149,
          "resource_id": 831,
          "text": "Humne tum logon ko us azaab se dara diya hai jo qareeb aa laga hai. Jis roz aadmi woh sab kuch dekh lega jo uske hathon ne aagey bheja hai, aur kafir pukar uthega ke kaash mai khaaq(mitti) hota"
        },
        {
          "id": -1005712,
          "resource_id": "ur.maududi",
          "text": "ہم نے تم لوگوں کو اُس عذاب سے ڈرا دیا ہے جو قریب آ لگا ہے جس روز آدمی وہ سب کچھ دیکھ لے گا جو اس کے ہاتھوں نے آگے بھیجا ہے، اور کافر پکار اٹھے گا کہ کاش میں خاک ہوتا"
        },
        {
          "id": -2005712,
          "resource_id": 227,
          "text": "నిశ్చయంగా, మేము అతని సమీపంలో ఉన్న శిక్షను గురించి మిమ్మల్ని హెచ్చరించాము. ఆ రోజు ప్రతి మనిషి తన చేజేతులా చేసుకొని ముందు పంపుకున్నదంతా ప్రత్యక్షంగా చూసుకుంటాడు. మరియు సత్యతిరస్కారి: \"అయ్యో! నా పాడుగాను! నేను మట్టినయి ఉంటే ఎంత బాగుండేది!\" అని వాపోతాడు."
        }
      ]
    }
  ]
}