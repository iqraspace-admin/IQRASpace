{
  "name": "quran",
  "version": "0.0.0",
  "private": true,
  "description": "IqraSpace Quran — free, distraction-free Quran reader. See Readme.md (master prompt), PROJECT-STATUS.md, ARCHITECTURE.md, PRODUCT-ROADMAP.md, COST.md, QURAN-CONTENT.md.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "sync:content": "node --env-file=.env.local scripts/sync-content.mjs",
    "postinstall": "node scripts/pdf/copy-pdf-worker.mjs",
    "pdf:strip-watermark": "node scripts/pdf/strip-watermark.mjs",
    "pdf:generate": "node scripts/pdf/generate-surah-pdfs.mjs",
    "build:mobile": "cross-env CAPACITOR_BUILD=1 next build",
    "assets:mobile": "node scripts/branding/generate-mobile-assets.mjs && npx --yes @capacitor/assets generate && node scripts/branding/cleanup-unused-asset-outputs.mjs",
    "cap:sync": "npm run build:mobile && npx cap sync",
    "cap:open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-pdf": "^10.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "canvas": "^3.2.3",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
