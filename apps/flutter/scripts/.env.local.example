# =============================================================================
# IqraSpace Flutter — apps/flutter/scripts/.env.local.example
#
# Copy this file to `.env.local` (same folder) and fill in real values.
# `.env.local` is gitignored — never commit it. This example file IS
# committed and must only ever contain placeholders, no real secrets.
#
# See ../AUDIO.md's "Cloudflare R2 setup" section for what these
# credentials are, how to obtain them, and why they must never reach the
# shipped Flutter app (this script is server-side content-prep tooling
# only — the app itself never reads these).
# =============================================================================

# =============================================================================
# Cloudflare R2 (Listening Mode's whole-Surah audio storage)
# =============================================================================
# All four values below come from the Cloudflare dashboard: R2 > Manage
# API Tokens (Object Read & Write, scoped to just the quran-audio bucket)
# for the Account ID / Access Key ID / Secret Access Key, and R2 > the
# bucket > Settings > Public Access > Custom Domains for the public URL.
# This is a manual, one-time setup step only the project owner can do.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=quran-audio

# The bucket's public custom domain (never the r2.dev dev subdomain —
# unsuitable for production per Cloudflare's own docs).
R2_PUBLIC_BASE_URL=https://audio.iqraspace.org
