{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iqraspace-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Static pages never invoke the Worker; only the API does.
    "run_worker_first": ["/api/*"]
  },
  // /quran* and /learning* are bound to their own Workers (more specific
  // routes win). www -> apex is the separate iqraspace-www-redirect Worker (apps/site/www-redirect; see ADMIN.md).
  "routes": [{ "pattern": "iqraspace.org/*", "zone_name": "iqraspace.org" }],
  // /api/duas reads Learning's published Duas feed through this service binding
  // (Worker-to-Worker, free). DUAS_SOURCE_URL is only the fallback if it's absent.
  "services": [{ "binding": "LEARNING", "service": "iqraspace-learning" }],
  "vars": { "DUAS_SOURCE_URL": "https://iqraspace.org/learning/api/duas/content" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iqraspace-site",
      "database_id": "fc39ee7c-243e-4b85-ab5b-c2d289509ed8",
      "migrations_dir": "d1/migrations"
    }
  ]
}
