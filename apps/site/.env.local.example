# =============================================================================
# IqraSpace Site — apps/site/.env.local.example
#
# Copy this file to `.env.local` (same folder) and fill in real values for
# local testing (`vercel dev` from apps/site). `.env.local` is gitignored —
# never commit it. In production these are set as Vercel project env vars
# instead (apps/site's Vercel project → Settings → Environment Variables).
# See ../ADMIN.md for where each value comes from.
# =============================================================================

# Supabase project dedicated to apps/site (contact_messages table only —
# a separate project from apps/quran's and apps/learning's, per this
# repo's "own Supabase project per app" convention). Project Settings →
# API in the Supabase dashboard.
SUPABASE_URL=
# The service_role key, NOT the anon/public key — this is what lets
# api/contact.js write to contact_messages despite it having no public
# RLS policy. Server-side only; never expose this in any client code.
SUPABASE_SERVICE_ROLE_KEY=

# Gmail SMTP sender for the "new contact message" alert. An App Password,
# not the real account password — requires 2-Step Verification to be
# turned on for this Google account first. Generate one at
# https://myaccount.google.com/apppasswords.
GMAIL_USER=iqraspaceorg@gmail.com
GMAIL_APP_PASSWORD=

# Optional — who receives the alert email. Defaults to iqraspaceorg@gmail.com
# in api/contact.js if left unset.
CONTACT_ALERT_EMAIL=iqraspaceorg@gmail.com

# Cloudflare Turnstile (spam protection on the contact form) — the Secret
# Key from the Turnstile widget in the Cloudflare dashboard (same account
# as iqraspace.org's DNS). The matching Site Key is public and goes
# directly in apps/site/contact.html, not here. If this is left unset,
# api/contact.js skips captcha verification rather than blocking real
# submissions on an unfinished setup — see ../ADMIN.md.
TURNSTILE_SECRET_KEY=
