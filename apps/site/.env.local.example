# =============================================================================
# IqraSpace Site - local secrets for `wrangler dev`
#
# Copy the VARIABLES below into `apps/site/.dev.vars` (gitignored; same
# KEY=value format) for local testing. In production they are set with
# `npx wrangler secret put <NAME>` - see ADMIN.md. Never commit real values.
# =============================================================================

# Cloudflare Turnstile secret key. If unset, captcha verification is skipped.
TURNSTILE_SECRET_KEY=

# Optional email alert via Resend (skipped silently if not all set).
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# Optional; defaults to iqraspaceorg@gmail.com.
CONTACT_ALERT_EMAIL=iqraspaceorg@gmail.com
